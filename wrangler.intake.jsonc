{
  // Event submissions Worker (source: intake.js). See the top of intake.js for what it does.
  // Cloudflare deploys it with `npx wrangler deploy -c wrangler.intake.jsonc` when intake files change on main.
  // Secrets (set in Cloudflare, not here): DEPLOY_HOOKS (calendar rebuild hooks), optional ANTHROPIC_API_KEY.
  "name": "lc-events-intake",
  "main": "intake.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "kv_namespaces": [{ "binding": "MEDIA", "id": "def0354e4d124ff2927b4134c54e6418" }],
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "4101", "simple": { "limit": 12, "period": 60 } }],
  // Daily calendar rebuild: 07:10 UTC = 12:10 AM in Las Cruces (1:10 AM during daylight saving time).
  // Two repeats, 30 and 60 minutes later: now and then Cloudflare answers the build server with a
  // 403 "Just a moment" page when it reads our own feeds, and that build stops (seen twice on Nov 14).
  // A repeat that isn't needed just rebuilds the same site.
  "triggers": { "crons": ["10 7 * * *", "40 7 * * *", "10 8 * * *"] },
  // "1" = turn away uploads and submissions that fail the "are you a person?" check. See isHuman in intake.js.
  "vars": { "TURNSTILE_ENFORCE": "0" },
  "observability": { "enabled": true }
}
