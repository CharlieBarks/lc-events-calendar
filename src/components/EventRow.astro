---
// Weekly regulars and city meetings in the day-by-day list. Same row as one-off events since Nov 18
// (Charlie): same size, set apart by a light tint and the "Every Thursday" tag (see EventCard, regular).
import EventCard from './EventCard.astro';
const { event, headingLevel = 3 } = Astro.props;
---
<EventCard event={event} headingLevel={headingLevel} layout="row" regular />
