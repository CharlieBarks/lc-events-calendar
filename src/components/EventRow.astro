---
// Compact one-line listing for regulars (weekly classes) and city meetings. Quieter than one-off events.
import { PREVIEW } from '../lib/site.js';
import { shortVenue } from '../lib/events.js';
import { timeLabel } from '../lib/time.js';
const { event, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}`;
---
<li class="event-row" data-date={event.date} data-cat={event.category}><a class="event-row__link" href={`/event/${event.slug}/`}>
  <span class="event-row__time">{timeLabel(event.start)}</span>
  <Heading class="event-row__name">{event.title}</Heading>
  <span class="event-row__meta">{shortVenue(event)}{event.series && <> · {event.series.when}</>}</span>
  {PREVIEW && event.sample && <span class="sample-tag">Sample</span>}
</a></li>

<style>
  .event-row {
    .event-row__link {
      display: grid;
      grid-template-columns: 4.5rem 1fr;
      gap: 0 var(--space-s);
      align-items: start;
      padding-block: var(--space-xs);
      color: var(--text-dark);
      text-decoration: none;
      font-size: var(--text-s);

      &:hover { color: var(--text-dark); }
      &:hover .event-row__name { color: var(--primary); }
    }

    .event-row__time {
      grid-row: span 2;
      color: var(--text-dark-muted);
      font-weight: 500;
    }

    .event-row__name {
      color: var(--neutral-dark);
      font-family: var(--text-font-family);
      font-size: inherit;
      font-weight: 500;
      letter-spacing: 0;
      line-height: var(--text-line-height);
    }

    .event-row__meta {
      grid-column: 2;
      color: var(--text-dark-muted);
    }

    @media (min-width: 48rem) {
      .event-row__link {
        grid-template-columns: 7.5rem 1fr minmax(0, 26rem);
        gap: var(--space-m);
        align-items: center;
        min-block-size: 2.75rem;
      }

      .event-row__time { grid-row: auto; }
      .event-row__meta { grid-column: 3; }
    }
  }
</style>
