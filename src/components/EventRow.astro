---
// Compact one-line listing for regulars (weekly classes) and city meetings, with a small picture
// (the flyer or photo, or our topic artwork). While someone is searching, the Agenda adds
// .searching and these rows open up into full cards (styles at the bottom).
import EventArt from './EventArt.astro';
import { CATEGORIES, PREVIEW } from '../lib/site.js';
import { shortVenue } from '../lib/events.js';
import { timeLabel } from '../lib/time.js';
const { event, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}`;
const cat = CATEGORIES[event.category];
---
<li class="item" data-date={event.date} data-cat={event.category} data-slug={event.slug} data-venue={event.venueKey} data-ongoing={event.ongoing ? "" : undefined}><a class="row" href={`/event/${event.slug}/`}>
  <span class="thumb"><EventArt event={event} height={56} showDate={false} compact /></span>
  <span class="time">{timeLabel(event.start)}</span>
  <span class="main">
    <Heading class="name">{event.title}</Heading>
    <span class="meta">{shortVenue(event)}{event.series && <> · {event.series.when}</>}</span>
  </span>
  <span class="cat">{cat.name}</span>
  {PREVIEW && event.sample && <span class="sample-tag">Sample</span>}
</a></li>

<style>
  .item { display: block; }
  .row { display: grid; grid-template-columns: 56px 72px 1fr auto; align-items: center; gap: 4px 14px; padding: 8px 16px 8px 8px; min-height: 56px; background: var(--card); border: 1px solid var(--line); border-radius: 14px; text-decoration: none; color: var(--ink); }
  .row:hover { border-color: var(--ink); color: var(--ink); }
  .thumb { width: 56px; height: 56px; border-radius: 10px; overflow: hidden; display: block; }
  .thumb > :global(.art) { width: 100%; height: 100% !important; padding: 0; }
  .time { font-weight: 700; font-size: .9rem; color: var(--ink-2); white-space: nowrap; }
  .main { display: flex; flex-direction: column; min-width: 0; }
  .name { font-family: var(--body); font-size: 1rem; font-weight: 600; letter-spacing: 0; line-height: 1.3; }
  .meta { color: var(--muted); font-size: .88rem; }
  .cat { font-size: .8rem; color: var(--muted); white-space: nowrap; }
  @media (max-width: 560px) {
    .row { grid-template-columns: 48px 66px 1fr; gap: 4px 10px; }
    .time { font-size: .82rem; }
    .thumb { width: 48px; height: 48px; }
    .cat { display: none; }
  }

  /* Searching: rows open up into full cards, like one-off events. */
  :global(.searching) .row { grid-template-columns: min(38%, 200px) 1fr; grid-template-rows: auto 1fr; align-items: start; gap: 4px 16px; padding: 0; min-height: 132px; height: 100%; border-radius: var(--ev-radius); overflow: hidden; }
  :global(.searching) .thumb { grid-row: 1 / span 2; width: 100%; height: 100%; min-height: 132px; border-radius: 0; }
  :global(.searching) .time { padding-top: 14px; font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ev-accent); }
  :global(.searching) .main { padding: 0 16px 14px 0; gap: 4px; }
  :global(.searching) .name { font-family: var(--display); font-size: 1.15rem; font-weight: 700; line-height: 1.15; }
  :global(.searching) .cat { display: none; }
</style>
