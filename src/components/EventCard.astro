---
import EventArt from './EventArt.astro';
import { shortVenue } from '../lib/events.js';
import { genreLine } from '../lib/sisters.js';
import { shortDate, timeRange } from '../lib/time.js';
import { PREVIEW, CATEGORIES } from '../lib/site.js';
// headingLevel: 2 right under the page h1, 3 under an h2.
// layout="row": the day-by-day list (the day heading already shows the date). The event leads:
// picture, name, then time and venue, one line about it, category, badges and price (Charlie, Nov 18,
// modeled on SFV Local). regular: weekly regulars and city meetings, same size with a light tint
// and an "Every Thursday" tag.
const { event, headingLevel = 3, big = false, eager = false, layout = 'stack', regular = false } = Astro.props;
const row = layout === 'row';
const Heading = `h${headingLevel}`;
// The band's genres from Las Cruces Live, when the act is listed there.
const genre = genreLine(event);
// In a row only a short price fits its column. A longer note ("VIP includes...") joins the venue line.
const shortPrice = /^(free|\$\s?\d[\d.,]*(\s?-\s?\$?\d[\d.,]*)?)$/i.test((event.price || '').trim());
const rowNote = row && event.price && !shortPrice ? event.price : '';
const showPrice = event.price && !rowNote;
// One line about the event: its own short summary, or the first sentence of the description.
const firstSentence = (t) => {
  const clean = (t || '').replace(/\s+/g, ' ').trim();
  const m = clean.match(/^(.{20,160}?[.!?])(\s|$)/);
  const line = m ? m[1] : clean.slice(0, 140);
  return line.length < clean.length && !m ? `${line.replace(/\s+\S*$/, '')}…` : line;
};
const about = row ? firstSentence(event.summary || event.description) : '';
const aboutLine = about && about.toLowerCase() !== event.title.toLowerCase() ? about : '';
const audience = event.audience || [];
const isFree = audience.includes('free');
const catName = CATEGORIES[event.category]?.name || '';
const when = event.ongoing ? event.series.when : timeRange(event.start, event.end);
---
<li class="event-card" data-date={event.date} data-cat={event.category} data-for={event.audience?.length ? event.audience.join(' ') : undefined} data-slug={event.slug} data-venue={event.venueKey} data-ongoing={event.ongoing ? '' : undefined}><a class="event-card__link" data-layout={row ? 'row' : 'stack'} data-size={big ? 'big' : undefined} data-sponsored={event.sponsored ? '' : undefined} data-regular={regular ? '' : undefined} href={`/event/${event.slug}/`}>
  <EventArt event={event} height={big ? 230 : row ? 88 : 170} eager={eager} showDate={!row && !event.ongoing} compact={row} />
  {row ? (
  <div class="event-card__body">
    <Heading class="event-card__name">{event.title}</Heading>
    <p class="event-card__when"><span class="event-card__time">{when}</span> · {shortVenue(event)}{regular && event.series && !event.ongoing && <span class="event-card__tag event-card__tag--regular">{event.series.when}</span>}{event.sponsored && <span class="event-card__sponsored">Sponsored</span>}{audience.includes('kids') && <span class="event-card__tag">Kids &amp; family</span>}{audience.includes('seniors') && <span class="event-card__tag">Seniors</span>}</p>
    {aboutLine && <p class="event-card__about">{aboutLine}</p>}
    <p class="event-card__where">{catName}{genre && ` · ${genre}`}{event.area && ` · ${event.area}`}{rowNote && ` · ${rowNote}`}</p>
    <p class="event-card__price-col">{showPrice ? <span class="event-card__price">{event.price}</span> : isFree ? <span class="event-card__price">Free</span> : <span class="event-card__see">See details</span>}{PREVIEW && event.sample && <span class="sample-tag">Sample</span>}</p>
  </div>
  ) : (
  <div class="event-card__body">
    <p class="event-card__when">{event.ongoing ? event.series.when : row ? timeRange(event.start, event.end) : `${shortDate(event.start)} · ${timeRange(event.start, event.end)}`}</p>
    <Heading class="event-card__name">{event.title}</Heading>
    <p class="event-card__where">{shortVenue(event)}{genre && ` · ${genre}`}{rowNote && ` · ${rowNote}`}</p>
    {(showPrice || event.sponsored || (PREVIEW && event.sample)) && (
      <p class="event-card__foot">
        {event.sponsored && <span class="event-card__sponsored">Sponsored</span>}
        {showPrice && <span class="event-card__price">{event.price}</span>}
        {PREVIEW && event.sample && <span class="sample-tag">Sample</span>}
      </p>
    )}
  </div>
  )}
</a></li>

<style>
  .event-card {
    /* Paid Spotlight gold. No ACSS role for it, so it stays local to this component. */
    --_sponsored-bg: #FFF4D6;
    --_sponsored-text: #6B4E00;
    --_sponsored-line: #D9B44A;

    display: flex;

    .event-card__link {
      flex: 1;
      min-inline-size: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: var(--bg-ultra-light);
      border: 1px solid var(--neutral-light);
      border-radius: var(--radius);
      color: var(--text-dark);
      text-decoration: none;
      transition: transform .15s ease, box-shadow .15s ease;

      &[data-sponsored] { border-color: var(--_sponsored-line); box-shadow: 0 0 0 1px var(--_sponsored-line) inset; }

      &:hover {
        color: var(--text-dark);
        transform: translateY(-3px);
        box-shadow: 0 10px 28px color-mix(in oklch, var(--neutral) 8%, transparent);
      }
    }

    .event-card__body {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
      padding: var(--space-s) var(--space-m) var(--space-m);
    }

    .event-card__when {
      color: var(--primary);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    .event-card__name {
      font-size: var(--h3);
      font-weight: 700;
      letter-spacing: var(--h3-letter-spacing);
      line-height: var(--h3-line-height);
    }

    .event-card__where { color: var(--text-dark-muted); font-size: var(--text-s); }

    .event-card__foot {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      margin-block-start: auto;
      padding-block-start: var(--space-xs);
    }

    .event-card__sponsored {
      padding: 0.1875rem 0.5rem;
      background: var(--_sponsored-bg);
      border-radius: var(--radius-circle);
      color: var(--_sponsored-text);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .event-card__price {
      padding: 0.1875rem 0.625rem;
      background: var(--secondary-ultra-light);
      border-radius: var(--radius-circle);
      color: var(--secondary);
      font-size: var(--text-xs);
      font-weight: 600;
    }

    /* Row in the day-by-day list: picture, then the event (name, time and venue, about, category), price on the right. */
    .event-card__link[data-layout="row"] {
      display: grid;
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: var(--space-s);
      align-items: start;
      padding-block: var(--space-s);
      overflow: visible;
      background: none;
      border: 0;
      border-block-end: 1px solid var(--neutral-light);
      border-radius: 0;

      &:hover { transform: none; box-shadow: none; }
      &:hover .event-card__name { color: var(--primary); }
      &[data-sponsored] { box-shadow: none; }

      & > :global(.art) {
        inline-size: 4.5rem;
        block-size: 4.5rem !important;
        padding: 0;
        border-radius: var(--radius-s);
      }

      & .event-card__body { display: flex; flex-direction: column; gap: 0.125rem; padding: 0; min-inline-size: 0; }
      & .event-card__body > *, & .event-card__name { margin: 0; }
      & .event-card__about { margin-block: 0.25rem 0.125rem; }

      & .event-card__name { font-size: 1.1rem; font-weight: 700; line-height: 1.2; letter-spacing: 0; }

      & .event-card__when {
        display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.375rem;
        color: var(--text-dark-muted);
        font-size: var(--text-s);
        font-weight: 500;
        letter-spacing: 0;
        text-transform: none;
      }
      & .event-card__time { color: var(--secondary); font-weight: 700; }

      & .event-card__about { color: var(--text-dark); font-size: var(--text-s); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
      & .event-card__where { color: var(--text-dark-muted); font-size: var(--text-xs); }

      & .event-card__tag {
        padding: 0.0625rem 0.5rem;
        border: 1px solid var(--neutral-light);
        border-radius: var(--radius-circle);
        background: var(--bg-ultra-light);
        color: var(--text-dark-muted);
        font-size: var(--text-xs);
        font-weight: 600;
        white-space: nowrap;
      }
      & .event-card__sponsored { padding: 0.0625rem 0.5rem; letter-spacing: .04em; }

      & .event-card__price-col { margin: 0; font-size: var(--text-s); font-weight: 700; }
      & .event-card__price { padding: 0; background: none; border-radius: 0; color: var(--secondary); font-size: var(--text-s); }
      & .event-card__see { color: var(--text-dark-muted); font-weight: 500; }
    }

    /* Weekly regulars and city meetings: same size, set apart with a light tint and their "Every …" tag. */
    .event-card__link[data-layout="row"][data-regular] {
      margin-block: var(--space-xs);
      padding-inline: var(--space-s);
      border: 1px solid var(--neutral-light);
      border-radius: var(--radius);
      background: color-mix(in oklch, var(--secondary) 6%, var(--bg-ultra-light));
    }
    .event-card__link[data-layout="row"] .event-card__tag--regular { border-color: color-mix(in oklch, var(--secondary) 35%, transparent); color: var(--secondary); background: var(--white); }

    @media (min-width: 48rem) {
      .event-card__link[data-layout="row"] {
        grid-template-columns: 4.75rem minmax(0, 1fr) auto;
        gap: 0 var(--space-s);
        padding-block: var(--space-s);

        & > :global(.art) { inline-size: 4.75rem; block-size: 4.75rem !important; grid-row: 1 / span 4; }
        & .event-card__body { display: contents; }
        & .event-card__name, & .event-card__when, & .event-card__about, & .event-card__where { grid-column: 2; }
        & .event-card__price-col { grid-column: 3; grid-row: 1 / span 4; align-self: start; text-align: right; padding-block-start: 0.125rem; }
      }
    }
  }
</style>
