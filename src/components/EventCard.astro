---
import EventArt from './EventArt.astro';
import { shortVenue } from '../lib/events.js';
import { shortDate, timeRange } from '../lib/time.js';
import { PREVIEW } from '../lib/site.js';
// headingLevel: 2 right under the page h1, 3 under an h2.
// layout="row": open row for the day-by-day list (the day heading already shows the date).
const { event, headingLevel = 3, big = false, eager = false, layout = 'stack' } = Astro.props;
const row = layout === 'row';
const Heading = `h${headingLevel}`;
// In a row only a short price fits its column. A longer note ("VIP includes...") joins the venue line.
const shortPrice = /^(free|\$\s?\d[\d.,]*(\s?-\s?\$?\d[\d.,]*)?)$/i.test((event.price || '').trim());
const rowNote = row && event.price && !shortPrice ? event.price : '';
const showPrice = event.price && !rowNote;
---
<li class="event-card" data-date={event.date} data-cat={event.category} data-slug={event.slug} data-venue={event.venueKey} data-ongoing={event.ongoing ? '' : undefined}><a class="event-card__link" data-layout={row ? 'row' : 'stack'} data-size={big ? 'big' : undefined} data-sponsored={event.sponsored ? '' : undefined} href={`/event/${event.slug}/`}>
  <EventArt event={event} height={big ? 230 : row ? 64 : 170} eager={eager} showDate={!row && !event.ongoing} compact={row} />
  <div class="event-card__body">
    <p class="event-card__when">{event.ongoing ? event.series.when : row ? timeRange(event.start, event.end) : `${shortDate(event.start)} · ${timeRange(event.start, event.end)}`}</p>
    <Heading class="event-card__name">{event.title}</Heading>
    <p class="event-card__where">{shortVenue(event)}{rowNote && ` · ${rowNote}`}</p>
    {(showPrice || event.sponsored || (PREVIEW && event.sample)) && (
      <p class="event-card__foot">
        {event.sponsored && <span class="event-card__sponsored">Sponsored</span>}
        {showPrice && <span class="event-card__price">{event.price}</span>}
        {PREVIEW && event.sample && <span class="sample-tag">Sample</span>}
      </p>
    )}
  </div>
</a></li>

<style>
  .event-card {
    /* Paid Spotlight gold. No ACSS role for it, so it stays local to this component. */
    --_sponsored-bg: #FFF4D6;
    --_sponsored-text: #6B4E00;
    --_sponsored-line: #D9B44A;

    display: flex;

    .event-card__link {
      flex: 1;
      min-inline-size: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: var(--bg-ultra-light);
      border: 1px solid var(--neutral-light);
      border-radius: var(--radius);
      color: var(--text-dark);
      text-decoration: none;
      transition: transform .15s ease, box-shadow .15s ease;

      &[data-sponsored] { border-color: var(--_sponsored-line); box-shadow: 0 0 0 1px var(--_sponsored-line) inset; }

      &:hover {
        color: var(--text-dark);
        transform: translateY(-3px);
        box-shadow: 0 10px 28px color-mix(in oklch, var(--neutral) 8%, transparent);
      }
    }

    .event-card__body {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
      padding: var(--space-s) var(--space-m) var(--space-m);
    }

    .event-card__when {
      color: var(--primary);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    .event-card__name {
      font-size: var(--h3);
      font-weight: 700;
      letter-spacing: var(--h3-letter-spacing);
      line-height: var(--h3-line-height);
    }

    .event-card__where { color: var(--text-dark-muted); font-size: var(--text-s); }

    .event-card__foot {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      margin-block-start: auto;
      padding-block-start: var(--space-xs);
    }

    .event-card__sponsored {
      padding: 0.1875rem 0.5rem;
      background: var(--_sponsored-bg);
      border-radius: var(--radius-circle);
      color: var(--_sponsored-text);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .event-card__price {
      padding: 0.1875rem 0.625rem;
      background: var(--secondary-ultra-light);
      border-radius: var(--radius-circle);
      color: var(--secondary);
      font-size: var(--text-xs);
      font-weight: 600;
    }

    /* Open row in the day-by-day list */
    .event-card__link[data-layout="row"] {
      display: grid;
      grid-template-columns: 4rem auto 1fr;
      grid-template-areas:
        "art when foot"
        "art name name"
        "art where where";
      gap: 0.125rem var(--space-s);
      align-items: start;
      padding-block: var(--space-s);
      overflow: visible;
      background: none;
      border: 0;
      border-block-end: 1px solid var(--neutral-light);
      border-radius: 0;

      &:hover { transform: none; box-shadow: none; }
      &:hover .event-card__name { color: var(--primary); }

      & > :global(.art) {
        grid-area: art;
        inline-size: 4rem;
        block-size: 4rem !important;
        padding: 0;
        border-radius: var(--radius-s);
      }

      & .event-card__body { display: contents; }

      & .event-card__when {
        grid-area: when;
        color: var(--text-dark);
        font-size: var(--text-m);
        font-weight: 600;
        letter-spacing: 0;
        text-transform: none;
      }

      & .event-card__name {
        grid-area: name;
        font-weight: 600;
      }

      & .event-card__where {
        grid-area: where;
        font-size: var(--text-m);
      }

      &[data-sponsored] { box-shadow: none; }

      & .event-card__foot {
        grid-area: foot;
        flex-wrap: wrap;
        margin: 0;
        padding: 0;
        align-self: center;
      }

      & .event-card__price {
        padding: 0;
        background: none;
        border-radius: 0;
        font-size: var(--text-m);
      }
    }

    @media (min-width: 48rem) {
      .event-card__link[data-layout="row"] {
        grid-template-columns: 7.5rem 5.5rem 1fr minmax(5rem, max-content);
        grid-template-areas:
          "when art name foot"
          "when art where foot";
        gap: 0 var(--space-m);
        align-items: center;

        & > :global(.art) { inline-size: 5.5rem; align-self: center; }
        & .event-card__name { align-self: end; }
        & .event-card__where { align-self: start; }
        & .event-card__foot { justify-content: flex-end; }
      }
    }
  }
</style>
