---
import Heart from './Heart.astro';
import { SITE } from '../lib/site.js';
---
<section class="section" aria-labelledby="nl-title">
  <div class="wrap two">
    <div class="box red">
      <span class="badge"><Heart size={22} /></span>
      <h2 id="nl-title">The good stuff, three times a week.</h2>
      <p>I hand-pick the best of this calendar for the Live Love Las Cruces newsletter: events on Tuesdays and Fridays, live music on Thursdays. Join {SITE.subscribers} locals who already get it.</p>
      <a class="btn btn-light" href={SITE.newsletterUrl}>Get the free newsletter</a>
    </div>
    <div class="box white">
      <h2>Throwing something? Put it on the calendar.</h2>
      <p>Listings are free for anything open to the public in Las Cruces and Mesilla. Snap a photo of your flyer and you're halfway done. I read every one. – Charlie</p>
      <a class="btn btn-dark" href="/submit/">Add your event</a>
    </div>
  </div>
</section>

<style>
  .two { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .box { border-radius: 22px; padding: 36px; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .box h2 { font-size: clamp(1.6rem, 3vw, 2rem); }
  .red { background: var(--ev-accent); color: #fff; }
  .badge { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 999px; background: #fff; }
  .red p { color: #FBE3DF; }
  .white { background: var(--card); border: 1px solid var(--line); }
  .white p { color: var(--muted); }
</style>
