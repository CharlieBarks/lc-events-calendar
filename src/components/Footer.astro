---
import Heart from './Heart.astro';
import { SITE, CATEGORIES } from '../lib/site.js';
import { getEvents } from '../lib/events.js';
const { events } = await getEvents();
const used = Object.keys(CATEGORIES).filter((k) => events.some((e) => e.category === k));
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap cols">
    <div class="brand">
      <a class="logo" href="/">Las Cruces <span>Events</span></a>
      <p>The local's calendar for live music, markets, art walks and everything else happening in Las Cruces and Mesilla.</p>
      <p class="by"><Heart size={18} /><span>A <a href={SITE.publisherUrl}>Live Love Las Cruces</a> project.</span></p>
    </div>
    <nav aria-label="Browse">
      <h2>Browse</h2>
      <a href="/this-weekend/">This weekend</a>
      {used.map((k) => <a href={`/category/${k}/`}>{CATEGORIES[k].plural}</a>)}
    </nav>
    <nav aria-label="Get involved">
      <h2>Get involved</h2>
      <a href="/submit/">Add your event</a>
      <a href={SITE.newsletterUrl}>Get the newsletter</a>
      <a href="/calendar.ics">Subscribe in your calendar app</a>
      <a href="https://lascrucesarttrail.com">Las Cruces Art Trail</a>
    </nav>
  </div>
  <div class="wrap legal">© {year} Live Love Las Cruces. Listings are free. Plans change, so check the event link before you head out.</div>
</footer>

<style>
  .site-footer { border-block-start: 1px solid var(--neutral-light); padding: var(--space-xl) 0 var(--space-m); background: var(--bg-light); }
  .cols { display: grid; gap: var(--space-l); grid-template-columns: repeat(auto-fit, minmax(11.25rem, 1fr)); }
  .brand { grid-column: span 2; max-inline-size: 25rem; display: flex; flex-direction: column; gap: var(--space-xs); }
  @media (max-width: 640px) { .brand { grid-column: auto; } }
  .logo { font-family: var(--heading-font-family); font-weight: 800; font-size: var(--text-xl); color: var(--text-dark); text-decoration: none; }
  .logo span { color: var(--primary); }
  .brand p { color: var(--text-dark-muted); font-size: var(--text-m); }
  .by { display: flex; align-items: center; gap: var(--space-xs); }
  .by a { color: var(--text-dark); font-weight: 600; }
  nav { display: flex; flex-direction: column; gap: 0.125rem; }
  nav h2 { font-family: var(--text-font-family); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: .1em; color: var(--text-dark-muted); margin-block-end: var(--space-xs); font-weight: 600; }
  nav a { color: var(--text-dark); text-decoration: none; padding: 0.375rem 0; font-size: var(--text-m); }
  nav a:hover { color: var(--primary); }
  .legal { margin-block-start: var(--space-l); padding-block-start: var(--space-m); border-block-start: 1px solid var(--neutral-ultra-light); font-size: var(--text-s); color: var(--text-dark-muted); }
</style>
