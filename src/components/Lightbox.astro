---
// Click a flyer to see it full size. Uses the native <dialog>, so Esc and focus work for free.
---
<dialog class="lightbox" aria-label="Full-size image">
  <form method="dialog"><button class="close" aria-label="Close">×</button></form>
  <img alt="" />
</dialog>
<script>
  const dlg = document.querySelector('dialog.lightbox');
  const img = dlg?.querySelector('img');
  document.querySelectorAll('[data-lightbox]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      img.src = el.getAttribute('data-lightbox');
      img.alt = el.getAttribute('data-alt') || '';
      dlg.showModal();
    });
  });
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
<style>
  .lightbox { border: 0; padding: 0; background: transparent; max-width: 94vw; max-height: 94vh; }
  .lightbox::backdrop { background: rgba(20,18,16,.86); }
  .lightbox img { max-width: 94vw; max-height: 90vh; border-radius: 12px; display: block; }
  .close { position: fixed; top: 14px; right: 18px; width: 48px; height: 48px; border-radius: 999px; border: 0; background: #fff; font-size: 1.8rem; line-height: 1; cursor: pointer; }
</style>
