---
// Click a flyer to see it full size. Uses the native <dialog>, so Esc and focus work for free.
---
<dialog class="lightbox" aria-label="Full-size image">
  <form method="dialog"><button class="lightbox__close" aria-label="Close">×</button></form>
  <img alt="" />
</dialog>
<script>
  const dlg = document.querySelector('dialog.lightbox');
  const img = dlg?.querySelector('img');
  document.querySelectorAll('[data-lightbox]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      img.src = el.getAttribute('data-lightbox');
      img.alt = el.getAttribute('data-alt') || '';
      dlg.showModal();
    });
  });
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
<style>
  .lightbox { border: 0; padding: 0; background: transparent; max-inline-size: 94vw; max-block-size: 94vh; }
  .lightbox::backdrop { background: rgba(20,18,16,.86); }
  .lightbox img { max-inline-size: 94vw; max-block-size: 90vh; border-radius: var(--radius-s); display: block; }
  .lightbox__close { position: fixed; top: 0.875rem; right: 1.125rem; inline-size: 3rem; block-size: 3rem; border-radius: 999px; border: 0; background: var(--white); font-size: 1.8rem; line-height: 1; cursor: pointer; }
</style>
