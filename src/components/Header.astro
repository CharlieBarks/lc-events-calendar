---
const path = Astro.url.pathname;
const links = [
  { href: '/this-weekend/', label: 'This weekend' },
  { href: '/category/live-music/', label: 'Live music' },
  { href: '/#browse', label: 'Browse', match: '/category/' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href="/">Las Cruces <span>Events</span></a>
    <nav aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="btn btn-dark cta" href="/submit/">Add your event</a>
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--line); background: var(--bg); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 24px; padding-top: 14px; padding-bottom: 14px; }
  .logo { font-family: var(--display); font-weight: 800; font-size: 1.4rem; color: var(--ink); text-decoration: none; letter-spacing: -0.01em; }
  .logo span { color: var(--accent); }
  nav { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 20px; }
  nav a:not(.btn) { color: var(--ink); text-decoration: none; font-weight: 500; padding: 10px 0; }
  nav a:not(.btn):hover, nav a[aria-current] { color: var(--accent); }
  nav a[aria-current] { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px; }
  .cta { min-height: 44px; padding: 0 18px; font-size: .95rem; }
  @media (max-width: 560px) {
    nav { gap: 2px 16px; }
    .cta { width: 100%; justify-content: center; margin-top: 4px; }
  }
</style>
