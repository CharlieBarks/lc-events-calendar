---
import HeaderSearch from './HeaderSearch.astro';
// Top row matches livelovelascruces.com, so the calendar feels like part of the main site.
// The second row holds the calendar's own links.
const path = Astro.url.pathname;
const lllc = 'https://livelovelascruces.com';
const siteLinks = [
  { href: `${lllc}/local-events`, label: 'Local Events' },
  { href: `${lllc}/live-music`, label: 'Live Music' },
  { href: '/', label: 'Events Calendar', current: true },
  { href: 'https://livelovelascruces.dnnr.io/', label: 'Dinner Club' },
];
const subscribeUrl = `${lllc}/subscribe?utm_source=lc-events`;
const calendarLinks = [
  { href: '/this-weekend/', label: 'This weekend' },
  { href: '/category/live-music/', label: 'Live music' },
  { href: '/exhibits/', label: 'Art exhibits' },
  { href: '/weekly/', label: 'Weekly regulars' },
  { href: '/#browse', label: 'Browse', match: '/category/' },
];
const currentValue = path === '/' ? 'page' : 'true';
// The homepage and category pages already have a search box in their filters.
const showSearch = path !== '/' && !path.startsWith('/category/');
---
<header class="site-header">
  <div class="site-header__main">
    <a class="site-header__logo" href={`${lllc}/`}>
      <img src="/lllc-logo-on-dark.png" width="240" height="60" alt="Live Love Las Cruces" />
    </a>

    <nav class="site-header__nav" aria-label="Live Love Las Cruces">
      {siteLinks.map((l) => (
        <a class="site-header__link" href={l.href} aria-current={l.current ? currentValue : undefined}>{l.label}</a>
      ))}
      <a class="site-header__subscribe" href={subscribeUrl}>Subscribe</a>
    </nav>

    <details class="site-header__menu" data-site-menu>
      <summary class="site-header__toggle" aria-label="Menu">
        <svg class="site-header__icon" data-state="closed" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        <svg class="site-header__icon" data-state="open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
      </summary>
      <nav class="site-header__panel" aria-label="Live Love Las Cruces menu">
        {siteLinks.map((l) => (
          <a class="site-header__panel-link" href={l.href} aria-current={l.current ? currentValue : undefined}>{l.label}</a>
        ))}
        <a class="site-header__subscribe" data-size="full" href={subscribeUrl}>Subscribe</a>
      </nav>
    </details>
  </div>

  <div class="site-header__calendar">
    <a class="site-header__name" href="/">Las Cruces Events</a>
    <nav class="site-header__calendar-nav" aria-label="Calendar">
      {calendarLinks.map((l) => (
        <a
          class="site-header__calendar-link"
          href={l.href}
          aria-current={path === l.href ? 'page' : undefined}
        >{l.label}</a>
      ))}
    </nav>
    {showSearch && <HeaderSearch />}
    <a class="site-header__cta btn--primary" href="/submit/">Add your event</a>
  </div>
</header>

<!-- Slim bar (Charlie, Nov 23): slides in at the top once the header above scrolls out of view, and
     stays there, so "Add your event" and the menu are always one tap away. Always visible while
     scrolling (no hide-on-scroll-down: it confuses readers when things disappear). -->
<div class="sticky-bar" data-sticky-bar>
  <a class="sticky-bar__home" href="/">
    <img src="/lllc-logo-on-dark.png" width="120" height="30" alt="" />
    <span class="sticky-bar__name">Las Cruces Events</span>
  </a>
  <a class="sticky-bar__cta btn--primary" href="/submit/">Add your event</a>
  <details class="sticky-bar__menu" data-site-menu>
    <summary class="site-header__toggle" aria-label="Menu">
      <svg class="site-header__icon" data-state="closed" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
      <svg class="site-header__icon" data-state="open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
    </summary>
    <nav class="sticky-bar__panel" aria-label="Menu">
      <a class="sticky-bar__panel-link" href="/">All events</a>
      {calendarLinks.map((l) => <a class="sticky-bar__panel-link" href={l.href}>{l.label}</a>)}
      <a class="sticky-bar__panel-link" href="/submit/">Add your event</a>
      <hr />
      {siteLinks.filter((l) => !l.current).map((l) => <a class="sticky-bar__panel-link" data-size="small" href={l.href}>{l.label}</a>)}
      <a class="sticky-bar__subscribe" href={subscribeUrl}>Subscribe</a>
    </nav>
  </details>
</div>

<script>
  // Show the slim bar once the full header has scrolled out of view.
  const bar = document.querySelector<HTMLElement>('[data-sticky-bar]');
  const header = document.querySelector('.site-header');
  if (bar && header && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting;
      bar.toggleAttribute('data-show', show);
      if (!show) bar.querySelector('details')?.removeAttribute('open');
    }).observe(header);
  }
</script>

<script>
  // <details> gives the menu its keyboard and screen reader support. This adds Escape to close it.
  for (const menu of document.querySelectorAll('[data-site-menu]')) {
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary').focus();
      }
    });
  }
</script>

<style>
  .sticky-bar {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: var(--space-s);
    min-block-size: 3.5rem;
    padding: 0.375rem var(--gutter);
    background: var(--bg-ultra-dark);
    box-shadow: 0 2px 10px rgb(0 0 0 / .2);
    transform: translateY(-110%);
    visibility: hidden;
    transition: transform .2s ease, visibility 0s .2s;

    &[data-show] { transform: none; visibility: visible; transition: transform .2s ease; }

    .sticky-bar__home {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      min-inline-size: 0;
      margin-inline-end: auto;
      color: var(--text-light);
      text-decoration: none;
      & img { inline-size: 6.5rem; block-size: auto; flex: none; }
    }
    .sticky-bar__name { display: none; font-family: var(--heading-font-family); font-size: var(--text-l); font-weight: 800; white-space: nowrap; }

    .sticky-bar__cta { display: inline-flex; align-items: center; min-block-size: 2.75rem; font-size: var(--text-s); white-space: nowrap; }

    .sticky-bar__menu { flex: none; }
    .sticky-bar__menu .site-header__toggle { display: flex; align-items: center; justify-content: center; inline-size: 2.75rem; block-size: 2.75rem; color: var(--text-light); cursor: pointer; list-style: none; }
    .sticky-bar__menu .site-header__toggle::-webkit-details-marker { display: none; }
    .sticky-bar__menu .site-header__icon[data-state="open"] { display: none; }
    .sticky-bar__menu[open] .site-header__icon[data-state="closed"] { display: none; }
    .sticky-bar__menu[open] .site-header__icon[data-state="open"] { display: block; }

    .sticky-bar__panel {
      position: fixed;
      inset-block: 3.5rem 0;
      inset-inline: 0;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      padding: var(--space-s) var(--gutter) var(--space-l);
      background: var(--bg-ultra-dark);
      & hr { inline-size: 100%; margin-block: var(--space-s); border: 0; border-block-start: 1px solid rgb(255 255 255 / .2); }
    }
    .sticky-bar__panel-link {
      display: flex;
      align-items: center;
      min-block-size: 3.25rem;
      color: var(--text-light);
      font-family: var(--heading-font-family);
      font-size: var(--h3);
      font-weight: 700;
      text-decoration: none;
      &:hover { color: var(--text-light); text-decoration: underline; }
      &[data-size="small"] { min-block-size: 2.75rem; font-family: var(--text-font-family); font-size: var(--text-l); font-weight: 600; }
    }

    .sticky-bar__subscribe {
      display: flex; align-items: center; justify-content: center;
      min-block-size: 3rem; margin-block-start: var(--space-m);
      border-radius: var(--radius-s); background: var(--lllc-red);
      color: var(--text-light); font-size: var(--text-l); font-weight: 800; text-decoration: none;
      &:hover { color: var(--text-light); text-decoration: underline; }
    }

    @media (min-width: 40rem) {
      .sticky-bar__name { display: inline; }
      .sticky-bar__cta { font-size: var(--text-m); }
    }
    @media (min-width: 60rem) {
      .sticky-bar__panel { inset-inline: auto 0; inline-size: 24rem; box-shadow: -4px 0 16px rgb(0 0 0 / .25); }
    }
  }

  .site-header {
    .site-header__main {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-m);
      min-block-size: 6.25rem;
      padding-inline: var(--gutter);
      background: var(--bg-ultra-dark);
    }

    .site-header__logo {
      flex: 0 1 15rem;
      min-inline-size: 0;
    }

    .site-header__nav {
      display: none;
      align-items: center;
      gap: 1.25rem;
    }

    .site-header__link,
    .site-header__panel-link {
      color: var(--text-light);
      font-weight: 600;
      text-decoration: none;
    }

    .site-header__link {
      padding-block: var(--space-xs);
      border-block-end: 2px solid transparent;

      &:hover { color: var(--text-light); text-decoration: underline; }
      &[aria-current] { border-block-end-color: var(--lllc-red); }
      &[aria-current]:hover { text-decoration: none; }
    }

    .site-header__subscribe {
      padding: var(--space-xs) var(--space-s);
      background: var(--lllc-red);
      border-radius: var(--radius-s);
      color: var(--text-light);
      font-size: var(--text-s);
      font-weight: 800;
      line-height: 1.5;
      text-align: center;
      text-decoration: none;

      &:hover { color: var(--text-light); text-decoration: underline; }
      &[data-size="full"] { display: flex; align-items: center; justify-content: center; min-block-size: 2.75rem; margin-block-start: var(--space-s); font-size: var(--text-m); }
    }

    .site-header__menu { flex: none; }

    .site-header__toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      inline-size: 2.75rem;
      block-size: 2.75rem;
      margin-inline-end: -0.375rem;
      color: var(--text-light);
      cursor: pointer;
      list-style: none;

      &::-webkit-details-marker { display: none; }
    }

    .site-header__icon[data-state="open"] { display: none; }

    .site-header__menu[open] .site-header__icon[data-state="closed"] { display: none; }
    .site-header__menu[open] .site-header__icon[data-state="open"] { display: block; }

    .site-header__panel {
      position: absolute;
      inset-block-start: 100%;
      inset-inline: 0;
      z-index: 20;
      display: flex;
      flex-direction: column;
      min-block-size: 100dvh;
      padding: var(--space-s) var(--gutter);
      background: var(--bg-ultra-dark);
    }

    .site-header__panel-link {
      display: flex;
      align-items: center;
      min-block-size: 3.5rem;
      font-family: var(--heading-font-family);
      font-size: var(--h2);
      font-weight: 700;

      &:hover { color: var(--text-light); text-decoration: underline; }
      &[aria-current]::after {
        content: "";
        inline-size: 0.625rem;
        block-size: 0.625rem;
        margin-inline-start: var(--space-xs);
        border-radius: var(--radius-circle);
        background: var(--lllc-red);
      }
    }

    .site-header__calendar {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: var(--space-xs) var(--space-m);
      padding: var(--space-xs) var(--gutter);
      border-block-end: 1px solid var(--neutral-light);
      background: var(--bg-light);
    }

    .site-header__name {
      color: var(--text-dark);
      font-family: var(--heading-font-family);
      font-size: var(--text-xl);
      font-weight: 800;
      letter-spacing: -0.01em;
      text-decoration: none;
      white-space: nowrap;

      &:hover { color: var(--text-dark); }
    }

    .site-header__cta {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      font-size: var(--text-s);
      white-space: nowrap;
    }

    .site-header__calendar-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      display: flex;
      justify-content: space-between;
      gap: var(--space-m);
    }

    /* Phones: the search button sits at the end of the links row, so "Add your event" keeps its room. */
    /* With search (phones): three columns, so the links row can run under "Add your event" and
       end with the magnifying glass. Row 1: name | Add your event. Row 2: links | search button. */
    .site-header__calendar:has(.header-search) {
      grid-template-columns: 1fr auto auto;
      & .site-header__name { grid-column: 1; }
      & .site-header__cta { grid-column: 2 / 4; grid-row: 1; justify-self: end; }
    }
    .site-header__calendar:has(.header-search) .site-header__calendar-nav {
      grid-column: 1 / 3;
      gap: var(--space-s);
      /* Very small phones: the links slide sideways rather than pushing the page wider. */
      min-inline-size: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .site-header__calendar-link {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      white-space: nowrap;
      color: var(--text-dark);
      font-weight: 600;
      text-decoration: none;

      &:hover { color: var(--primary); }
      &[aria-current] {
        color: var(--primary);
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 6px;
      }
    }

    @media (min-width: 60rem) {
      .site-header__nav { display: flex; }
      .site-header__menu { display: none; }
      .site-header__cta { font-size: var(--text-m); }

      .site-header__calendar {
        grid-template-columns: auto 1fr auto;
        &:has(.header-search) { grid-template-columns: auto auto minmax(0, 1fr) auto; }
        &:has(.header-search) .site-header__cta { grid-column: 4; }
        gap: var(--space-l);
        padding-block: var(--space-s);
      }

      .site-header__calendar-nav,
      .site-header__calendar:has(.header-search) .site-header__calendar-nav {
        grid-column: 2;
        grid-row: 1;
        gap: var(--space-m);
        overflow-x: visible;
        justify-content: flex-start;
      }
    }
  }
</style>
