---
// Search in the "Las Cruces Events" bar (Charlie, Nov 24, 2026): someone reading one event can look up
// another without going back to the calendar first. Not on the homepage or category pages: their
// filters already have a search box (Header.astro leaves this out there).
//
// Without JavaScript it is a plain form: Enter opens the calendar at /?q=…, which runs the calendar's
// own search. With JavaScript it also suggests venues (/?venue=<key>) and events (their page) as you
// type, from the same /search.json index the calendar uses. The index and the MiniSearch library only
// load when someone opens or focuses the box, so pages don't get heavier.
//
// The search settings below match the calendar's (Agenda.astro, loadIndex): keep the two in step.
//
// Phones (under 60rem): a magnifying glass button in the bar opens the box on its own row.
---
<button class="header-search__toggle" type="button" aria-expanded="false" aria-controls="header-search" aria-label="Search events" data-hs-toggle>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
</button>
<form class="header-search" id="header-search" action="/" method="get" role="search" data-hs>
  <label class="sr-only" for="header-search-input">Search events</label>
  <svg class="header-search__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
  <input id="header-search-input" class="header-search__input" type="search" name="q" autocomplete="off" spellcheck="false" enterkeyhint="search"
    placeholder="Search events, venues…" role="combobox" aria-expanded="false" aria-controls="header-suggest" aria-autocomplete="list" data-hs-input />
  <ul class="header-search__suggest" id="header-suggest" role="listbox" aria-label="Suggestions" hidden data-hs-suggest></ul>
</form>

<script>
  const TZ = 'America/Denver';
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
  // Same folding and stop words as the calendar's search (Agenda.astro).
  const fold = (s = '') => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '')
    .replace(/&/g, ' and ').replace(/['‘’`]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
  const STOP = new Set(['a', 'an', 'the', 'and', 'at', 'in', 'on', 'of', 'for', 'to', 'with', 'near', 'events', 'event', 'las', 'cruces']);
  const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  const niceDate = (d) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric' });

  let indexPromise;
  function loadIndex() {
    indexPromise ??= Promise.all([import('minisearch'), fetch('/search.json').then((r) => r.json())]).then(([{ default: MiniSearch }, data]) => {
      const ms = new MiniSearch({
        fields: ['t', 'v', 'va', 'c', 'g', 'd'],
        storeFields: ['t', 'dt'],
        processTerm: (term) => { const f = fold(term); return !f || STOP.has(f) ? null : f.split(' '); },
        searchOptions: {
          boost: { t: 4, v: 3, va: 2, c: 1.5, g: 1 },
          prefix: true,
          fuzzy: (term) => (term.length > 4 ? 0.2 : false),
          combineWith: 'AND',
        },
      });
      ms.addAll(data.events);
      const venues = data.venues.map((v) => ({ ...v, f: [v.n, ...(v.a || [])].map(fold) }));
      return { ms, venues };
    }).catch((err) => { indexPromise = undefined; throw err; });
    return indexPromise;
  }

  const form = document.querySelector('[data-hs]');
  const toggle = document.querySelector('[data-hs-toggle]');
  const input = document.querySelector('[data-hs-input]');
  const suggest = document.querySelector('[data-hs-suggest]');

  if (form && input && suggest) {
    let options = [];
    let active = -1;
    let timer;

    const closeSuggest = () => { suggest.hidden = true; input.setAttribute('aria-expanded', 'false'); input.removeAttribute('aria-activedescendant'); active = -1; };
    const highlight = (i) => {
      active = i;
      suggest.querySelectorAll('[role=option]').forEach((li, j) => li.setAttribute('aria-selected', String(j === i)));
      if (i >= 0) input.setAttribute('aria-activedescendant', `hs-${i}`); else input.removeAttribute('aria-activedescendant');
    };
    const choose = (i) => {
      const o = options[i];
      if (!o) return;
      location.href = o.type === 'venue' ? `/?venue=${encodeURIComponent(o.v.k)}` : `/event/${o.t.id}/`;
    };

    async function run() {
      const q = input.value.trim();
      if (fold(q).length < 2) { options = []; closeSuggest(); return; }
      let idx;
      try { idx = await loadIndex(); } catch { return; } // no suggestions; Enter still searches the calendar
      if (q !== input.value.trim()) return; // a newer keystroke took over
      const fq = fold(q);
      const vs = idx.venues.filter((v) => v.f.some((f) => f.includes(fq) || f.split(' ').some((w) => w.startsWith(fq)))).slice(0, 4);
      const seen = new Set();
      const titles = [];
      for (const r of idx.ms.search(q).filter((r) => r.dt >= today).sort((a, b) => b.score - a.score)) {
        const k = fold(r.t);
        if (seen.has(k)) continue;
        seen.add(k);
        titles.push({ id: r.id, t: r.t, when: niceDate(r.dt) });
        if (titles.length === 5) break;
      }
      options = [...vs.map((v) => ({ type: 'venue', v })), ...titles.map((t) => ({ type: 'event', t }))];
      if (!options.length || document.activeElement !== input) return closeSuggest();
      let i = 0;
      const group = (label, items) => items.length ? `<li class="sg-label" role="presentation">${label}</li>` + items.join('') : '';
      suggest.innerHTML = group('Venues', vs.map((v) => `<li class="sg" role="option" id="hs-${i++}" aria-selected="false"><span>${esc(v.n)}</span><span class="sg-n">${v.c} upcoming</span></li>`))
        + group('Events', titles.map((t) => `<li class="sg" role="option" id="hs-${i++}" aria-selected="false"><span>${esc(t.t)}</span><span class="sg-n">${t.when}</span></li>`));
      suggest.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      active = -1;
    }

    input.addEventListener('focus', () => { loadIndex().catch(() => {}); });
    input.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(run, 120); });
    input.addEventListener('keydown', (e) => {
      const open = !suggest.hidden;
      if (e.key === 'ArrowDown' && open) { e.preventDefault(); highlight(Math.min(active + 1, options.length - 1)); }
      else if (e.key === 'ArrowUp' && open) { e.preventDefault(); highlight(Math.max(active - 1, -1)); }
      else if (e.key === 'Enter' && open && active >= 0) { e.preventDefault(); choose(active); }
      else if (e.key === 'Escape') { if (open) closeSuggest(); else if (toggle?.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); } }
    });
    input.addEventListener('blur', () => setTimeout(closeSuggest, 150));
    suggest.addEventListener('mousedown', (e) => e.preventDefault()); // keep focus while clicking
    suggest.addEventListener('click', (e) => {
      const li = e.target.closest('[role=option]');
      if (li) choose(Number(li.id.slice(3)));
    });
    // An empty search would just open the calendar: stay put instead.
    form.addEventListener('submit', (e) => { if (!input.value.trim()) { e.preventDefault(); input.focus(); } });

    // Phones: the magnifying glass opens and closes the box.
    function setOpen(open) {
      toggle.setAttribute('aria-expanded', String(open));
      form.toggleAttribute('data-open', open);
      if (open) input.focus(); else closeSuggest();
    }
    toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  }
</script>

<style>
  .header-search__toggle {
    grid-column: 3;
    grid-row: 2;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius-circle);
    color: var(--text-dark);
    cursor: pointer;

    &:hover, &[aria-expanded="true"] { background: var(--neutral-ultra-light); }
  }

  .header-search {
    position: relative;
    display: none;
    grid-column: 1 / -1;
    grid-row: 3;

    &[data-open] { display: block; }
  }

  .header-search__icon {
    position: absolute;
    inset-inline-start: 0.875rem;
    inset-block-start: 50%;
    inline-size: 1.125rem;
    block-size: 1.125rem;
    transform: translateY(-50%);
    color: var(--text-dark-muted);
    pointer-events: none;
  }

  .header-search__input {
    inline-size: 100%;
    min-block-size: 2.75rem;
    padding-inline: 2.5rem var(--space-s);
    background: var(--bg-ultra-light);
    border: 1.5px solid var(--neutral-light);
    border-radius: var(--radius-circle);
    color: var(--text-dark);
    font-size: var(--text-m);

    &::placeholder { color: var(--text-dark-muted); }
    &:focus {
      border-color: var(--text-dark);
      outline: none;
      box-shadow: 0 0 0 3px var(--primary-ultra-light);
    }
  }

  .header-search__suggest {
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(100% + 0.375rem);
    z-index: 30;
    max-block-size: 60vh;
    overflow-y: auto;
    padding: 0.375rem;
    background: var(--bg-ultra-light);
    border: 1px solid var(--neutral-light);
    border-radius: var(--radius-s);
    box-shadow: 0 14px 34px color-mix(in oklch, var(--neutral) 12%, transparent);
    list-style: none;

    /* Suggestions are written by the script, so they need :global. */
    & :global(.sg-label) {
      padding: var(--space-xs) var(--space-s) 0.25rem;
      color: var(--text-dark-muted);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    & :global(.sg) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-s);
      min-block-size: 2.75rem;
      padding: var(--space-xs) var(--space-s);
      border-radius: var(--radius-xs);
      cursor: pointer;
    }

    & :global(.sg:hover),
    & :global(.sg[aria-selected="true"]) { background: var(--neutral-ultra-light); }

    & :global(.sg-n) {
      color: var(--text-dark-muted);
      font-size: var(--text-s);
      white-space: nowrap;
    }
  }

  @media (min-width: 60rem) {
    .header-search__toggle { display: none; }
    .header-search {
      display: block;
      grid-column: auto;
      grid-row: auto;
      justify-self: start;
      inline-size: min(100%, 17rem);
    }
    .header-search__suggest { inset-inline: 0 auto; inline-size: 22rem; }
  }
</style>
