---
// Day-by-day list. One-off events get open rows with artwork; regulars and city meetings get quiet rows.
// Filters run in the browser (no reloads) and remember themselves in the URL (?when=weekend&cat=live-music),
// so a filtered view can be texted to a friend or linked from the newsletter.
// Search (?q=trivia, ?venue=rio-grande-winery) narrows the same list. Its index (/search.json) only
// loads when someone starts typing, so the page itself stays as light as before.
import EventCard from './EventCard.astro';
import EventRow from './EventRow.astro';
import { CATEGORIES, AUDIENCES } from '../lib/site.js';
import { dayLabel } from '../lib/time.js';

// initialDays: how many days show before "Show more" (only in the unfiltered view).
// rest: address of a page fragment holding the days after initialDays (src/pages/more/[key].astro).
//   When set, those days are left out of this page and fetched the first time they're needed
//   (Show more, a category, a search, a later date). Keeps the page small: most visitors
//   only look at the first week.
// fragment: render only the days after initialDays and nothing else. Used by that fragment page.
// ongoing: exhibits and long runs. Not part of the day-by-day list, but shown when a search matches them.
const { events, ongoing = [], filters = true, headingLevel = 3, days: maxDays = 120, initialDays = 0, rest = '', fragment = false, nearby = 0, onNow = 0, weekly = 0 } = Astro.props;
// "Popular" searches under the filters (Charlie, Nov 25: trivia is popular, but a search box can't
// advertise it). One tap runs the search. Only words with at least 2 upcoming events show, up to 5.
const POPULAR = ['Trivia', 'Karaoke', 'Bingo', 'Open mic', 'Line dancing', 'Comedy', 'Salsa'];
const popular = POPULAR
  .map((w) => ({ w, n: events.filter((e) => new RegExp(`\\b${w.replace(' ', '\\s*')}\\b`, 'i').test(`${e.title} ${(e.tags || []).join(' ')}`)).length }))
  .filter((p) => p.n >= 2).slice(0, 5);

const byDay = new Map();
for (const e of events) {
  if (!byDay.has(e.date)) byDay.set(e.date, []);
  byDay.get(e.date).push(e);
}
const allDays = [...byDay.entries()].slice(0, maxDays);
const split = initialDays > 0 && allDays.length > initialDays && (fragment || !!rest);
const later = split ? allDays.slice(initialDays) : [];
// Days rendered here: the later ones in a fragment, the first ones when the rest is fetched, else all.
const days = fragment ? later : split ? allDays.slice(0, initialDays) : allDays;
const laterCount = later.reduce((n, [, list]) => n + list.length, 0);
// The first pictures on the page load right away; everything further down waits until it's scrolled to.
let eagerLeft = fragment ? 0 : 4;
const usedCats = Object.keys(CATEGORIES).filter((k) => events.some((e) => e.category === k));
const count = (k) => events.filter((e) => e.category === k).length;
// "Free", "Kids & Family", "Seniors", "Outdoors": who it's for, on top of the category (audienceOf in site.js).
const forCount = (k) => events.filter((e) => e.audience?.includes(k)).length;
const usedFor = Object.keys(AUDIENCES).filter((k) => forCount(k) > 0);
const H = `h${headingLevel}`;
const itemLevel = headingLevel + 1;
---
<div class="agenda" data-agenda={fragment ? undefined : ''}>
  {!fragment && filters && (
    <div class="agenda__filters" role="group" aria-label="Filter events">
      {/* One row: search and the category dropdown. Next row: dates and who it's for. (Charlie, Nov 24: the stuck bar was too tall.) */}
      <div class="agenda__top">
        <div class="agenda__search" role="search" data-search>
          <label class="sr-only" for="event-search">Search events</label>
          <svg class="agenda__search-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="event-search" class="agenda__search-input" type="search" autocomplete="off" spellcheck="false" enterkeyhint="search"
            placeholder="Search events, venues, bands…" role="combobox" aria-expanded="false" aria-controls="event-suggest" aria-autocomplete="list" data-q />
          <ul class="agenda__suggest" id="event-suggest" role="listbox" aria-label="Suggestions" hidden data-suggest></ul>
        </div>
        {usedCats.length > 1 && (
          <div class="agenda__cat-select">
            <label class="sr-only" for="cat-select">Category</label>
            <select id="cat-select" data-cat-select>
              <option value="all">All categories</option>
              {usedCats.map((k) => <option value={k}>{CATEGORIES[k].plural} ({count(k)})</option>)}
            </select>
          </div>
        )}
        <p class="agenda__status" aria-live="polite" data-status></p>
      </div>
      <p class="agenda__venue-chip" hidden data-venue-chip>
        <span>At <strong data-venue-name></strong></span>
        <button class="agenda__venue-clear" type="button" data-venue-clear aria-label="Clear venue">✕</button>
      </p>
      <div class="agenda__quick">
        <div class="agenda__filter-row" role="group" aria-label="When">
          <button class="agenda__filter" type="button" data-when="all" aria-pressed="true">All upcoming</button>
          <button class="agenda__filter" type="button" data-when="today" aria-pressed="false">Today</button>
          <button class="agenda__filter" type="button" data-when="tomorrow" aria-pressed="false">Tomorrow</button>
          <button class="agenda__filter" type="button" data-when="weekend" aria-pressed="false">This weekend</button>
          <button class="agenda__filter" type="button" data-when="week" aria-pressed="false">Next 7 days</button>
          {nearby > 0 && <a class="agenda__filter agenda__filter--link" href="/nearby/">Nearby towns <span class="agenda__count">{nearby}</span> →</a>}
        </div>
        {/* Charlie, Nov 25: Art exhibits and Weekly regulars on their own line, then the popular searches (Trivia…). */}
        {(onNow > 0 || weekly > 0 || popular.length > 0) && (
          <div class="agenda__filter-row" data-group="pages" role="group" aria-label="More to browse">
            {onNow > 0 && <a class="agenda__filter agenda__filter--link agenda__filter--exhibits" href="/exhibits/">Art exhibits and more <span class="agenda__count">{onNow}</span> →</a>}
            {weekly > 0 && <a class="agenda__filter agenda__filter--link agenda__filter--weekly" href="/weekly/">Weekly regulars <span class="agenda__count">{weekly}</span> →</a>}
            {popular.map((p) => <button class="agenda__filter" type="button" data-q={p.w.toLowerCase()} aria-pressed="false">{p.w} <span class="agenda__count">{p.n}</span></button>)}
          </div>
        )}
        {usedFor.length > 0 && (
          <div class="agenda__filter-row" data-group="for" role="group" aria-label="Who it's for">
            {usedFor.map((k) => (
              <button class="agenda__filter" type="button" data-for={k} aria-pressed="false">{AUDIENCES[k]} <span class="agenda__count">{forCount(k)}</span></button>
            ))}
          </div>
        )}
      </div>
    </div>
  )}

  {days.map(([date, list], i) => {
    // Pinned to the top of their day: Sponsored (paid), then Spotlight (free), then Featured (Charlie, Nov 28).
    const rank = (e) => (e.sponsored && !e.freeSpotlight ? 3 : e.sponsored ? 2 : e.featured ? 1 : 0);
    const cards = list.filter((e) => !e.compact).sort((a, b) => rank(b) - rank(a));
    const rows = list.filter((e) => e.compact);
    const [weekday, monthDay] = dayLabel(list[0].start).split(', ');
    return (
      <section class="agenda__day" data-day={date} data-later={fragment || (initialDays && i >= initialDays) ? '' : undefined} aria-labelledby={`d-${date}`}>
        <H class="agenda__day-head" id={`d-${date}`}>
          <span class="agenda__day-name" data-rel>{weekday}</span>{' '}
          <span class="agenda__day-date" data-date-label>{monthDay}</span>
        </H>
        <div class="agenda__day-list">
          {cards.length > 0 && <ul class="agenda__cards" role="list">{cards.map((e) => <EventCard event={e} headingLevel={itemLevel} layout="row" eager={eagerLeft-- > 0} />)}</ul>}
          {rows.length > 0 && <ul class="agenda__rows" role="list" data-row-list>{rows.map((e) => <EventRow event={e} headingLevel={itemLevel} />)}</ul>}
          {rows.length > 0 && <button class="agenda__more-rows" type="button" data-more-rows hidden></button>}
        </div>
      </section>
    );
  })}

  {!fragment && split && <div data-rest={rest} data-rest-from={later[0][0]} data-rest-count={laterCount} hidden></div>}

  {!fragment && ongoing.length > 0 && (
    <section class="agenda__day" data-ongoing-sec hidden aria-labelledby="d-ongoing">
      <H class="agenda__day-head" id="d-ongoing"><span class="agenda__day-name">Art exhibits and more</span> <span class="agenda__day-date">Any day</span></H>
      <div class="agenda__day-list">
        <ul class="agenda__cards" role="list">{ongoing.map((e) => <EventCard event={e} headingLevel={itemLevel} layout="row" />)}</ul>
      </div>
    </section>
  )}

  {!fragment && initialDays > 0 && allDays.length > initialDays && (
    <div class="agenda__more" data-more-wrap><button class="btn--base btn--outline" type="button" data-more>Show the rest of the calendar</button></div>
  )}

  {!fragment && (
    <div class="agenda__empty" data-empty hidden>
      <p><strong>Nothing listed for that yet.</strong> Know of something? Add it and I'll get it on here.</p>
      <div class="btn-row">
        <button class="btn--base btn--outline btn--s" type="button" data-reset>Show everything</button>
        <a class="btn--base btn--s" href="/submit/">Add an event</a>
      </div>
    </div>
  )}
</div>

<script>
  const TZ = 'America/Denver';
  const key = (d) => new Intl.DateTimeFormat('en-CA', { timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);
  const ROWS_SHOWN = 3;
  const plus = (k, n) => { const [y, m, d] = k.split('-').map(Number); const t = new Date(Date.UTC(y, m - 1, d + n)); return t.toISOString().slice(0, 10); };
  // Same folding as src/lib/venues.js: no capitals, accents or apostrophes; "&" = "and".
  const fold = (s = '') => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '')
    .replace(/&/g, ' and ').replace(/['‘’`]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
  const STOP = new Set(['a', 'an', 'the', 'and', 'at', 'in', 'on', 'of', 'for', 'to', 'with', 'near', 'events', 'event', 'las', 'cruces']);
  const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);

  // Loaded once per page, on first use.
  let indexPromise;
  function loadIndex() {
    indexPromise ??= Promise.all([import('minisearch'), fetch('/search.json').then((r) => r.json())]).then(([{ default: MiniSearch }, data]) => {
      const ms = new MiniSearch({
        fields: ['t', 'v', 'va', 'c', 'g', 'd'],
        storeFields: ['t', 'dt'],
        processTerm: (term) => { const f = fold(term); return !f || STOP.has(f) ? null : f.split(' '); },
        searchOptions: {
          boost: { t: 4, v: 3, va: 2, c: 1.5, g: 1 },
          prefix: true,
          fuzzy: (term) => (term.length > 4 ? 0.2 : false),
          combineWith: 'AND',
        },
      });
      ms.addAll(data.events);
      const venues = data.venues.map((v) => ({ ...v, f: [v.n, ...(v.a || [])].map(fold) }));
      return { ms, venues };
    });
    return indexPromise;
  }

  for (const root of document.querySelectorAll('[data-agenda]')) {
    const today = key(new Date());
    const tomorrow = plus(today, 1);
    const dow = new Date(today + 'T12:00:00Z').getUTCDay();
    const fri = plus(today, dow === 0 ? -2 : dow === 6 ? -1 : 5 - dow);
    const ranges = {
      all: [today, '9999'], today: [today, today], tomorrow: [tomorrow, tomorrow],
      weekend: [fri < today ? today : fri, plus(fri, 2)], week: [today, plus(today, 6)],
    };
    const labels = { all: 'coming up', today: 'today', tomorrow: 'tomorrow', weekend: 'this weekend', week: 'in the next 7 days' };

    // "Today" / "Tomorrow" in the day headings, and drop days that have already passed.
    const prep = (sec) => {
      const d = sec.dataset.day;
      if (d < today) { sec.remove(); return; }
      if (d !== today && d !== tomorrow) return;
      const name = sec.querySelector('[data-rel]');
      const date = sec.querySelector('[data-date-label]');
      date.textContent = `${name.textContent}, ${date.textContent}`;
      name.textContent = d === today ? 'Today' : 'Tomorrow';
      if (d === today) sec.setAttribute('data-today', '');
    };
    root.querySelectorAll('[data-day]').forEach(prep);

    const params = new URLSearchParams(location.search);
    const state = {
      when: ranges[params.get('when')] ? params.get('when') : 'all',
      cat: params.get('cat') || 'all',
      for: params.get('for') || '',
      q: (params.get('q') || '').trim(),
      venue: params.get('venue') || '',
    };
    let matches = null; // Set of event slugs matching state.q, or null when there's no search
    let venueName = '';
    const status = root.querySelector('[data-status]');
    const empty = root.querySelector('[data-empty]');
    const moreWrap = root.querySelector('[data-more-wrap]');
    const ongoingSec = root.querySelector('[data-ongoing-sec]');
    const input = root.querySelector('[data-q]');
    const suggest = root.querySelector('[data-suggest]');
    const chip = root.querySelector('[data-venue-chip]');
    let expanded = false;

    const searching = () => !!(matches || state.venue);

    // The days after the first screenful live in a separate page fragment (see "rest" at the top).
    // It is fetched once, the first time something needs it, and its days are added to this list.
    const restEl = root.querySelector('[data-rest]');
    const restCount = Number(restEl?.dataset.restCount || 0);
    let restLoaded = !restEl;
    let restPromise;
    function loadRest() {
      if (restLoaded) return Promise.resolve();
      restPromise ??= fetch(restEl.dataset.rest)
        .then((r) => (r.ok ? r.text() : Promise.reject(new Error(`HTTP ${r.status}`))))
        .then((html) => {
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const days = [...doc.querySelectorAll('section[data-day]')].map((sec) => document.importNode(sec, true));
          restEl.before(...days);
          days.forEach(prep);
        })
        .catch((err) => { console.warn('Could not load the rest of the calendar', err); })
        // Whatever is showing now (a filter may have been picked while it loaded) is applied to the new days too.
        .finally(() => { restLoaded = true; render(false); });
      return restPromise;
    }
    // Needed for anything beyond the plain first view: Show more, a category, a search or venue, or a date range that reaches past the days on the page.
    const needsRest = () => !restLoaded && (expanded || state.cat !== 'all' || !!state.for || searching() || !!state.q
      || (state.when !== 'all' && ranges[state.when][1] >= restEl.dataset.restFrom));

    // After a filter changes, a visitor scrolled down the list would stay mid-list and not see
    // the new results start. Bring the top of the list back, just under the (sticky) filters.
    function toTop() {
      if (root.getBoundingClientRect().top >= 0) return;
      root.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    }

    function apply(push) {
      if (needsRest()) {
        if (status) status.textContent = 'Loading the rest of the calendar…';
        loadRest().then(() => render(push));
        return;
      }
      render(push);
    }

    function render(push) {
      const [from, to] = ranges[state.when];
      let shown = 0;
      const ok = (li) => (state.cat === 'all' || li.dataset.cat === state.cat)
        && (!state.for || (li.dataset.for || '').split(' ').includes(state.for))
        && (!matches || matches.has(li.dataset.slug))
        && (!state.venue || li.dataset.venue === state.venue);
      root.querySelectorAll('[data-day]').forEach((sec) => {
        let n = 0;
        sec.querySelectorAll('li[data-date]').forEach((li) => {
          const show = li.dataset.date >= from && li.dataset.date <= to && ok(li);
          li.hidden = !show;
          if (show) n++;
        });

        // Regulars: show the first few per day, unless a category, search or venue is on, or the day was opened.
        const limit = state.cat === 'all' && !state.for && !searching() && !sec.hasAttribute('data-rows-open') ? ROWS_SHOWN : Infinity;
        const visibleRows = [...sec.querySelectorAll('[data-row-list] > li')].filter((li) => !li.hidden);
        visibleRows.slice(limit).forEach((li) => { li.hidden = true; });
        const moreRows = sec.querySelector('[data-more-rows]');
        if (moreRows) {
          const extra = Math.max(visibleRows.length - limit, 0);
          moreRows.hidden = extra === 0;
          moreRows.textContent = `Show ${extra} more regular${extra === 1 ? '' : 's'}`;
        }
        sec.querySelectorAll('ul').forEach((ul) => { ul.hidden = ![...ul.children].some((li) => !li.hidden); });
        const collapsed = !expanded && !searching() && state.when === 'all' && state.cat === 'all' && !state.for && sec.hasAttribute('data-later');
        sec.hidden = n === 0 || collapsed;
        shown += n;
      });
      if (ongoingSec) {
        let n = 0;
        ongoingSec.querySelectorAll('li[data-date]').forEach((li) => { const show = searching() && ok(li); li.hidden = !show; if (show) n++; });
        ongoingSec.hidden = n === 0;
        shown += n;
      }
      // Plain first view: the days still to be fetched count toward "N events coming up".
      if (!restLoaded) shown += state.when === 'all' ? restCount : 0;
      root.querySelectorAll('button[data-when]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.when === state.when)));
      root.querySelectorAll('button[data-cat]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === state.cat)));
      root.querySelectorAll('button[data-for]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.for === state.for)));
      root.querySelectorAll('button[data-q]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.q === (state.q || '').toLowerCase().trim())));
      const sel = root.querySelector('[data-cat-select]');
      if (sel) { sel.value = state.cat; sel.toggleAttribute('data-on', state.cat !== 'all'); }
      root.toggleAttribute('data-searching', searching());
      if (empty) empty.hidden = shown > 0;
      if (moreWrap) moreWrap.hidden = expanded || searching() || state.when !== 'all' || state.cat !== 'all' || !!state.for;
      if (chip) {
        chip.hidden = !state.venue;
        chip.querySelector('[data-venue-name]').textContent = venueName || state.venue;
      }
      if (status) {
        const who = { free: 'free ', kids: 'kid-friendly ', seniors: 'senior ', outdoors: 'outdoor ', dogs: 'dog-friendly ' }[state.for] || '';
        const what = `${shown} ${who}event${shown === 1 ? '' : 's'}`;
        const q = matches && state.q ? ` matching “${state.q}”` : '';
        const at = state.venue ? ` at ${venueName || 'that venue'}` : '';
        status.textContent = `${what}${q}${at} ${labels[state.when]}`;
      }
      if (push) {
        const p = new URLSearchParams();
        if (state.q) p.set('q', state.q);
        if (state.venue) p.set('venue', state.venue);
        if (state.when !== 'all') p.set('when', state.when);
        if (state.cat !== 'all') p.set('cat', state.cat);
        if (state.for) p.set('for', state.for);
        history.replaceState(null, '', p.toString() ? `?${p}` : location.pathname);
      }
    }

    // ---- Search box ----
    let active = -1;
    let options = [];
    function closeSuggest() { if (!suggest) return; suggest.hidden = true; input.setAttribute('aria-expanded', 'false'); input.removeAttribute('aria-activedescendant'); active = -1; }
    function highlight(i) {
      active = i;
      suggest.querySelectorAll('[role=option]').forEach((li, j) => li.setAttribute('aria-selected', String(j === i)));
      if (i >= 0) input.setAttribute('aria-activedescendant', `sg-${i}`); else input.removeAttribute('aria-activedescendant');
    }
    function renderSuggest(venues, titles) {
      options = [...venues.map((v) => ({ type: 'venue', v })), ...titles.map((t) => ({ type: 'event', t }))];
      if (!options.length || document.activeElement !== input) return closeSuggest();
      let i = 0;
      const group = (label, items) => items.length ? `<li class="sg-label" role="presentation">${label}</li>` + items.join('') : '';
      suggest.innerHTML = group('Venues', venues.map((v) => `<li class="sg" role="option" id="sg-${i++}" aria-selected="false"><span>${esc(v.n)}</span><span class="sg-n">${v.c} upcoming</span></li>`))
        + group('Events', titles.map((t) => `<li class="sg" role="option" id="sg-${i++}" aria-selected="false"><span>${esc(t.t)}</span><span class="sg-n">${t.when}</span></li>`));
      suggest.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      active = -1;
    }
    function choose(i) {
      const o = options[i];
      if (!o) return;
      if (o.type === 'venue') {
        state.venue = o.v.k; venueName = o.v.n; state.q = ''; matches = null; input.value = '';
        closeSuggest(); apply(true); toTop();
      } else {
        location.href = `/event/${o.t.id}/`;
      }
    }
    const niceDate = (d) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric' });

    async function runSearch(push, suggestToo) {
      const q = state.q;
      if (fold(q).length < 2) { matches = null; closeSuggest(); apply(push); return; }
      const { ms, venues } = await loadIndex();
      if (q !== state.q) return; // a newer keystroke already took over
      const results = ms.search(q);
      matches = new Set(results.map((r) => r.id));
      apply(push);
      if (!suggestToo) return;
      const fq = fold(q);
      const vs = venues.filter((v) => v.f.some((f) => f.includes(fq) || f.split(' ').some((w) => w.startsWith(fq)))).slice(0, 4);
      const seen = new Set();
      const titles = [];
      for (const r of results.filter((r) => r.dt >= today).sort((a, b) => b.score - a.score)) {
        const k = fold(r.t);
        if (seen.has(k)) continue;
        seen.add(k);
        titles.push({ id: r.id, t: r.t, when: niceDate(r.dt) });
        if (titles.length === 5) break;
      }
      renderSuggest(vs, titles);
    }

    if (input) {
      let timer;
      input.value = state.q;
      input.addEventListener('focus', () => { loadIndex(); loadRest(); }, { once: true });
      input.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(() => { state.q = input.value.trim(); runSearch(true, true); }, 120);
      });
      input.addEventListener('keydown', (e) => {
        const open = !suggest.hidden;
        if (e.key === 'ArrowDown' && open) { e.preventDefault(); highlight(Math.min(active + 1, options.length - 1)); }
        else if (e.key === 'ArrowUp' && open) { e.preventDefault(); highlight(Math.max(active - 1, -1)); }
        else if (e.key === 'Enter') {
          e.preventDefault();
          if (open && active >= 0) choose(active);
          else { closeSuggest(); clearTimeout(timer); state.q = input.value.trim(); runSearch(true, false); input.blur(); }
        }
        else if (e.key === 'Escape') { if (open) closeSuggest(); else if (input.value) { input.value = ''; state.q = ''; runSearch(true, false); } }
      });
      input.addEventListener('blur', () => setTimeout(closeSuggest, 150));
      suggest.addEventListener('mousedown', (e) => e.preventDefault()); // keep focus while clicking
      suggest.addEventListener('click', (e) => {
        const li = e.target.closest('[role=option]');
        if (li) choose(Number(li.id.slice(3)));
      });
    }
    // Picking a category starts fresh: it clears any search or venue and shows the whole category.
    function pickCategory(cat) {
      state.cat = cat; state.q = ''; state.venue = ''; venueName = ''; matches = null;
      if (input) input.value = '';
      closeSuggest();
    }
    const catSelect = root.querySelector('[data-cat-select]');
    catSelect?.addEventListener('change', () => { pickCategory(catSelect.value); apply(true); toTop(); });

    root.querySelector('[data-venue-clear]')?.addEventListener('click', () => { state.venue = ''; venueName = ''; apply(true); input?.focus(); });

    root.addEventListener('click', (e) => {
      const b = e.target.closest('button');
      if (!b) return;
      if (b.hasAttribute('data-more-rows')) {
        // The button goes away, so move keyboard focus to the first row it revealed.
        const sec = b.closest('[data-day]');
        sec.setAttribute('data-rows-open', '');
        apply(false);
        sec.querySelectorAll('[data-row-list] > li:not([hidden]) a')[ROWS_SHOWN]?.focus();
        return;
      }
      // A "Popular" word: runs it as a search, as if typed.
      if (b.dataset.q) {
        state.q = b.dataset.q; state.venue = ''; venueName = '';
        if (input) input.value = b.dataset.q;
        runSearch(true, false).then(toTop);
        return;
      }
      if (b.dataset.when) state.when = b.dataset.when;
      // Who it's for works with everything else; pressing the one that's on turns it off.
      else if (b.dataset.for) state.for = state.for === b.dataset.for ? '' : b.dataset.for;
      else if (b.dataset.cat) pickCategory(b.dataset.cat);
      else if (b.hasAttribute('data-more')) { expanded = true; }
      else if (b.hasAttribute('data-reset')) {
        state.when = 'all'; state.cat = 'all'; state.for = ''; state.q = ''; state.venue = ''; venueName = ''; matches = null;
        if (input) input.value = '';
      }
      else return;
      apply(true);
      if (!b.hasAttribute('data-more')) toTop();
    });

    // Start fetching as soon as someone reaches for the filters, so it's there by the time they click.
    root.querySelector('.agenda__filters')?.addEventListener('pointerenter', () => { loadRest(); }, { once: true });

    apply(false);
    // Arriving from a shared link (?q=… or ?venue=…): run it once the index is in.
    if (state.q || state.venue) {
      loadIndex().then(({ venues }) => {
        venueName = venues.find((v) => v.k === state.venue)?.n || '';
        if (state.q) runSearch(false, false); else apply(false);
      });
    }
  }
</script>

