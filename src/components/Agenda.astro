---
// Day-by-day list. One-off events get full cards; regulars and city meetings get compact rows.
// Filters run in the browser (no reloads) and remember themselves in the URL (?when=weekend&cat=live-music),
// so a filtered view can be texted to a friend or linked from the newsletter.
import EventCard from './EventCard.astro';
import EventRow from './EventRow.astro';
import { CATEGORIES } from '../lib/site.js';
import { dayLabel } from '../lib/time.js';

// initialDays: how many days show before "Show more" (only in the unfiltered view).
const { events, filters = true, headingLevel = 3, days: maxDays = 120, initialDays = 0 } = Astro.props;

const byDay = new Map();
for (const e of events) {
  if (!byDay.has(e.date)) byDay.set(e.date, []);
  byDay.get(e.date).push(e);
}
const days = [...byDay.entries()].slice(0, maxDays);
const usedCats = Object.keys(CATEGORIES).filter((k) => events.some((e) => e.category === k));
const count = (k) => events.filter((e) => e.category === k).length;
const H = `h${headingLevel}`;
const itemLevel = headingLevel + 1;
---
<div class="agenda" data-agenda>
  {filters && (
    <div class="filters" role="group" aria-label="Filter events">
      <div class="filter-row" role="group" aria-label="When">
        <button class="filter" type="button" data-when="all" aria-pressed="true">All upcoming</button>
        <button class="filter" type="button" data-when="today" aria-pressed="false">Today</button>
        <button class="filter" type="button" data-when="tomorrow" aria-pressed="false">Tomorrow</button>
        <button class="filter" type="button" data-when="weekend" aria-pressed="false">This weekend</button>
        <button class="filter" type="button" data-when="week" aria-pressed="false">Next 7 days</button>
      </div>
      {usedCats.length > 1 && (
        <div class="filter-row scroll" role="group" aria-label="Category">
          <button class="filter" type="button" data-cat="all" aria-pressed="true">Everything</button>
          {usedCats.map((k) => (
            <button class="filter" type="button" data-cat={k} aria-pressed="false">
              <span class="dot" style={`background:${CATEGORIES[k].color}`} aria-hidden="true"></span>
              {CATEGORIES[k].plural} <span class="n">{count(k)}</span>
            </button>
          ))}
        </div>
      )}
      <p class="status" aria-live="polite" data-status></p>
    </div>
  )}

  {days.map(([date, list], i) => {
    const cards = list.filter((e) => !e.compact);
    const rows = list.filter((e) => e.compact);
    return (
      <section class="day" data-day={date} data-later={initialDays && i >= initialDays ? '' : undefined} aria-labelledby={`d-${date}`}>
        <H class="day-head" id={`d-${date}`}><span class="rel" data-rel></span>{dayLabel(list[0].start)}</H>
        {cards.length > 0 && <ul class="cards" role="list">{cards.map((e) => <EventCard event={e} headingLevel={itemLevel} layout="row" />)}</ul>}
        {rows.length > 0 && <ul class="rows" role="list">{rows.map((e) => <EventRow event={e} headingLevel={itemLevel} />)}</ul>}
      </section>
    );
  })}

  {initialDays > 0 && days.length > initialDays && (
    <div class="more-wrap" data-more-wrap><button class="btn btn-outline" type="button" data-more>Show the rest of the calendar</button></div>
  )}

  <div class="empty" data-empty hidden>
    <p><strong>Nothing listed for that yet.</strong> Know of something? Add it and I'll get it on here.</p>
    <div class="btn-row">
      <button class="btn btn-outline btn-sm" type="button" data-reset>Show everything</button>
      <a class="btn btn-dark btn-sm" href="/submit/">Add an event</a>
    </div>
  </div>
</div>

<script>
  const TZ = 'America/Denver';
  const key = (d) => new Intl.DateTimeFormat('en-CA', { timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);
  const plus = (k, n) => { const [y, m, d] = k.split('-').map(Number); const t = new Date(Date.UTC(y, m - 1, d + n)); return t.toISOString().slice(0, 10); };

  for (const root of document.querySelectorAll('[data-agenda]')) {
    const today = key(new Date());
    const tomorrow = plus(today, 1);
    const dow = new Date(today + 'T12:00:00Z').getUTCDay();
    const fri = plus(today, dow === 0 ? -2 : dow === 6 ? -1 : 5 - dow);
    const ranges = {
      all: [today, '9999'], today: [today, today], tomorrow: [tomorrow, tomorrow],
      weekend: [fri < today ? today : fri, plus(fri, 2)], week: [today, plus(today, 6)],
    };
    const labels = { all: 'coming up', today: 'today', tomorrow: 'tomorrow', weekend: 'this weekend', week: 'in the next 7 days' };

    // "Today" / "Tomorrow" in the day headings, and drop days that have already passed.
    root.querySelectorAll('[data-day]').forEach((sec) => {
      const d = sec.dataset.day;
      if (d < today) sec.remove();
      const rel = sec.querySelector('[data-rel]');
      if (rel) rel.textContent = d === today ? 'Today · ' : d === tomorrow ? 'Tomorrow · ' : '';
    });

    const params = new URLSearchParams(location.search);
    const state = { when: ranges[params.get('when')] ? params.get('when') : 'all', cat: params.get('cat') || 'all' };
    const status = root.querySelector('[data-status]');
    const empty = root.querySelector('[data-empty]');
    const moreWrap = root.querySelector('[data-more-wrap]');
    let expanded = false;

    function apply(push) {
      const [from, to] = ranges[state.when];
      let shown = 0;
      root.querySelectorAll('[data-day]').forEach((sec) => {
        let n = 0;
        sec.querySelectorAll('li[data-date]').forEach((li) => {
          const ok = li.dataset.date >= from && li.dataset.date <= to && (state.cat === 'all' || li.dataset.cat === state.cat);
          li.hidden = !ok;
          if (ok) n++;
        });
        sec.querySelectorAll('ul').forEach((ul) => { ul.hidden = ![...ul.children].some((li) => !li.hidden); });
        const collapsed = !expanded && state.when === 'all' && state.cat === 'all' && sec.hasAttribute('data-later');
        sec.hidden = n === 0 || collapsed;
        shown += n;
      });
      root.querySelectorAll('[data-when]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.when === state.when)));
      root.querySelectorAll('[data-cat]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === state.cat)));
      if (empty) empty.hidden = shown > 0;
      if (moreWrap) moreWrap.hidden = expanded || state.when !== 'all' || state.cat !== 'all';
      if (status) status.textContent = `${shown} event${shown === 1 ? '' : 's'} ${labels[state.when]}`;
      if (push) {
        const p = new URLSearchParams();
        if (state.when !== 'all') p.set('when', state.when);
        if (state.cat !== 'all') p.set('cat', state.cat);
        history.replaceState(null, '', p.toString() ? `?${p}` : location.pathname);
      }
    }

    root.addEventListener('click', (e) => {
      const b = e.target.closest('button');
      if (!b) return;
      if (b.dataset.when) state.when = b.dataset.when;
      else if (b.dataset.cat) state.cat = b.dataset.cat;
      else if (b.hasAttribute('data-more')) { expanded = true; }
      else if (b.hasAttribute('data-reset')) { state.when = 'all'; state.cat = 'all'; }
      else return;
      apply(true);
    });
    apply(false);
  }
</script>

<style>
  .filters { display: flex; flex-direction: column; gap: 10px; margin-bottom: 28px; position: sticky; top: 0; z-index: 5; background: var(--bg); padding: 12px 0; border-bottom: 1px solid var(--line-soft); }
  .filter-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter-row.scroll { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 4px; scrollbar-width: thin; }
  .n { font-size: .8rem; opacity: .6; }
  .status { font-size: .9rem; color: var(--muted); }
  .day { margin-bottom: 36px; }
  .day-head { font-family: var(--display); font-size: 1.45rem; font-weight: 800; padding-bottom: 12px; margin-bottom: 16px; border-bottom: 2px solid var(--ink); }
  .rel { color: var(--accent); }
  .cards { list-style: none; margin: 0 0 10px; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 440px), 1fr)); }
  .more-wrap { display: flex; justify-content: center; padding: 8px 0 12px; }
  .rows { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .empty { background: var(--card); border: 1px dashed var(--line); border-radius: var(--radius); padding: 28px; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  @media (max-width: 560px) {
    .filter-row:first-child { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 4px; }
  }
</style>
