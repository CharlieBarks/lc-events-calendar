---
// The event's own photo or flyer when it has one. Otherwise our own event-specific artwork:
// the topic's illustration (pickleball, trivia, wine…) on the category color, with the Organ
// Mountains skyline (same as the Art Trail), so every card looks finished and tells you what it is.
import { CATEGORIES } from '../lib/site.js';
import { monthShort } from '../lib/time.js';
// decorative: the picture sits beside the event's own name and details (list cards), so screen
// readers skip it, name card text included, instead of reading the name twice (Nov 24, 2026).
const { event, height = 180, showDate = true, eager = false, compact = false, decorative = false } = Astro.props;
const cat = CATEGORIES[event.category];
const icon = event.topic?.icon || cat.icon;
const label = event.topic?.label || cat.name;
// A small repeating version of the icon in the background, offset per event so cards don't look identical.
const seed = [...event.slug].reduce((n, c) => n + c.charCodeAt(0), 0);
const pid = `p-${event.slug.slice(0, 40)}`;
// The small copy that fits this spot (src/lib/thumbs.js), or the original when there isn't one.
const thumb = (height <= 80 ? event.thumbs?.s : event.thumbs?.m) || event.image;
// No picture of its own: the topic's stock photo (src/data/topic-photos.json), when its small copies exist.
const stock = !event.image && event.stockThumbs && (height <= 80 ? event.stockThumbs.s : height <= 240 ? event.stockThumbs.m : event.stockThumbs.l);
// A tall, square or only slightly wide picture (most flyers and logos) would lose its edges, often
// the name and date, if it filled the box. Those are shown whole, centered on a blurred copy of
// themselves. Only clearly wide pictures (wider than 8:5, close to the card's own shape) and the tiny
// row thumbnails fill the box. Shape comes from thumbs.js (r = width / height). Was 1.3 until Nov 23,
// when a 560×400 trivia logo lost its top and bottom lines.
const whole = event.image && height > 80 && event.thumbs?.r && event.thumbs.r < 1.6;
// No picture: a name card. The event's own name and venue on the category color, with its topic
// icon and the mountains, so it's never the wrong picture (Charlie, Nov 18). Row thumbnails are too
// small for words and keep the icon artwork. Long names get a smaller size so they fit.
const nameCard = !event.image && height > 80 && !compact;
const len = event.title.length;
const nameSize = height >= 300 ? (len > 60 ? 1.9 : len > 34 ? 2.3 : 2.8) : len > 60 ? 1.05 : len > 34 ? 1.25 : 1.5;
const where = event.venue && !/^(las cruces|mesilla)(,? nm)?$/i.test(event.venue) ? event.venue : '';
---
<div class="art" aria-hidden={decorative ? 'true' : undefined} data-size={compact ? 'compact' : undefined} style={`--c:${cat.color};height:${height}px`}>
  {nameCard
    ? <>
        <svg class="art__pattern" aria-hidden="true" width="100%" height="100%">
          <defs>
            <pattern id={pid} width="56" height="56" patternUnits="userSpaceOnUse" patternTransform={`rotate(${(seed % 5) * 6 - 12}) translate(${seed % 56} 0)`}>
              <g transform="translate(16 16) scale(1)" fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill={`url(#${pid})`} />
        </svg>
        <svg class="art__mini" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
        <span class="art__name" style={`font-size:${nameSize}rem`}>{event.title}{where && <small>{where}</small>}</span>
        <svg class="art__sky art__sky--low" aria-hidden="true" viewBox="0 0 400 120" preserveAspectRatio="none">
          <path d="M0 120 L0 92 L40 80 L70 88 L104 54 L122 66 L140 30 L152 44 L164 18 L176 40 L190 26 L204 52 L226 44 L250 70 L284 58 L320 82 L360 74 L400 90 L400 120 Z" fill="rgba(0,0,0,.2)"/>
          <path d="M0 120 L0 104 L60 98 L120 106 L200 96 L280 104 L340 98 L400 106 L400 120 Z" fill="rgba(0,0,0,.16)"/>
        </svg>
      </>
    : event.image || stock
    ? whole
      ? <>
          <img class="art__blur" src={event.thumbs.s} alt="" aria-hidden="true" loading={eager ? 'eager' : 'lazy'} decoding="async" />
          <img class="art__photo art__photo--whole" src={thumb} alt="" width={Math.round(height * event.thumbs.r)} height={height} loading={eager ? 'eager' : 'lazy'} decoding="async" />
        </>
      : <img class="art__photo" src={event.image ? thumb : stock} alt="" width={Math.round(height * 1.5)} height={height} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    : <>
        <svg class="art__pattern" aria-hidden="true" width="100%" height="100%">
          <defs>
            <pattern id={pid} width="56" height="56" patternUnits="userSpaceOnUse" patternTransform={`rotate(${(seed % 5) * 6 - 12}) translate(${seed % 56} 0)`}>
              <g transform="translate(16 16) scale(1)" fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill={`url(#${pid})`} />
        </svg>
        <span class="art__glow" aria-hidden="true"></span>
        <svg class="art__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
        <svg class="art__sky" aria-hidden="true" viewBox="0 0 400 120" preserveAspectRatio="none">
          <path d="M0 120 L0 92 L40 80 L70 88 L104 54 L122 66 L140 30 L152 44 L164 18 L176 40 L190 26 L204 52 L226 44 L250 70 L284 58 L320 82 L360 74 L400 90 L400 120 Z" fill="rgba(0,0,0,.2)"/>
          <path d="M0 120 L0 104 L60 98 L120 106 L200 96 L280 104 L340 98 L400 106 L400 120 Z" fill="rgba(0,0,0,.16)"/>
        </svg>
      </>}
  {showDate && (
    <span class="art__date" aria-hidden="true"><b>{monthShort(event.start)}</b>{event.start.d}</span>
  )}
  {!nameCard && <span class="art__label">{event.image ? cat.name : label}</span>}
</div>

<style>
  .art { position: relative; overflow: hidden; background: var(--c); color: var(--white); display: flex; align-items: flex-start; justify-content: space-between; padding: var(--space-s); isolation: isolate; }
  .art__photo { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .art__photo--whole { object-fit: contain; }
  .art__blur { position: absolute; inset: -10%; inline-size: 120%; block-size: 120%; object-fit: cover; filter: blur(18px) brightness(.85); }
  .art__pattern { position: absolute; inset: 0; opacity: .1; z-index: -1; }
  .art__glow { position: absolute; right: -8%; top: 50%; inline-size: 70%; aspect-ratio: 1; transform: translateY(-58%); border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,.22), rgba(255,255,255,0) 65%); z-index: -1; }
  .art__icon { position: absolute; right: 9%; top: 50%; transform: translateY(-62%); block-size: 62%; max-block-size: 11.875rem; aspect-ratio: 1; color: var(--white); opacity: .92; filter: drop-shadow(0 0.25rem 0.625rem rgba(0,0,0,.18)); }
  .art__sky { position: absolute; left: 0; right: 0; bottom: 0; inline-size: 100%; block-size: 42%; }
  .art__date { position: relative; z-index: 1; order: -1; background: var(--white); color: var(--text-dark); border-radius: var(--radius-s); min-inline-size: 3.25rem; padding: 0.375rem var(--space-xs) 0.4375rem; text-align: center; font-family: var(--heading-font-family); font-weight: 800; font-size: 1.45rem; line-height: 1; box-shadow: 0 2px 10px rgba(0,0,0,.12); }
  .art__date b { display: block; font-family: var(--text-font-family); font-size: var(--text-xs); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--primary); margin-block-end: 0.1875rem; }
  .art__label { position: relative; z-index: 1; align-self: flex-start; background: rgba(255,255,255,.94); color: var(--text-dark); font-size: var(--text-xs); font-weight: 600; padding: 0.3125rem var(--space-xs); border-radius: 999px; }
  .art__mini { position: relative; z-index: 1; inline-size: 1.75rem; block-size: 1.75rem; color: var(--white); opacity: .9; flex: none; }
  .art__name { position: absolute; z-index: 1; left: var(--space-s); right: var(--space-s); bottom: var(--space-s); font-family: var(--heading-font-family); font-weight: 800; line-height: 1.05; color: var(--white); text-wrap: balance; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; text-shadow: 0 1px 2px rgba(0,0,0,.18); }
  .art__name small { display: block; margin-block-start: 0.3rem; font-family: var(--text-font-family); font-size: max(0.75rem, 0.45em); font-weight: 600; line-height: 1.2; opacity: .92; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .art__sky--low { block-size: 34%; z-index: -1; }
  .art[data-size="compact"] { padding: var(--space-xs); }
  .art[data-size="compact"] .art__label { display: none; }
  .art[data-size="compact"] .art__icon { right: 50%; transform: translate(50%, -62%); block-size: 58%; }
</style>
