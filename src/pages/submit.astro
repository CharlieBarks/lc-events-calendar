---
import Layout from '../layouts/Layout.astro';
import { CATEGORIES, INTAKE_URL, SPOTLIGHT, SITE, TURNSTILE_SITEKEY } from '../lib/site.js';
import { getEvents } from '../lib/events.js';
import venueData from '../data/venues.json';

// Venue suggestions for the form: every venue on the master list (src/data/venues.json) plus every
// venue on the calendar right now, each with the address it is most often listed with. Picking one
// fills in the address, and keeps venue names spelled one way.
const { events } = await getEvents();
const seen = new Map(); // venue name -> { address: count }
for (const v of venueData.venues) seen.set(v.name, {});
for (const e of events) {
  if (!e.venue || e.venue.length < 3) continue;
  const tally = seen.get(e.venue) || {};
  // Feeds sometimes put the venue name in front of the street address: keep the street part.
  const address = (e.address || '').replace(new RegExp(`^${e.venue.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\s*[,–-]\\s*`, 'i'), '').trim();
  if (/\d/.test(address) && address.toLowerCase() !== e.venue.toLowerCase()) tally[address] = (tally[address] || 0) + 1;
  seen.set(e.venue, tally);
}
const venueList = [...seen.entries()]
  .map(([name, tally]) => ({ name, address: Object.entries(tally).sort((a, b) => b[1] - a[1])[0]?.[0] || '' }))
  .sort((a, b) => a.name.localeCompare(b.name));
---
<Layout title="Add Your Event" description="List your Las Cruces or Mesilla event for free. Upload your flyer and the details fill themselves in, or type it in yourself.">
  <section class="wrap-narrow submit-head">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Events</a><span aria-hidden="true">›</span><span aria-current="page">Add your event</span></nav>
    <p class="eyebrow">Free, always</p>
    <h1>Put it on the calendar.</h1>
    <p class="lede">If it's open to the public in Las Cruces or Mesilla, it belongs here. I check every listing, usually within a day. – Charlie</p>
  </section>

  <section class="wrap-narrow submit-body" data-app data-intake={INTAKE_URL} data-pay={SPOTLIGHT.payUrl} data-sitekey={TURNSTILE_SITEKEY}>
    <!-- The "are you a person?" check. Invisible unless Cloudflare needs the visitor to tick a box. -->
    <div data-human></div>
    <p class="submit-body__who" data-who hidden>Submitting as <strong data-who-name></strong> · <button type="button" class="submit-body__link" data-forget>not you?</button></p>

    <!-- Step 1: pick a path -->
    <div class="submit-choose" data-step="choose">
      <label class="submit-choose__option" data-variant="primary" for="flyer">
        <input type="file" id="flyer" accept="image/*" class="sr-only" data-flyer />
        <span class="submit-choose__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 16l4.5-4.5a2 2 0 0 1 2.8 0L16 16m-2-2 1.5-1.5a2 2 0 0 1 2.8 0L20 14M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><circle cx="15" cy="8.5" r="1.5"/></svg></span>
        <strong>I have a flyer</strong>
        <span>Upload it and I'll fill in the details for you. You check them and hit send.</span>
        <span class="submit-choose__tip">On Facebook or Instagram? Screenshot the post and upload that.</span>
      </label>
      <button type="button" class="submit-choose__option" data-manual>
        <span class="submit-choose__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16Z"/><path d="m13.5 6.5 4 4"/></svg></span>
        <strong>No flyer? Type it in</strong>
        <span>Takes about a minute. You can still add a photo.</span>
      </button>
    </div>

    <!-- Reading the flyer -->
    <div class="submit-reading" data-step="reading" hidden>
      <img data-reading-img alt="Your flyer" />
      <div><span class="submit-reading__spinner" aria-hidden="true"></span><strong>Reading your flyer…</strong><p>This takes about 10 seconds.</p></div>
    </div>

    <!-- Step 2: the form (both paths end here) -->
    <form class="submit-form" data-step="form" hidden novalidate>
      <div class="submit-form__flyer" data-flyer-box hidden>
        <img data-flyer-img alt="Your flyer" />
        <div>
          <p class="submit-form__note" data-read-note></p>
          <button type="button" class="submit-body__link" data-change>Use a different flyer</button>
        </div>
      </div>

      <fieldset>
        <legend>The basics</legend>
        <div class="submit-form__field"><label for="title">Event name</label><input id="title" name="title" required autocomplete="off" placeholder="e.g. Desert Rose Trio, Fall Art Walk" /></div>

        <div class="submit-form__field">
          <span class="submit-form__label">When</span>
          <div class="submit-form__shows" data-shows></div>
          <button type="button" class="submit-body__link submit-form__add" data-add-show>+ Add another date</button>

          <!-- Repeating event: the date row above becomes the first date and sets the times. -->
          <label class="submit-form__check"><input type="checkbox" data-repeat-on /> This repeats (weekly or monthly)</label>
          <div class="submit-repeat" data-repeat hidden>
            <div class="submit-form__pair">
              <div class="submit-form__field"><label for="rp-freq">Repeats</label>
                <select id="rp-freq" data-rp="freq"><option value="weekly">Weekly</option><option value="monthly">Monthly</option></select></div>
              <div class="submit-form__field"><label for="rp-every">Every</label>
                <select id="rp-every" data-rp="every"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option></select>
                <span class="submit-repeat__unit" data-rp-unit>week</span></div>
            </div>
            <fieldset class="submit-repeat__days" data-rp-days>
              <legend>On</legend>
              <div class="submit-repeat__day-list">
                {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((d, i) => <label class="submit-repeat__day"><input type="checkbox" value={i} data-rp-day /> {d}</label>)}
              </div>
            </fieldset>
            <div class="submit-form__field" data-rp-monthly hidden><label for="rp-by">On</label>
              <select id="rp-by" data-rp="by"><option value="weekday"></option><option value="date"></option></select></div>
            <div class="submit-form__field"><label for="rp-until">Ends on <span class="submit-form__optional">(optional: leave empty if it keeps going)</span></label><input id="rp-until" type="date" data-rp="until" /></div>
            <p class="submit-repeat__summary" data-rp-summary role="status"></p>
            <ul class="submit-repeat__dates" role="list" data-rp-dates></ul>
            <p class="submit-form__hint" data-rp-hint hidden>Not happening on one of these? Tap a date to take it out.</p>
          </div>
          <label class="submit-form__check"><input type="checkbox" data-annual /> This is an annual event (same time every year)</label>
        </div>

        <div class="submit-form__pair">
          <div class="submit-form__field"><label for="venue">Venue</label><input id="venue" name="venue" required autocomplete="off" placeholder="Start typing: Rio Grande Winery…" list="venue-list" data-venues={JSON.stringify(Object.fromEntries(venueList.filter((v) => v.address).map((v) => [v.name, v.address])))} />
            <datalist id="venue-list">{venueList.map((v) => <option value={v.name}>{v.address}</option>)}</datalist></div>
          <div class="submit-form__field"><label for="address">Address <span class="submit-form__optional">(optional)</span></label><input id="address" name="address" autocomplete="off" /></div>
        </div>
        <div class="submit-form__pair">
          <div class="submit-form__field">
            <label for="category">What kind of event?</label>
            <select id="category" name="category" required>
              <option value="">Pick one</option>
              {Object.entries(CATEGORIES).filter(([k]) => k !== 'city-hall').map(([k, c]) => <option value={k}>{c.name}</option>)}
            </select>
          </div>
          <div class="submit-form__field"><label for="price">Cost</label><input id="price" name="price" placeholder="Free, No cover, $10…" /></div>
        </div>
        <div class="submit-form__field"><label for="description">Tell people why they should come <span class="submit-form__optional">(optional)</span></label><textarea id="description" name="description" rows="3"></textarea></div>
        <div class="submit-form__field"><label for="url">Tickets or more info <span class="submit-form__optional">(optional)</span></label><input type="url" id="url" name="url" placeholder="https://" inputmode="url" /></div>

        <div class="submit-form__field" data-photo-field hidden>
          <label class="submit-form__photo" for="photo">
            <input type="file" id="photo" accept="image/*" class="sr-only" data-photo />
            <strong>+ Add a photo</strong> <span class="submit-form__optional">(optional, but events with a picture get way more clicks)</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="submit-form__boost" id="spotlight">
        <legend>Want more eyes on it?</legend>
        <label class="submit-tier">
          <input type="radio" name="boost" value="" checked />
          <span class="submit-tier__body">
            <span class="submit-tier__head"><strong>Free</strong></span>
            <span class="submit-tier__text">Your event goes on the calendar. Always free.</span>
          </span>
        </label>
        <label class="submit-tier">
          <input type="radio" name="boost" value="spotlight" />
          <span class="submit-tier__body">
            <span class="submit-tier__head"><strong>Spotlight</strong> <span class="submit-tier__price">${SPOTLIGHT.price}</span></span>
            <ul class="submit-tier__list">
              <li>Pinned to the <strong>top of the calendar</strong> on your event's date, with a Sponsored label</li>
              <li>Rotates through the <strong>Spotlight</strong> section on the calendar's front page</li>
              <li>A mention in the <strong>Live Love Las Cruces newsletter</strong> ({SITE.subscribers} locals) before your event</li>
            </ul>
            <span class="submit-tier__text">You'll pay after you submit it. Nothing goes live until I've checked it over.</span>
          </span>
        </label>
      </fieldset>

      <fieldset data-contact>
        <legend>How do I reach you?</legend>
        <p class="submit-form__hint">Only used if I have a question about your listing. Never shown on the site.</p>
        <div class="submit-form__pair">
          <div class="submit-form__field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required /></div>
          <div class="submit-form__field"><label for="email">Email</label><input type="email" id="email" name="email" autocomplete="email" required /></div>
        </div>
        <div class="submit-form__field"><label for="phone">Phone <span class="submit-form__optional">(optional)</span></label><input type="tel" id="phone" name="phone" autocomplete="tel" /></div>
        <label class="submit-form__check"><input type="checkbox" name="remember" checked /> Remember me on this device</label>
      </fieldset>

      <div class="submit-form__trap" aria-hidden="true"><label for="website">Leave this empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
      <button class="btn--primary submit-form__send" type="submit">Submit Your Event</button>
      <p class="submit-form__status" data-status role="status"></p>
    </form>

    <!-- Done -->
    <div class="submit-done" data-step="done" hidden>
      <h2>Got it, thanks!</h2>
      <p data-done-text>I'll check it over, usually within a day, and it'll show up on the calendar. If anything's unclear I'll email you.</p>
      <p data-done-free>The best-looking listings make the Live Love Las Cruces newsletter (10,000+ locals).</p>
      <div class="submit-done__pay" data-done-pay hidden>
        <p><strong>One more step for your Spotlight:</strong> <span data-pay-text>pay the ${SPOTLIGHT.price} below. As soon as it comes through and I've checked your listing, it goes to the top.</span></p>
        <a class="btn--primary" data-pay-link href="#" target="_blank" rel="noopener">Pay ${SPOTLIGHT.price} for Spotlight</a>
      </div>
      <div class="btn-row"><button type="button" class="btn--base" data-again>Add another event</button><a class="btn--base btn--outline" href="/">Back to the calendar</a></div>
    </div>
  </section>
</Layout>

<template id="show-row">
  <div class="submit-form__show">
    <div class="submit-form__show-field"><label>Date</label><input type="date" data-k="date" required /></div>
    <div class="submit-form__show-field"><label>Starts</label><input type="time" data-k="start" /></div>
    <div class="submit-form__show-field"><label>Ends <span class="submit-form__optional">(opt.)</span></label><input type="time" data-k="end" /></div>
    <div class="submit-form__show-field submit-form__act" hidden><label>Different act? <span class="submit-form__optional">(opt.)</span></label><input data-k="title" autocomplete="off" /></div>
    <button type="button" class="submit-form__remove" aria-label="Remove this date" data-del>✕</button>
  </div>
</template>

<script>
  import { tidyRepeat, expand, describe, monthlyChoices, addDaysKey } from '../lib/repeat.js';
  const app = document.querySelector('[data-app]') as HTMLElement;
  const INTAKE = app.dataset.intake!;

  // "Are you a person?" check (Cloudflare Turnstile). Each upload and each send gets its own
  // one-time token, which the lc-events-intake Worker verifies. The script only loads once someone
  // starts using the form. If it can't load (a blocker), the token is empty and the Worker decides.
  const SITEKEY = app.dataset.sitekey || '';
  let tsLoading: Promise<void> | undefined;
  let tsWidget: string | undefined;
  let tsDone: (token: string) => void = () => {};
  function loadHumanCheck() {
    if (!SITEKEY) return Promise.resolve();
    tsLoading ??= new Promise<void>((resolve, reject) => {
      (window as any).__humanCheckReady = () => resolve();
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__humanCheckReady';
      s.async = true;
      s.onerror = () => reject(new Error('blocked'));
      document.head.append(s);
    });
    return tsLoading;
  }
  async function humanToken(): Promise<string> {
    if (!SITEKEY) return '';
    try {
      await loadHumanCheck();
      const ts = (window as any).turnstile;
      return await new Promise<string>((resolve) => {
        tsDone = resolve;
        setTimeout(() => resolve(''), 30000);
        if (tsWidget === undefined) {
          tsWidget = ts.render(app.querySelector('[data-human]'), {
            sitekey: SITEKEY, appearance: 'interaction-only',
            callback: (t: string) => tsDone(t), 'error-callback': () => tsDone(''), 'timeout-callback': () => tsDone(''),
          });
        } else ts.reset(tsWidget); // a token works once, so ask for a fresh one
      });
    } catch { return ''; }
  }
  app.addEventListener('pointerenter', () => { loadHumanCheck().catch(() => {}); }, { once: true });
  app.addEventListener('focusin', () => { loadHumanCheck().catch(() => {}); }, { once: true });
  const form = app.querySelector('form') as HTMLFormElement;
  const showsEl = app.querySelector('[data-shows]') as HTMLElement;
  const tpl = document.getElementById('show-row') as HTMLTemplateElement;
  const status = app.querySelector('[data-status]') as HTMLElement;
  const KEY = 'lc-events-submitter';
  let imageId = '';
  let source = 'form';

  const $ = <T extends Element = HTMLElement>(s: string) => app.querySelector(s) as T;
  const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;

  function step(name: string) {
    app.querySelectorAll<HTMLElement>('[data-step]').forEach((el) => (el.hidden = el.dataset.step !== name));
    if (name !== 'choose') window.scrollTo({ top: app.offsetTop - 20, behavior: 'smooth' });
  }

  // ---- Dates ----
  function addShow(s: { date?: string; start?: string; end?: string; title?: string } = {}) {
    const row = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    for (const k of ['date', 'start', 'end', 'title'] as const) (row.querySelector(`[data-k="${k}"]`) as HTMLInputElement).value = s[k] || '';
    showsEl.append(row);
    syncShows();
  }
  function syncShows() {
    const rows = [...showsEl.children] as HTMLElement[];
    rows.forEach((r) => {
      (r.querySelector('[data-del]') as HTMLElement).hidden = rows.length === 1;
      (r.querySelector('.submit-form__act') as HTMLElement).hidden = rows.length === 1;
    });
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Denver' }).format(new Date());
    showsEl.querySelectorAll<HTMLInputElement>('[data-k="date"]').forEach((i) => (i.min = today));
  }
  showsEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-del]');
    if (b) { b.closest('.submit-form__show')!.remove(); syncShows(); }
  });
  $('[data-add-show]').addEventListener('click', () => {
    const last = [...showsEl.querySelectorAll('.submit-form__show')].pop();
    const get = (k: string) => (last?.querySelector(`[data-k="${k}"]`) as HTMLInputElement)?.value || '';
    addShow({ start: get('start'), end: get('end') }); // same times as the last date: residencies usually are
    (showsEl.lastElementChild!.querySelector('[data-k="date"]') as HTMLInputElement).focus();
  });

  // ---- Repeating events ----
  // The first date row is the first date and gives the times. The rule itself (weekly/monthly,
  // every N, weekdays, end date, dates taken out) is worked out by src/lib/repeat.js, the same
  // code the site uses to list the dates, so what shows here is what will be on the calendar.
  const rpBox = $('[data-repeat]');
  const rpOn = $<HTMLInputElement>('[data-repeat-on]');
  const rp = (k: string) => rpBox.querySelector(`[data-rp="${k}"]`) as HTMLInputElement;
  let rpSkip: string[] = [];
  const firstDate = () => (showsEl.querySelector('[data-k="date"]') as HTMLInputElement)?.value || '';
  function repeatRule() {
    if (!rpOn.checked || !firstDate()) return null;
    return tidyRepeat({
      freq: rp('freq').value, every: rp('every').value, by: rp('by').value, until: rp('until').value, skip: rpSkip, start: firstDate(),
      days: [...rpBox.querySelectorAll<HTMLInputElement>('[data-rp-day]:checked')].map((c) => Number(c.value)),
    });
  }
  function syncRepeat() {
    const on = rpOn.checked;
    rpBox.hidden = !on;
    // A repeating event has one date row: the first date.
    $('[data-add-show]').hidden = on;
    [...showsEl.children].slice(1).forEach((r) => { if (on) r.remove(); });
    if (on) syncShows();
    if (!on) return;
    const monthly = rp('freq').value === 'monthly';
    $('[data-rp-days]').hidden = monthly;
    $('[data-rp-monthly]').hidden = !monthly;
    $('[data-rp-unit]').textContent = (monthly ? 'month' : 'week') + (rp('every').value === '1' ? '' : 's');
    const start = firstDate();
    const summary = $('[data-rp-summary]');
    const dates = $('[data-rp-dates]');
    if (!start) { summary.textContent = 'Pick the first date above to see the dates.'; dates.innerHTML = ''; $('[data-rp-hint]').hidden = true; return; }
    const choices = monthlyChoices(start);
    (rp('by').options[0] as HTMLOptionElement).textContent = choices.weekday;
    (rp('by').options[1] as HTMLOptionElement).textContent = choices.date;
    // No weekday ticked yet: tick the first date's weekday.
    const boxes = [...rpBox.querySelectorAll<HTMLInputElement>('[data-rp-day]')];
    if (!boxes.some((b) => b.checked)) boxes[new Date(start + 'T12:00:00Z').getUTCDay()].checked = true;
    rp('until').min = start;
    const rule = repeatRule()!;
    const all = expand({ ...rule, skip: [] }, start, addDaysKey(start, 120), 12);
    const start_ = showsEl.querySelector('[data-k="start"]') as HTMLInputElement;
    const at = start_.value ? ` at ${new Date(`2000-01-01T${start_.value}`).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }).replace(':00', '')}` : '';
    summary.textContent = describe(rule).replace(/( until .*)?$/, (u) => `${at}${u}`) + '.';
    const nice = (k: string) => new Date(k + 'T12:00:00Z').toLocaleDateString('en-US', { timeZone: 'UTC', weekday: 'short', month: 'short', day: 'numeric' });
    dates.innerHTML = all.map((k) => `<li><button type="button" class="submit-repeat__date" data-rp-date="${k}" aria-pressed="${!rpSkip.includes(k)}" title="${rpSkip.includes(k) ? 'Put this date back' : 'Take this date out'}">${nice(k)}</button></li>`).join('');
    $('[data-rp-hint]').hidden = all.length === 0;
  }
  rpOn.addEventListener('change', syncRepeat);
  rpBox.addEventListener('input', syncRepeat);
  showsEl.addEventListener('input', () => { if (rpOn.checked) { rpSkip = []; rpBox.querySelectorAll<HTMLInputElement>('[data-rp-day]').forEach((b) => (b.checked = false)); syncRepeat(); } });
  rpBox.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-rp-date]');
    if (!b) return;
    const k = b.dataset.rpDate!;
    rpSkip = rpSkip.includes(k) ? rpSkip.filter((x) => x !== k) : [...rpSkip, k];
    syncRepeat();
  });

  // ---- Venue suggestions ----
  // Picking a known venue fills in its address, unless the submitter already typed one themselves.
  const venueInput = field('venue');
  const venueAddresses: Record<string, string> = JSON.parse(venueInput.dataset.venues || '{}');
  let filledAddress = '';
  venueInput.addEventListener('input', () => {
    const address = field('address');
    const known = venueAddresses[venueInput.value.trim()];
    if (known && (!address.value || address.value === filledAddress)) { address.value = known; filledAddress = known; }
    else if (!known && address.value === filledAddress) { address.value = ''; filledAddress = ''; }
  });

  // ---- Remembered submitter ----
  function loadMe() {
    try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; }
  }
  function applyMe() {
    // Coming from a "Spotlight my event" link (?spotlight=1): Spotlight is pre-selected.
    if (new URLSearchParams(location.search).get('spotlight')) {
      (form.querySelector('input[name="boost"][value="spotlight"]') as HTMLInputElement).checked = true;
    }
    const me = loadMe();
    const contact = $('[data-contact]');
    if (me?.name && me?.email) {
      field('name').value = me.name; field('email').value = me.email; field('phone').value = me.phone || '';
      $('[data-who-name]').textContent = me.name;
      $('[data-who]').hidden = false;
      contact.hidden = true;
    } else {
      $('[data-who]').hidden = true;
      contact.hidden = false;
    }
  }
  $('[data-forget]').addEventListener('click', () => {
    try { localStorage.removeItem(KEY); } catch {}
    field('name').value = ''; field('email').value = ''; field('phone').value = '';
    applyMe();
  });

  // ---- Images: shrink very large photos before upload (keeps flyers sharp, uploads fast) ----
  async function prepare(file: File): Promise<Blob> {
    if (file.size < 2.5e6 && /^image\/(jpeg|png|webp)$/.test(file.type)) return file;
    try {
      const bmp = await createImageBitmap(file);
      const scale = Math.min(1, 2400 / Math.max(bmp.width, bmp.height));
      const c = document.createElement('canvas');
      c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
      c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
      return await new Promise((r) => c.toBlob((b) => r(b || file), 'image/jpeg', 0.9));
    } catch { return file; }
  }
  async function upload(file: File) {
    const fd = new FormData();
    fd.append('image', await prepare(file), 'flyer.jpg');
    fd.append('human', await humanToken());
    const res = await fetch(`${INTAKE}/extract`, { method: 'POST', body: fd });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Upload failed');
    return data;
  }

  function fill(x: any) {
    for (const k of ['title', 'venue', 'address', 'price', 'url', 'description']) if (x[k] && !field(k).value) field(k).value = x[k];
    if (x.category && !field('category').value) field('category').value = x.category;
    showsEl.innerHTML = '';
    (x.shows?.length ? x.shows : [{}]).forEach(addShow);
  }
  function markMissing() {
    form.querySelectorAll('[data-missing]').forEach((el) => el.removeAttribute('data-missing'));
    const empty: string[] = [];
    if (!field('title').value) { field('title').setAttribute('data-missing', ''); empty.push('the event name'); }
    const dates = showsEl.querySelectorAll<HTMLInputElement>('[data-k="date"]');
    if (![...dates].some((d) => d.value)) { dates.forEach((d) => d.setAttribute('data-missing', '')); empty.push('the date'); }
    if (![...showsEl.querySelectorAll<HTMLInputElement>('[data-k="start"]')].some((d) => d.value)) empty.push('the start time');
    if (!field('venue').value) { field('venue').setAttribute('data-missing', ''); empty.push('the venue'); }
    if (!field('category').value) field('category').setAttribute('data-missing', '');
    return empty;
  }

  async function startFlyer(file: File) {
    const url = URL.createObjectURL(file);
    $<HTMLImageElement>('[data-reading-img]').src = url;
    $<HTMLImageElement>('[data-flyer-img]').src = url;
    step('reading');
    source = 'flyer';
    try {
      const data = await upload(file);
      imageId = data.imageId;
      form.reset(); applyMe();
      fill(data.extracted || {});
      const empty = markMissing();
      $('[data-read-note]').innerHTML = data.extracted && empty.length < 3
        ? `<strong>Here's what I read off your flyer.</strong> Check it over${empty.length ? ` and add ${empty.join(', ')}` : ''}.`
        : `<strong>I couldn't read much off this one.</strong> No problem, just fill in the details below.`;
    } catch (err: any) {
      imageId = '';
      form.reset(); applyMe(); fill({});
      $('[data-read-note]').innerHTML = `<strong>${err.message === 'Upload failed' ? "That upload didn't go through." : err.message}</strong> You can still fill it in below, or try the flyer again.`;
    }
    $('[data-flyer-box]').hidden = false;
    $('[data-photo-field]').hidden = true;
    step('form');
  }

  ($('[data-flyer]') as HTMLInputElement).addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (f) startFlyer(f);
  });
  $('[data-change]').addEventListener('click', () => ($('[data-flyer]') as HTMLInputElement).click());
  $('[data-manual]').addEventListener('click', () => {
    source = 'form'; imageId = '';
    form.reset(); applyMe(); fill(prefill());
    $('[data-flyer-box]').hidden = true;
    $('[data-photo-field]').hidden = false;
    step('form');
    field('title').focus();
  });
  ($('[data-photo]') as HTMLInputElement).addEventListener('change', async (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (!f) return;
    const label = $('label.submit-form__photo strong');
    label.textContent = 'Uploading…';
    try {
      const fd = new FormData();
      fd.append('image', await prepare(f), 'photo.jpg');
      fd.append('human', await humanToken());
      const res = await fetch(`${INTAKE}/extract?read=0`, { method: 'POST', body: fd });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      imageId = data.imageId;
      label.textContent = '✓ Photo added (tap to change)';
    } catch { label.textContent = "Couldn't upload that one. Try another?"; }
  });

  // Musicians arriving from their Las Cruces Live page: ?act=Desert%20Rose%20Trio
  function prefill() {
    const p = new URLSearchParams(location.search);
    const act = p.get('act');
    return act ? { title: act, category: 'live-music' } : {};
  }

  // ---- Send ----
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const shows = [...showsEl.querySelectorAll('.submit-form__show')].map((r) => ({
      date: (r.querySelector('[data-k="date"]') as HTMLInputElement).value,
      start: (r.querySelector('[data-k="start"]') as HTMLInputElement).value,
      end: (r.querySelector('[data-k="end"]') as HTMLInputElement).value,
      title: (r.querySelector('[data-k="title"]') as HTMLInputElement).value,
    })).filter((s) => s.date);
    const empty = markMissing();
    if (!form.checkValidity() || !shows.length) {
      if (empty.length) status.textContent = `Almost there: add ${empty.filter((x) => x !== 'the start time').join(', ') || 'the missing details'}.`;
      if ($('[data-contact]').hidden && (!field('name').value || !field('email').value)) $('[data-contact]').hidden = false;
      form.reportValidity();
      return;
    }
    const btn = form.querySelector('.submit-form__send') as HTMLButtonElement;
    btn.disabled = true; status.textContent = 'Sending…';
    const body = {
      title: field('title').value, venue: field('venue').value, address: field('address').value, category: field('category').value,
      price: field('price').value, url: field('url').value, description: field('description').value, shows, imageId,
      name: field('name').value, email: field('email').value, phone: field('phone').value, website: field('website').value,
      act: new URLSearchParams(location.search).get('act') || '', source,
      boost: (form.querySelector('input[name="boost"]:checked') as HTMLInputElement)?.value || '',
      repeat: repeatRule(),
      annual: $<HTMLInputElement>('[data-annual]').checked,
    };
    try {
      body.human = await humanToken();
      const res = await fetch(`${INTAKE}/submit`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Something went wrong. Please try again.');
      try {
        if ((form.elements.namedItem('remember') as HTMLInputElement).checked || loadMe()) localStorage.setItem(KEY, JSON.stringify({ name: body.name, email: body.email, phone: body.phone }));
      } catch {}
      $('[data-done-text]').textContent = shows.length > 1
        ? `All ${shows.length} dates are in. I'll check them over, usually within a day, and they'll show up on the calendar.`
        : "I'll check it over, usually within a day, and it'll show up on the calendar. If anything's unclear I'll email you.";
      // Spotlight: send them to pay, with the submission's reference so the payment can be matched in Stripe.
      const paid = body.boost === 'spotlight';
      $('[data-done-free]').hidden = paid;
      $('[data-done-pay]').hidden = !paid;
      const payUrl = app.dataset.pay || '';
      const link = $('[data-pay-link]') as HTMLAnchorElement;
      if (paid && payUrl) {
        const u = new URL(payUrl);
        u.searchParams.set('client_reference_id', data.id);
        if (body.email) u.searchParams.set('prefilled_email', body.email);
        link.href = u.toString(); link.hidden = false;
      } else if (paid) {
        link.hidden = true;
        $('[data-pay-text]').textContent = "I'll email you a payment link. As soon as it comes through and I've checked your listing, it goes to the top.";
      }
      status.textContent = '';
      step('done');
    } catch (err: any) {
      status.textContent = err.message;
    } finally { btn.disabled = false; }
  });

  $('[data-again]').addEventListener('click', () => {
    imageId = ''; form.reset(); ($('[data-flyer]') as HTMLInputElement).value = '';
    $('label.submit-form__photo strong').textContent = '+ Add a photo';
    applyMe(); step('choose');
  });

  applyMe();
  form.addEventListener('input', (e) => (e.target as HTMLElement).removeAttribute?.('data-missing'));
</script>

<style>
  .submit-head { display: flex; flex-direction: column; gap: var(--space-s); padding-block-end: var(--space-m); }
  .submit-head h1 { margin-block-start: var(--space-s); }
  .submit-body { padding-block-end: var(--space-xxl); }
  .submit-body__who { margin: 0 0 var(--space-s); color: var(--text-dark-muted); }
  .submit-body__link { background: none; border: 0; padding: 0; font: inherit; color: var(--primary); text-decoration: underline; cursor: pointer; }

  .submit-choose { display: grid; gap: var(--space-s); grid-template-columns: repeat(auto-fit, minmax(16.25rem, 1fr)); }
  .submit-choose__option { display: flex; flex-direction: column; gap: var(--space-xs); align-items: flex-start; text-align: left; padding: var(--space-m); border: 1.5px solid var(--neutral-light); border-radius: var(--radius); background: var(--bg-ultra-light); cursor: pointer; font: inherit; color: var(--text-dark); min-block-size: 13.75rem; transition: border-color .15s, transform .15s; }
  .submit-choose__option:hover, .submit-choose__option:focus-within, .submit-choose__option:focus-visible { border-color: var(--text-dark); transform: translateY(-2px); }
  .submit-choose__option[data-variant="primary"] { border-color: var(--primary); background: var(--primary-ultra-light); }
  .submit-choose__option strong { font-family: var(--heading-font-family); font-size: 1.45rem; font-weight: 800; }
  .submit-choose__option span { color: var(--text-dark-muted); }
  .submit-choose__option .submit-choose__tip { font-size: var(--text-s); margin-block-start: auto; }
  .submit-choose__icon { inline-size: 3rem; block-size: 3rem; border-radius: var(--radius-s); background: var(--text-dark); display: grid; place-items: center; }
  .submit-choose__option[data-variant="primary"] .submit-choose__icon { background: var(--primary); }
  .submit-choose__icon svg { inline-size: 1.625rem; block-size: 1.625rem; fill: none; stroke: var(--white); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .submit-reading { display: flex; gap: var(--space-m); align-items: center; padding: var(--space-m); border: 1px solid var(--neutral-light); border-radius: var(--radius); background: var(--bg-ultra-light); }
  .submit-reading img { inline-size: 8.75rem; border-radius: var(--radius-xs); }
  .submit-reading p { color: var(--text-dark-muted); margin: 0.25rem 0 0; }
  .submit-reading__spinner { display: inline-block; inline-size: 1.125rem; block-size: 1.125rem; border: 3px solid var(--neutral-light); border-top-color: var(--primary); border-radius: 50%; animation: spin .8s linear infinite; margin-inline-end: var(--space-xs); vertical-align: -3px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .submit-reading__spinner { animation-duration: 3s; } }

  .submit-form { display: flex; flex-direction: column; gap: var(--space-m); }
  .submit-form__flyer { display: flex; gap: var(--space-m); align-items: flex-start; padding: var(--space-s); border: 1px solid var(--neutral-light); border-radius: var(--radius); background: var(--bg-ultra-light); }
  .submit-form__flyer img { inline-size: 9.375rem; border-radius: var(--radius-xs); border: 1px solid var(--neutral-light); }
  .submit-form__note { margin: 0 0 var(--space-xs); }
  fieldset { border: 1px solid var(--neutral-light); background: var(--bg-ultra-light); border-radius: var(--radius); padding: var(--space-m); margin: 0; display: flex; flex-direction: column; gap: var(--space-s); min-inline-size: 0; }
  fieldset[hidden] { display: none; }
  legend { font-family: var(--heading-font-family); font-weight: 800; font-size: var(--text-xl); padding: 0 0.375rem; }
  .submit-form__pair { display: grid; gap: var(--space-s); grid-template-columns: repeat(auto-fit, minmax(13.75rem, 1fr)); }
  .submit-form__field { display: flex; flex-direction: column; gap: 0.375rem; }
  .submit-form__field[hidden] { display: none; }
  label, .submit-form__label { font-weight: 600; font-size: var(--text-m); }
  .submit-form__optional { font-weight: 400; color: var(--text-dark-muted); }
  /* Not the visually hidden file inputs (.sr-only): full width there made the page scroll sideways. */
  input:not(:where(.sr-only)), select, textarea { font: inherit; font-size: var(--text-m); min-block-size: 3rem; padding: var(--space-xs) var(--space-s); border: 1.5px solid var(--neutral-light); border-radius: var(--radius-s); background: var(--white); color: var(--text-dark); inline-size: 100%; }
  textarea { min-block-size: 6rem; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--text-dark); box-shadow: 0 0 0 3px var(--primary-ultra-light); }
  [data-missing] { border-color: var(--primary); background: var(--primary-ultra-light); }

  .submit-form__shows { display: flex; flex-direction: column; gap: var(--space-xs); }
  .submit-form__show { display: grid; grid-template-columns: 1.4fr 1fr 1fr auto; gap: var(--space-xs); align-items: end; }
  .submit-form__show:has(.submit-form__act:not([hidden])) { grid-template-columns: 1.4fr 1fr 1fr 1.5fr auto; }
  .submit-form__show-field { display: flex; flex-direction: column; gap: 0.25rem; }
  .submit-form__show-field[hidden] { display: none; }
  .submit-form__show-field label { font-size: var(--text-xs); font-weight: 600; }
  .submit-form__remove { inline-size: 2.75rem; block-size: 3rem; border: 1.5px solid var(--neutral-light); border-radius: var(--radius-s); background: var(--white); cursor: pointer; color: var(--text-dark-muted); }
  .submit-form__remove[hidden] { display: none; }
  .submit-form__add { align-self: flex-start; margin-block-start: 0.25rem; min-block-size: 2.75rem; }
  @media (max-width: 620px) {
    .submit-form__show, .submit-form__show:has(.submit-form__act:not([hidden])) { grid-template-columns: 1fr 1fr; padding-block-end: var(--space-s); border-block-end: 1px dashed var(--neutral-light); }
    .submit-form__show .submit-form__show-field:first-child { grid-column: 1 / -1; }
    .submit-form__show-field.act { grid-column: 1 / -1; }
    .submit-form__flyer img, .submit-reading img { inline-size: 6rem; }
  }

  .submit-form__photo { display: flex; flex-wrap: wrap; gap: 0.375rem; align-items: baseline; padding: var(--space-s) var(--space-s); border: 1.5px dashed var(--neutral-light); border-radius: var(--radius-s); cursor: pointer; }
  .submit-form__photo strong { color: var(--primary); }
  .submit-form__check { display: flex; gap: var(--space-xs); align-items: center; font-weight: 400; }
  .submit-form__check input { inline-size: 1.25rem; min-block-size: 1.25rem; block-size: 1.25rem; }
  .submit-form__hint { color: var(--text-dark-muted); font-size: var(--text-s); margin-block-start: -6px; }
  .submit-form__trap { position: absolute; left: -9999px; }
  .submit-form__send { align-self: flex-start; min-block-size: 3.25rem; padding: 0 var(--space-m); font-size: var(--text-l); }
  .submit-form__status { font-weight: 600; color: var(--primary); min-block-size: 1.4em; }

  .submit-form__boost { gap: var(--space-s); }
  .submit-tier { display: flex; gap: var(--space-s); align-items: flex-start; padding: var(--space-s) var(--space-s); border: 1.5px solid var(--neutral-light); border-radius: var(--radius-s); background: var(--white); cursor: pointer; font-weight: 400; }
  .submit-tier:has(input:checked) { border-color: var(--text-dark); box-shadow: 0 0 0 1px var(--text-dark) inset; }
  .submit-tier input { inline-size: 1.375rem; block-size: 1.375rem; min-block-size: 1.375rem; margin-block-start: 0.125rem; flex: none; accent-color: var(--primary); }
  .submit-tier__body { display: flex; flex-direction: column; gap: 0.375rem; }
  .submit-tier__head { display: flex; gap: var(--space-xs); align-items: baseline; font-size: var(--text-l); }
  .submit-tier__price { font-weight: 700; color: var(--primary); }
  .submit-tier__text { color: var(--text-dark-muted); font-size: var(--text-s); }
  .submit-tier__list { margin: 0; padding-inline-start: var(--space-s); display: flex; flex-direction: column; gap: 0.25rem; }
  .submit-done__pay { display: flex; flex-direction: column; gap: var(--space-s); align-items: flex-start; padding: var(--space-s); border-radius: var(--radius-s); --_sponsored-bg: #FFF4D6; background: var(--_sponsored-bg); }
  .submit-done__pay[hidden] { display: none; }
  .submit-done { padding: var(--space-l); border: 1px solid var(--neutral-light); border-radius: var(--radius); background: var(--bg-ultra-light); display: flex; flex-direction: column; gap: var(--space-s); }
  .submit-done h2 { margin: 0; }
  .submit-done p { margin: 0; }
  .btn-row { display: flex; flex-wrap: wrap; gap: var(--space-s); margin-block-start: var(--space-xs); }

  /* Repeating events */
  .submit-repeat {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-s);
    border: 1px solid var(--neutral-light);
    border-radius: var(--radius-s);
    background: var(--bg-light);
  }
  .submit-repeat__unit { color: var(--text-dark-muted); font-size: var(--text-s); }
  .submit-repeat__days { padding: 0; border: 0; margin: 0; background: none; }
  .submit-repeat__day-list { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .submit-repeat__days legend { font-size: var(--text-s); font-weight: 600; padding: 0; margin-block-end: 0.25rem; }
  .submit-repeat__day { display: inline-flex; inline-size: auto; margin: 0; align-items: center; gap: 0.375rem; min-block-size: 2.75rem; padding-inline: var(--space-s); border: 1.5px solid var(--neutral-light); border-radius: var(--radius-circle); background: var(--bg-ultra-light); font-size: var(--text-s); font-weight: 500; cursor: pointer; }
  .submit-repeat__day:has(input:checked) { border-color: var(--text-dark); background: var(--text-dark); color: var(--text-light); }
  .submit-repeat__day input { inline-size: auto; min-block-size: 0; accent-color: var(--primary); }
  .submit-repeat__summary { font-weight: 600; }
  .submit-repeat__dates { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .submit-repeat__dates :global(.submit-repeat__date) { min-block-size: 2.75rem; padding-inline: var(--space-s); border: 1px solid var(--neutral-light); border-radius: var(--radius-circle); background: var(--bg-ultra-light); font-size: var(--text-s); cursor: pointer; }
  .submit-repeat__dates :global(.submit-repeat__date[aria-pressed="false"]) { text-decoration: line-through; color: var(--text-dark-muted); background: transparent; }
</style>
