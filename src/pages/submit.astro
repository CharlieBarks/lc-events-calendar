---
import Layout from '../layouts/Layout.astro';
import { CATEGORIES, INTAKE_URL, SPOTLIGHT, SITE, TURNSTILE_SITEKEY } from '../lib/site.js';
import { getVenues } from '../lib/events.js';

// Venue suggestions for the form (see getVenues). Picking one fills in the address and keeps
// venue names spelled one way.
const venueList = await getVenues();
---
<Layout title="Add Your Event" description="List your Las Cruces or Mesilla event for free. Upload your flyer and the details fill themselves in, or type it in yourself.">
  <section class="wrap-narrow submit-head">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Events</a><span aria-hidden="true">›</span><span aria-current="page">Add your event</span></nav>
    <p class="eyebrow">Free, always</p>
    <h1>Put it on the calendar.</h1>
    <p class="lede">If it's open to the public in Las Cruces or Mesilla, it belongs here. I check every listing, usually within a day. – Charlie</p>

    <!-- Welcome note for the new calendar (Charlie, Nov 23, 2026). "Got it" hides it on this device. -->
    <aside class="submit-welcome" data-welcome aria-labelledby="welcome-title">
      <h2 id="welcome-title">Welcome to the brand-new Las Cruces Events calendar!</h2>
      <p>I built this to make sharing your event easier than ever. Snap a photo of your flyer and the details fill themselves in. Add up to 4 photos. See exactly how your listing will look before you hit send. And fix anything later with your own private edit link.</p>
      <p>It's a big step forward for our local calendar, and I hope you find it simpler and more useful. Since it's new, you might spot a hiccup or two. If anything's confusing, not working right, or you have an idea to make it better, I'd love to hear from you: <a href="mailto:events@livelovelascruces.com?subject=New%20events%20calendar">events@livelovelascruces.com</a></p>
      <p class="submit-welcome__sign">Thanks for helping keep Las Cruces in the know. – Charlie</p>
      <button type="button" class="btn--base btn--outline btn--s" data-welcome-close>Got it</button>
    </aside>
  </section>

  <section class="wrap-narrow submit-body" data-app data-intake={INTAKE_URL} data-pay={SPOTLIGHT.payUrl} data-sitekey={TURNSTILE_SITEKEY} data-cats={JSON.stringify(Object.fromEntries(Object.entries(CATEGORIES).map(([k, c]) => [k, c.name])))}>
    <!-- The "are you a person?" check. Invisible unless Cloudflare needs the visitor to tick a box. -->
    <div data-human></div>
    <p class="submit-body__who" data-who hidden>Submitting as <strong data-who-name></strong> · <button type="button" class="submit-body__link" data-forget>not you?</button></p>

    <p class="notice" data-edit-note role="status" hidden></p>
    <div class="submit-mine" data-mine hidden>
      <p><strong>Your events</strong> (sent from this device). Open one to change it.</p>
      <ul role="list"></ul>
    </div>

    <!-- Step 1: pick a path -->
    <div class="submit-choose" data-step="choose">
      <label class="submit-choose__option" data-variant="primary" for="flyer">
        <input type="file" id="flyer" accept="image/*" class="sr-only" data-flyer />
        <span class="submit-choose__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 16l4.5-4.5a2 2 0 0 1 2.8 0L16 16m-2-2 1.5-1.5a2 2 0 0 1 2.8 0L20 14M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><circle cx="15" cy="8.5" r="1.5"/></svg></span>
        <strong>I have a flyer</strong>
        <span>Upload it and I'll fill in the details for you. You check them and hit send.</span>
        <span class="submit-choose__tip">On Facebook or Instagram? Screenshot the post and upload that.</span>
      </label>
      <button type="button" class="submit-choose__option" data-manual>
        <span class="submit-choose__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16Z"/><path d="m13.5 6.5 4 4"/></svg></span>
        <strong>No flyer? Type it in</strong>
        <span>Takes about a minute. You can still add a photo.</span>
      </button>
    </div>

    <!-- Reading the flyer -->
    <div class="submit-reading" data-step="reading" hidden>
      <img data-reading-img alt="Your flyer" />
      <div><span class="submit-reading__spinner" aria-hidden="true"></span><strong>Reading your flyer…</strong><p>This takes about 10 seconds.</p></div>
    </div>

    <!-- Already on the calendar? (Nov 24, 2026). Shown after a flyer is read, or before sending,
         when the event looks like a listing that's already up. See src/lib/dupes.js. -->
    <div class="submit-dupe" data-step="dupe" hidden>
      <h2 class="submit-dupe__title" data-dupe-title>Good news: this one's already on the calendar!</h2>
      <p class="submit-dupe__text" data-dupe-text>Here's the listing I found. Is it your event?</p>
      <ul class="submit-dupe__list" role="list" data-dupe-list></ul>
      <div class="submit-dupe__choices">
        <button type="button" class="btn--primary" data-dupe-done>That's it, I'm all set</button>
        <button type="button" class="btn--base" data-dupe-update>That's mine, update it</button>
        <button type="button" class="btn--base btn--outline" data-dupe-new>No, mine's a different event</button>
      </div>
      <p class="submit-form__hint" data-dupe-hint>"Update it" opens the listing so you can fix or add anything. Your flyer comes along as its new picture.</p>
    </div>

    <!-- Step 2: the form (both paths end here) -->
    <form class="submit-form" data-step="form" hidden novalidate>
      <div class="submit-form__flyer" data-flyer-box hidden>
        <img data-flyer-img alt="Your flyer" />
        <div>
          <p class="submit-form__note" data-read-note></p>
          <button type="button" class="submit-body__link" data-change>Use a different flyer</button>
        </div>
      </div>

      <fieldset>
        <legend>The basics</legend>
        <div class="submit-form__field"><label for="title">Event name</label><input id="title" name="title" required autocomplete="off" placeholder="e.g. Desert Rose Trio, Fall Art Walk" /></div>

        <div class="submit-form__field">
          <span class="submit-form__label">When</span>
          <div class="submit-form__shows" data-shows></div>
          <button type="button" class="submit-body__link submit-form__add" data-add-show>+ Add another date</button>

          <!-- Repeating event: the date row above becomes the first date and sets the times. -->
          <label class="submit-form__check"><input type="checkbox" data-repeat-on /> This repeats (weekly or monthly)</label>
          <div class="submit-repeat" data-repeat hidden>
            <div class="submit-form__pair">
              <div class="submit-form__field"><label for="rp-freq">Repeats</label>
                <select id="rp-freq" data-rp="freq"><option value="weekly">Weekly</option><option value="monthly">Monthly</option></select></div>
              <div class="submit-form__field"><label for="rp-every">Every</label>
                <select id="rp-every" data-rp="every"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option></select>
                <span class="submit-repeat__unit" data-rp-unit>week</span></div>
            </div>
            <fieldset class="submit-repeat__days" data-rp-days>
              <legend>On</legend>
              <div class="submit-repeat__day-list">
                {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((d, i) => <label class="submit-repeat__day"><input type="checkbox" value={i} data-rp-day /> {d}</label>)}
              </div>
            </fieldset>
            <div class="submit-form__field" data-rp-monthly hidden><label for="rp-by">On</label>
              <select id="rp-by" data-rp="by"><option value="weekday"></option><option value="date"></option></select></div>
            <div class="submit-form__field"><label for="rp-until">Ends on <span class="submit-form__optional">(optional: leave empty if it keeps going)</span></label><input id="rp-until" type="date" data-rp="until" /></div>
            <p class="submit-repeat__summary" data-rp-summary role="status"></p>
            <ul class="submit-repeat__dates" role="list" data-rp-dates></ul>
            <p class="submit-form__hint" data-rp-hint hidden>Not happening on one of these? Tap a date to take it out.</p>
          </div>
          <label class="submit-form__check"><input type="checkbox" data-annual /> This is an annual event (same time every year)</label>
        </div>

        <div class="submit-form__pair">
          <div class="submit-form__field"><label for="venue">Venue</label><input id="venue" name="venue" required autocomplete="off" placeholder="Start typing: Rio Grande Winery…" list="venue-list" data-venues={JSON.stringify(Object.fromEntries(venueList.filter((v) => v.address).map((v) => [v.name, v.address])))} />
            <datalist id="venue-list">{venueList.map((v) => <option value={v.name}>{v.address}</option>)}</datalist></div>
          <div class="submit-form__field"><label for="address">Address <span class="submit-form__optional">(optional)</span></label><input id="address" name="address" autocomplete="off" /></div>
        </div>
        <div class="submit-form__pair">
          <div class="submit-form__field">
            <label for="category">What kind of event?</label>
            <select id="category" name="category" required>
              <option value="">Pick one</option>
              {Object.entries(CATEGORIES).filter(([k]) => k !== 'city-hall').map(([k, c]) => <option value={k}>{c.name}</option>)}
            </select>
          </div>
          <div class="submit-form__field"><label for="price">Cost</label><input id="price" name="price" placeholder="Free, No cover, $10…" /></div>
        </div>
        <div class="submit-form__field"><label for="description">Tell people why they should come <span class="submit-form__optional">(optional)</span></label><textarea id="description" name="description" rows="6"></textarea></div>
        <div class="submit-form__field"><label for="url">Tickets or more info <span class="submit-form__optional">(optional)</span></label><input type="url" id="url" name="url" placeholder="https://" inputmode="url" /></div>

        <!-- Pictures (Nov 23): an optional flyer plus up to 4 photos. The main picture shows on the calendar. -->
        <div class="submit-form__field submit-pics" data-pics>
          <span class="submit-form__label">Pictures <span class="submit-form__optional">(optional, but events with a picture get way more clicks)</span></span>
          <ul class="submit-pics__list" role="list" data-pics-list></ul>
          <div class="submit-pics__add">
            <label class="submit-form__photo" for="add-flyer" data-add-flyer>
              <input type="file" id="add-flyer" accept="image/*" class="sr-only" data-flyer-extra />
              <strong>+ Add a flyer</strong>
            </label>
            <label class="submit-form__photo" for="photo" data-add-photos>
              <input type="file" id="photo" accept="image/*" multiple class="sr-only" data-photo />
              <strong data-photos-label>+ Add photos</strong> <span class="submit-form__optional" data-photos-left>(up to 4)</span>
            </label>
          </div>
          <p class="submit-form__hint" data-pics-hint hidden>Pick the <strong>main picture</strong>: it's the one people see on the calendar. Your event page shows all of them.</p>
          <p class="submit-form__status" data-pics-status role="status"></p>
        </div>
      </fieldset>

      <fieldset class="submit-form__boost" id="spotlight" data-boost>
        <legend>Want more eyes on it?</legend>
        <label class="submit-tier">
          <input type="radio" name="boost" value="" checked />
          <span class="submit-tier__body">
            <span class="submit-tier__head"><strong>Free</strong></span>
            <span class="submit-tier__text">Your event goes on the calendar. Always free.</span>
          </span>
        </label>
        <label class="submit-tier">
          <input type="radio" name="boost" value="spotlight" />
          <span class="submit-tier__body">
            <span class="submit-tier__head"><strong>Spotlight</strong> <span class="submit-tier__price">${SPOTLIGHT.price}</span></span>
            <ul class="submit-tier__list">
              <li>Pinned to the <strong>top of the calendar</strong> on your event's date, with a Sponsored label</li>
              <li>Rotates through the <strong>Spotlight</strong> section on the calendar's front page</li>
              <li>A mention in the <strong>Live Love Las Cruces newsletter</strong> ({SITE.subscribers} locals) before your event</li>
            </ul>
            <span class="submit-tier__text">You'll pay after you submit it. Nothing goes live until I've checked it over.</span>
          </span>
        </label>
      </fieldset>

      <fieldset data-contact>
        <legend>How do I reach you?</legend>
        <p class="submit-form__hint">Only used if I have a question about your listing. Never shown on the site.</p>
        <div class="submit-form__pair">
          <div class="submit-form__field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required /></div>
          <div class="submit-form__field"><label for="email">Email</label><input type="email" id="email" name="email" autocomplete="email" required /></div>
        </div>
        <div class="submit-form__field"><label for="phone">Phone <span class="submit-form__optional">(optional)</span></label><input type="tel" id="phone" name="phone" autocomplete="tel" /></div>
        <label class="submit-form__check"><input type="checkbox" name="remember" checked /> Remember me on this device</label>
      </fieldset>

      <fieldset class="submit-preview" data-preview>
        <legend>Here's how it'll look</legend>
        <p class="submit-form__hint">Your listing on the calendar, as people will see it. It updates as you type.</p>
        <div class="submit-preview__card">
          <div class="submit-preview__pic" data-pv-pic><span data-pv-initial></span></div>
          <div class="submit-preview__body">
            <p class="submit-preview__name" data-pv-name>Your event name</p>
            <p class="submit-preview__when"><span class="submit-preview__time" data-pv-time>Date and time</span> <span data-pv-venue></span></p>
            <p class="submit-preview__about" data-pv-about></p>
            <p class="submit-preview__where" data-pv-where></p>
          </div>
          <p class="submit-preview__price" data-pv-price></p>
        </div>
        <p class="submit-form__hint">Your event's own page also shows the full description, your link and every picture you sent.</p>
      </fieldset>

      <div class="submit-form__trap" aria-hidden="true"><label for="website">Leave this empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
      <button class="btn--primary submit-form__send" type="submit">Submit Your Event</button>
      <p class="submit-form__status" data-status role="status"></p>
    </form>

    <!-- Done -->
    <div class="submit-done" data-step="done" hidden>
      <h2 data-done-title>Got it, thanks!</h2>
      <p data-done-text>I'll check it over, usually within a day, and it'll show up on the calendar. If anything's unclear I'll email you.</p>
      <div class="submit-done__edit" data-done-edit hidden>
        <p><strong>Need to change it later?</strong> This private link opens your event so you can fix a date, a time or anything else. Keep it somewhere safe: anyone with the link can edit this event.</p>
        <p class="submit-done__link"><a data-edit-link href="#"></a></p>
        <button class="btn--base btn--outline btn--s" type="button" data-copy-edit>Copy the link</button>
      </div>
      <div class="submit-done__pay" data-done-pay hidden>
        <p><strong>One more step for your Spotlight:</strong> <span data-pay-text>pay the ${SPOTLIGHT.price} below. As soon as it comes through and I've checked your listing, it goes to the top.</span></p>
        <a class="btn--primary" data-pay-link href="#" target="_blank" rel="noopener">Pay ${SPOTLIGHT.price} for Spotlight</a>
      </div>
      <div class="btn-row"><button type="button" class="btn--base" data-again>Add another event</button><a class="btn--base btn--outline" href="/">Back to the calendar</a></div>
    </div>
  </section>
</Layout>

<template id="show-row">
  <div class="submit-form__show">
    <div class="submit-form__show-field"><label>Date</label><input type="date" data-k="date" required /></div>
    <div class="submit-form__show-field"><label>Starts</label><div class="submit-time" data-time="start"></div></div>
    <div class="submit-form__show-field"><label>Ends <span class="submit-form__optional">(opt.)</span></label><div class="submit-time" data-time="end"></div></div>
    <div class="submit-form__show-field submit-form__act" hidden><label>Different act? <span class="submit-form__optional">(opt.)</span></label><input data-k="title" autocomplete="off" /></div>
    <button type="button" class="submit-form__remove" aria-label="Remove this date" data-del>✕</button>
  </div>
</template>

<script>
  import { tidyRepeat, expand, describe, monthlyChoices, addDaysKey } from '../lib/repeat.js';
  import { findDuplicates, findByTitle } from '../lib/dupes.js';
  const app = document.querySelector('[data-app]') as HTMLElement;
  const INTAKE = app.dataset.intake!;

  // "Are you a person?" check (Cloudflare Turnstile). Each upload and each send gets its own
  // one-time token, which the lc-events-intake Worker verifies. The script only loads once someone
  // starts using the form. If it can't load (a blocker), the token is empty and the Worker decides.
  const SITEKEY = app.dataset.sitekey || '';
  let tsLoading: Promise<void> | undefined;
  let tsWidget: string | undefined;
  let tsDone: (token: string) => void = () => {};
  function loadHumanCheck() {
    if (!SITEKEY) return Promise.resolve();
    tsLoading ??= new Promise<void>((resolve, reject) => {
      (window as any).__humanCheckReady = () => resolve();
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__humanCheckReady';
      s.async = true;
      s.onerror = () => reject(new Error('blocked'));
      document.head.append(s);
    });
    return tsLoading;
  }
  async function humanToken(): Promise<string> {
    if (!SITEKEY) return '';
    try {
      await loadHumanCheck();
      const ts = (window as any).turnstile;
      return await new Promise<string>((resolve) => {
        tsDone = resolve;
        setTimeout(() => resolve(''), 30000);
        if (tsWidget === undefined) {
          tsWidget = ts.render(app.querySelector('[data-human]'), {
            sitekey: SITEKEY, appearance: 'interaction-only',
            callback: (t: string) => tsDone(t), 'error-callback': () => tsDone(''), 'timeout-callback': () => tsDone(''),
          });
        } else ts.reset(tsWidget); // a token works once, so ask for a fresh one
      });
    } catch { return ''; }
  }
  app.addEventListener('pointerenter', () => { loadHumanCheck().catch(() => {}); }, { once: true });
  app.addEventListener('focusin', () => { loadHumanCheck().catch(() => {}); }, { once: true });
  const form = app.querySelector('form') as HTMLFormElement;
  const showsEl = app.querySelector('[data-shows]') as HTMLElement;
  const tpl = document.getElementById('show-row') as HTMLTemplateElement;
  const status = app.querySelector('[data-status]') as HTMLElement;
  const KEY = 'lc-events-submitter';
  let imageId = ''; // the flyer (optional)
  let photoIds: string[] = []; // up to 4 photos
  let mainId = ''; // the picture shown on the calendar; '' = automatic (first photo, else the flyer)
  const MAX_PHOTOS = 4;
  let source = 'form';

  const $ = <T extends Element = HTMLElement>(s: string) => app.querySelector(s) as T;
  const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;

  function step(name: string) {
    app.querySelectorAll<HTMLElement>('[data-step]').forEach((el) => (el.hidden = el.dataset.step !== name));
    if (name !== 'choose') window.scrollTo({ top: app.offsetTop - 20, behavior: 'smooth' });
    if (name === 'form') setTimeout(renderPreview); // after the form is filled (flyer, edit link, suggest an edit)
  }

  // ---- Dates ----
  // A time is three small lists: hour (1-12), minutes (:00 :15 :30 :45, or "Other…" for any
  // minute) and AM/PM (left for the person to pick). They fill a hidden input that keeps
  // data-k="start"/"end", so the rest of the form reads the time as "HH:MM" like before.
  // Picking an hour fills in :00 if no minutes are chosen yet. The time only counts once AM/PM is set.
  const opt = (v: string, t = v) => `<option value="${v}">${t}</option>`;
  const TIME_HTML = (k: string) =>
    `<input type="hidden" data-k="${k}">` +
    `<select data-tp="h" aria-label="Hour">${opt('', 'Hour')}${[...Array(12)].map((_, i) => opt(String(i + 1))).join('')}</select>` +
    `<select data-tp="m" aria-label="Minutes">${opt('', 'Min')}${['00', '15', '30', '45'].map((m) => opt(m, ':' + m)).join('')}${opt('other', 'Other…')}</select>` +
    `<select data-tp="ap" aria-label="AM or PM">${opt('', 'AM/PM')}${opt('AM')}${opt('PM')}</select>`;
  function readTime(box: HTMLElement) {
    const h = (box.querySelector('[data-tp="h"]') as HTMLSelectElement).value;
    const mEl = box.querySelector('[data-tp="m"]') as HTMLSelectElement | HTMLInputElement;
    const ap = (box.querySelector('[data-tp="ap"]') as HTMLSelectElement).value;
    const m = Number(mEl.value);
    const hidden = box.querySelector('input[type="hidden"]') as HTMLInputElement;
    const v = h && ap && mEl.value !== '' && m >= 0 && m < 60 ? `${String((Number(h) % 12) + (ap === 'PM' ? 12 : 0)).padStart(2, '0')}:${String(m).padStart(2, '0')}` : '';
    if (hidden.value !== v) { hidden.value = v; hidden.dispatchEvent(new Event('input', { bubbles: true })); }
  }
  function minuteBox(sel: HTMLElement) {
    const box = document.createElement('input');
    box.type = 'number'; box.min = '0'; box.max = '59'; box.inputMode = 'numeric'; box.placeholder = 'min';
    box.dataset.tp = 'm'; box.setAttribute('aria-label', 'Minutes');
    sel.replaceWith(box);
    return box;
  }
  function setTime(row: HTMLElement, k: 'start' | 'end', v: string) {
    const box = row.querySelector(`[data-time="${k}"]`) as HTMLElement;
    box.innerHTML = TIME_HTML(k);
    if (!v) return;
    const [H, M] = v.split(':').map(Number);
    (box.querySelector('[data-tp="h"]') as HTMLSelectElement).value = String(H % 12 || 12);
    (box.querySelector('[data-tp="ap"]') as HTMLSelectElement).value = H < 12 ? 'AM' : 'PM';
    const mm = String(M).padStart(2, '0');
    let mEl = box.querySelector('[data-tp="m"]') as HTMLSelectElement | HTMLInputElement;
    if (!['00', '15', '30', '45'].includes(mm)) mEl = minuteBox(mEl);
    mEl.value = mEl instanceof HTMLSelectElement ? mm : String(M);
    (box.querySelector('input[type="hidden"]') as HTMLInputElement).value = v;
  }
  const onTime = (e: Event) => {
    const el = e.target as HTMLElement;
    const box = el.closest<HTMLElement>('[data-time]');
    if (!box || !el.dataset.tp) return;
    if (el.dataset.tp === 'm' && (el as HTMLSelectElement).value === 'other') { minuteBox(el).focus(); return; }
    const m = box.querySelector('[data-tp="m"]') as HTMLSelectElement | HTMLInputElement;
    if (el.dataset.tp === 'h' && (el as HTMLSelectElement).value && m.value === '') m.value = '00';
    readTime(box);
  };
  showsEl.addEventListener('change', onTime);
  showsEl.addEventListener('input', onTime);
  function addShow(s: { date?: string; start?: string; end?: string; title?: string } = {}) {
    const row = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    for (const k of ['date', 'title'] as const) (row.querySelector(`[data-k="${k}"]`) as HTMLInputElement).value = s[k] || '';
    setTime(row, 'start', s.start || ''); setTime(row, 'end', s.end || '');
    showsEl.append(row);
    syncShows();
  }
  function syncShows() {
    const rows = [...showsEl.children] as HTMLElement[];
    rows.forEach((r) => {
      (r.querySelector('[data-del]') as HTMLElement).hidden = rows.length === 1;
      (r.querySelector('.submit-form__act') as HTMLElement).hidden = rows.length === 1;
    });
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Denver' }).format(new Date());
    showsEl.querySelectorAll<HTMLInputElement>('[data-k="date"]').forEach((i) => (i.min = today));
  }
  showsEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-del]');
    if (b) { b.closest('.submit-form__show')!.remove(); syncShows(); }
  });
  $('[data-add-show]').addEventListener('click', () => {
    const last = [...showsEl.querySelectorAll('.submit-form__show')].pop();
    const get = (k: string) => (last?.querySelector(`[data-k="${k}"]`) as HTMLInputElement)?.value || '';
    addShow({ start: get('start'), end: get('end') }); // same times as the last date: residencies usually are
    (showsEl.lastElementChild!.querySelector('[data-k="date"]') as HTMLInputElement).focus();
  });

  // ---- Repeating events ----
  // The first date row is the first date and gives the times. The rule itself (weekly/monthly,
  // every N, weekdays, end date, dates taken out) is worked out by src/lib/repeat.js, the same
  // code the site uses to list the dates, so what shows here is what will be on the calendar.
  const rpBox = $('[data-repeat]');
  const rpOn = $<HTMLInputElement>('[data-repeat-on]');
  const rp = (k: string) => rpBox.querySelector(`[data-rp="${k}"]`) as HTMLInputElement;
  let rpSkip: string[] = [];
  const firstDate = () => (showsEl.querySelector('[data-k="date"]') as HTMLInputElement)?.value || '';
  function repeatRule() {
    if (!rpOn.checked || !firstDate()) return null;
    return tidyRepeat({
      freq: rp('freq').value, every: rp('every').value, by: rp('by').value, until: rp('until').value, skip: rpSkip, start: firstDate(),
      days: [...rpBox.querySelectorAll<HTMLInputElement>('[data-rp-day]:checked')].map((c) => Number(c.value)),
    });
  }
  function syncRepeat() {
    const on = rpOn.checked;
    rpBox.hidden = !on;
    // A repeating event has one date row: the first date.
    $('[data-add-show]').hidden = on;
    [...showsEl.children].slice(1).forEach((r) => { if (on) r.remove(); });
    if (on) syncShows();
    if (!on) return;
    const monthly = rp('freq').value === 'monthly';
    $('[data-rp-days]').hidden = monthly;
    $('[data-rp-monthly]').hidden = !monthly;
    $('[data-rp-unit]').textContent = (monthly ? 'month' : 'week') + (rp('every').value === '1' ? '' : 's');
    const start = firstDate();
    const summary = $('[data-rp-summary]');
    const dates = $('[data-rp-dates]');
    if (!start) { summary.textContent = 'Pick the first date above to see the dates.'; dates.innerHTML = ''; $('[data-rp-hint]').hidden = true; return; }
    const choices = monthlyChoices(start);
    (rp('by').options[0] as HTMLOptionElement).textContent = choices.weekday;
    (rp('by').options[1] as HTMLOptionElement).textContent = choices.date;
    // No weekday ticked yet: tick the first date's weekday.
    const boxes = [...rpBox.querySelectorAll<HTMLInputElement>('[data-rp-day]')];
    if (!boxes.some((b) => b.checked)) boxes[new Date(start + 'T12:00:00Z').getUTCDay()].checked = true;
    rp('until').min = start;
    const rule = repeatRule()!;
    const all = expand({ ...rule, skip: [] }, start, addDaysKey(start, 120), 12);
    const start_ = showsEl.querySelector('[data-k="start"]') as HTMLInputElement;
    const at = start_.value ? ` at ${new Date(`2000-01-01T${start_.value}`).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }).replace(':00', '')}` : '';
    summary.textContent = describe(rule).replace(/( until .*)?$/, (u) => `${at}${u}`) + '.';
    const nice = (k: string) => new Date(k + 'T12:00:00Z').toLocaleDateString('en-US', { timeZone: 'UTC', weekday: 'short', month: 'short', day: 'numeric' });
    dates.innerHTML = all.map((k) => `<li><button type="button" class="submit-repeat__date" data-rp-date="${k}" aria-pressed="${!rpSkip.includes(k)}" title="${rpSkip.includes(k) ? 'Put this date back' : 'Take this date out'}">${nice(k)}</button></li>`).join('');
    $('[data-rp-hint]').hidden = all.length === 0;
  }
  rpOn.addEventListener('change', syncRepeat);
  rpBox.addEventListener('input', syncRepeat);
  showsEl.addEventListener('input', (e) => {
    if (!rpOn.checked) return;
    // A new first date starts the rule over (its weekday and any dates taken out). A new time doesn't.
    if ((e.target as HTMLElement).matches('[data-k="date"]')) { rpSkip = []; rpBox.querySelectorAll<HTMLInputElement>('[data-rp-day]').forEach((b) => (b.checked = false)); }
    syncRepeat();
  });
  rpBox.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-rp-date]');
    if (!b) return;
    const k = b.dataset.rpDate!;
    rpSkip = rpSkip.includes(k) ? rpSkip.filter((x) => x !== k) : [...rpSkip, k];
    syncRepeat();
  });

  // ---- Venue suggestions ----
  // Picking a known venue fills in its address, unless the submitter already typed one themselves.
  const venueInput = field('venue');
  const venueAddresses: Record<string, string> = JSON.parse(venueInput.dataset.venues || '{}');
  let filledAddress = '';
  venueInput.addEventListener('input', () => {
    const address = field('address');
    const known = venueAddresses[venueInput.value.trim()];
    if (known && (!address.value || address.value === filledAddress)) { address.value = known; filledAddress = known; }
    else if (!known && address.value === filledAddress) { address.value = ''; filledAddress = ''; }
  });

  // ---- Remembered submitter ----
  function loadMe() {
    try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; }
  }
  function applyMe() {
    // Coming from a "Spotlight my event" link (?spotlight=1): Spotlight is pre-selected.
    if (['1', 'true', 'yes'].includes(new URLSearchParams(location.search).get('spotlight') || '')) {
      (form.querySelector('input[name="boost"][value="spotlight"]') as HTMLInputElement).checked = true;
    }
    const me = loadMe();
    const contact = $('[data-contact]');
    if (me?.name && me?.email) {
      field('name').value = me.name; field('email').value = me.email; field('phone').value = me.phone || '';
      $('[data-who-name]').textContent = me.name;
      $('[data-who]').hidden = false;
      contact.hidden = true;
    } else {
      $('[data-who]').hidden = true;
      contact.hidden = false;
    }
  }
  $('[data-forget]').addEventListener('click', () => {
    try { localStorage.removeItem(KEY); } catch {}
    field('name').value = ''; field('email').value = ''; field('phone').value = '';
    applyMe();
  });

  // ---- Images: shrink very large photos before upload (keeps flyers sharp, uploads fast) ----
  async function prepare(file: File): Promise<Blob> {
    if (file.size < 2.5e6 && /^image\/(jpeg|png|webp)$/.test(file.type)) return file;
    try {
      const bmp = await createImageBitmap(file);
      const scale = Math.min(1, 2400 / Math.max(bmp.width, bmp.height));
      const c = document.createElement('canvas');
      c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
      c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
      return await new Promise((r) => c.toBlob((b) => r(b || file), 'image/jpeg', 0.9));
    } catch { return file; }
  }
  async function upload(file: File) {
    const fd = new FormData();
    fd.append('image', await prepare(file), 'flyer.jpg');
    fd.append('human', await humanToken());
    const res = await fetch(`${INTAKE}/extract`, { method: 'POST', body: fd });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Upload failed');
    return data;
  }

  // ---- Editing an event through its private link (/submit/?edit=<key>) ----
  // The key is only ever sent to the submissions Worker. Events sent from this device are also
  // remembered here, so the submitter can find their links again ("Your events").
  const MINE = 'lc-events-mine';
  const editKey = new URLSearchParams(location.search).get('edit') || '';
  // "Suggest an edit" on an event page: /submit/?suggest=<that page's address>.
  let suggest = (new URLSearchParams(location.search).get('suggest') || '').replace(/[^a-z0-9-]/g, '');
  let suggestImage = '';
  const editUrl = (key: string) => `${location.origin}/submit/?edit=${key}`;
  function rememberEvent(key: string, title: string) {
    try {
      const list = JSON.parse(localStorage.getItem(MINE) || '[]').filter((x: any) => x.key !== key);
      list.unshift({ key, title, at: new Date().toISOString().slice(0, 10) });
      localStorage.setItem(MINE, JSON.stringify(list.slice(0, 30)));
    } catch {}
  }
  function showMine() {
    let list: any[] = [];
    try { list = JSON.parse(localStorage.getItem(MINE) || '[]'); } catch {}
    const box = $('[data-mine]');
    if (!list.length || editKey) { box.hidden = true; return; }
    box.hidden = false;
    const ul = box.querySelector('ul')!;
    ul.innerHTML = '';
    for (const x of list.slice(0, 8)) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = editUrl(x.key); a.textContent = x.title || 'Untitled event';
      li.append(a, ` · sent ${x.at}`);
      ul.append(li);
    }
  }
  async function startEdit() {
    step('reading');
    try {
      const res = await fetch(`${INTAKE}/mine?key=${encodeURIComponent(editKey)}`);
      const x = await res.json();
      if (!res.ok) throw new Error(x.error || 'Could not open that event.');
      for (const k of ['title', 'venue', 'address', 'price', 'url', 'description', 'category', 'name', 'email', 'phone']) field(k).value = x[k] || '';
      field('email').readOnly = true;
      showsEl.innerHTML = '';
      (x.shows?.length ? x.shows : [{}]).forEach(addShow);
      if (x.repeat) {
        rpOn.checked = true;
        rp('freq').value = x.repeat.freq; rp('every').value = String(x.repeat.every); rp('by').value = x.repeat.by || 'weekday'; rp('until').value = x.repeat.until || '';
        rpBox.querySelectorAll<HTMLInputElement>('[data-rp-day]').forEach((b) => (b.checked = (x.repeat.days || []).includes(Number(b.value))));
        rpSkip = x.repeat.skip || [];
      }
      $<HTMLInputElement>('[data-annual]').checked = !!x.annual;
      syncRepeat();
      // The pictures it already has, ready to keep, remove or change (Charlie, Nov 23).
      imageId = x.imageId || ''; photoIds = (x.photoIds || []).slice(0, MAX_PHOTOS); mainId = x.main || '';
      renderPics();
      $('[data-edit-note]').hidden = false;
      $('[data-edit-note]').textContent = x.trusted
        ? "You're a trusted submitter, so your changes go live on the calendar as soon as you save."
        : x.status === 'waiting'
        ? "You're editing an event that's still waiting to be checked. Your changes replace what you sent."
        : x.status === 'change-waiting' ? "You're editing a change that's still waiting to be checked. The calendar shows the earlier version until it's approved."
        : "You're editing an event that's on the calendar. Changes are checked before they show up, usually within a day.";
      $('[data-boost]').hidden = true;
      (form.querySelector('.submit-form__send') as HTMLElement).textContent = 'Save changes';
      step('form');
    } catch (err: any) {
      step('choose');
      $('[data-edit-note]').hidden = false;
      $('[data-edit-note]').textContent = err.message;
    }
  }
  // Opens the form filled in with the listing, read from its event page (the "event-data" block).
  async function startSuggest() {
    step('reading');
    try {
      const html = await fetch(`/event/${suggest}/`).then((r) => { if (!r.ok) throw new Error('gone'); return r.text(); });
      const raw = new DOMParser().parseFromString(html, 'text/html').getElementById('event-data')?.textContent;
      if (!raw) throw new Error('gone');
      const x = JSON.parse(raw);
      for (const k of ['title', 'venue', 'address', 'price', 'url', 'description', 'category']) field(k).value = x[k] || '';
      showsEl.innerHTML = '';
      addShow({ date: x.date, start: x.start, end: x.end });
      suggestImage = x.image || '';
      source = 'suggest';
      $('[data-edit-note]').hidden = false;
      $('[data-edit-note]').textContent = `You're suggesting a change to "${x.title}". Fix whatever is wrong or missing, add your name and email, and send it. I check every change before it goes up, usually within a day.`;
      $('[data-boost]').hidden = true;
      $('[data-contact]').hidden = false;
      (form.querySelector('.submit-form__send') as HTMLElement).textContent = 'Send my changes';
      step('form');
    } catch {
      step('choose');
      $('[data-edit-note]').hidden = false;
      $('[data-edit-note]').textContent = "That event isn't on the calendar any more. You can add it as a new event below.";
    }
  }
  $('[data-copy-edit]').addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLElement;
    try { await navigator.clipboard.writeText(($('[data-edit-link]') as HTMLAnchorElement).href); b.textContent = 'Copied'; } catch { b.textContent = 'Press and hold the link to copy it'; }
  });

  function fill(x: any) {
    for (const k of ['title', 'venue', 'address', 'price', 'url', 'description']) if (x[k] && !field(k).value) field(k).value = x[k];
    if (x.category && !field('category').value) field('category').value = x.category;
    showsEl.innerHTML = '';
    (x.shows?.length ? x.shows : [{}]).forEach(addShow);
  }
  function markMissing() {
    form.querySelectorAll('[data-missing]').forEach((el) => el.removeAttribute('data-missing'));
    const empty: string[] = [];
    if (!field('title').value) { field('title').setAttribute('data-missing', ''); empty.push('the event name'); }
    const dates = showsEl.querySelectorAll<HTMLInputElement>('[data-k="date"]');
    if (![...dates].some((d) => d.value)) { dates.forEach((d) => d.setAttribute('data-missing', '')); empty.push('the date'); }
    if (![...showsEl.querySelectorAll<HTMLInputElement>('[data-k="start"]')].some((d) => d.value)) empty.push('the start time');
    showsEl.querySelectorAll<HTMLElement>('[data-time]').forEach((box) => {
      const ap = box.querySelector('[data-tp="ap"]') as HTMLSelectElement;
      if ((box.querySelector('[data-tp="h"]') as HTMLSelectElement).value && !ap.value) { ap.setAttribute('data-missing', ''); if (!empty.includes('AM or PM')) empty.push('AM or PM'); }
    });
    if (!field('venue').value) { field('venue').setAttribute('data-missing', ''); empty.push('the venue'); }
    if (!field('category').value) field('category').setAttribute('data-missing', '');
    return empty;
  }

  // ---- Pictures: optional flyer + up to 4 photos, one of them the main picture ----
  const picUrl = (id: string) => `${INTAKE}/img/${id}`;
  const currentMain = () => [imageId, ...photoIds].includes(mainId) ? mainId : (photoIds[0] || imageId || '');
  function renderPics() {
    const list = $('[data-pics-list]');
    const pics = [...(imageId ? [{ id: imageId, kind: 'Flyer' }] : []), ...photoIds.map((id, i) => ({ id, kind: `Photo ${i + 1}` }))];
    const main = currentMain();
    list.innerHTML = pics.map((p) => `<li class="submit-pics__item"${p.id === main ? ' data-main' : ''}>
      <img src="${picUrl(p.id)}" alt="${p.kind}">
      <span class="submit-pics__kind">${p.kind}</span>
      <label class="submit-pics__main"><input type="radio" name="mainpic" value="${p.id}"${p.id === main ? ' checked' : ''}> Main picture</label>
      <button type="button" class="submit-pics__remove" data-remove-pic="${p.id}" aria-label="Remove ${p.kind.toLowerCase()}">Remove</button>
    </li>`).join('');
    ($('[data-add-flyer]') as HTMLElement).hidden = !!imageId;
    const left = MAX_PHOTOS - photoIds.length;
    ($('[data-add-photos]') as HTMLElement).hidden = left <= 0;
    $('[data-photos-label]').textContent = photoIds.length ? '+ Add more photos' : '+ Add photos';
    $('[data-photos-left]').textContent = `(up to ${left} more)`;
    $('[data-pics-hint]').hidden = pics.length < 2;
    renderPreview();
  }
  async function uploadPicture(f: File) {
    const fd = new FormData();
    fd.append('image', await prepare(f), 'photo.jpg');
    fd.append('human', await humanToken());
    const res = await fetch(`${INTAKE}/extract?read=0`, { method: 'POST', body: fd });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Upload failed');
    return data.imageId as string;
  }
  ($('[data-pics-list]') as HTMLElement).addEventListener('change', (e) => {
    const r = e.target as HTMLInputElement;
    if (r.name === 'mainpic') { mainId = r.value; renderPics(); }
  });
  ($('[data-pics-list]') as HTMLElement).addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-remove-pic]')?.dataset.removePic;
    if (!id) return;
    if (id === imageId) imageId = ''; else photoIds = photoIds.filter((x) => x !== id);
    if (mainId === id) mainId = '';
    renderPics();
  });
  ($('[data-photo]') as HTMLInputElement).addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const files = [...(input.files || [])];
    input.value = '';
    if (!files.length) return;
    const room = MAX_PHOTOS - photoIds.length;
    const st = $('[data-pics-status]');
    if (files.length > room) st.textContent = `Only ${room} more photo${room === 1 ? '' : 's'} fit, so I added the first ${room}.`;
    else st.textContent = 'Uploading…';
    for (const f of files.slice(0, room)) {
      try { photoIds.push(await uploadPicture(f)); renderPics(); }
      catch { st.textContent = "Couldn't upload one of those. Try another?"; }
    }
    if (st.textContent === 'Uploading…') st.textContent = '';
  });
  // A flyer added later (typed-in path, or after removing one): kept as the flyer, details not re-read.
  ($('[data-flyer-extra]') as HTMLInputElement).addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const f = input.files?.[0];
    input.value = '';
    if (!f) return;
    const st = $('[data-pics-status]');
    st.textContent = 'Uploading…';
    try { imageId = await uploadPicture(f); st.textContent = ''; renderPics(); }
    catch { st.textContent = "Couldn't upload that one. Try another?"; }
  });

  async function startFlyer(file: File) {
    const url = URL.createObjectURL(file);
    $<HTMLImageElement>('[data-reading-img]').src = url;
    $<HTMLImageElement>('[data-flyer-img]').src = url;
    step('reading');
    source = 'flyer';
    try {
      const data = await upload(file);
      imageId = data.imageId;
      form.reset(); applyMe();
      fill(data.extracted || {});
      const empty = markMissing();
      $('[data-read-note]').innerHTML = data.extracted && empty.length < 3
        ? `<strong>Here's what I read off your flyer.</strong> Check it over${empty.length ? ` and add ${empty.join(', ')}` : ''}.`
        : `<strong>I couldn't read much off this one.</strong> No problem, just fill in the details below.`;
      // Already on the calendar? Ask before the form (Charlie, Nov 24).
      flyerRead = data.extracted || {};
      const x = flyerRead;
      const found = await checkDupes({ title: x.title, venue: x.venue, dates: (x.shows || []).map((s: any) => s.date) }, data.sameFlyer);
      if (found.length) {
        $('[data-flyer-box]').hidden = false;
        renderPics();
        await showDupes(found, 'flyer');
        return;
      }
    } catch (err: any) {
      imageId = '';
      form.reset(); applyMe(); fill({});
      $('[data-read-note]').innerHTML = `<strong>${err.message === 'Upload failed' ? "That upload didn't go through." : err.message}</strong> You can still fill it in below, or try the flyer again.`;
    }
    $('[data-flyer-box]').hidden = false;
    step('form');
    renderPics();
    renderPreview();
  }

  ($('[data-flyer]') as HTMLInputElement).addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (f) startFlyer(f);
  });
  $('[data-change]').addEventListener('click', () => ($('[data-flyer]') as HTMLInputElement).click());
  $('[data-manual]').addEventListener('click', () => {
    source = 'form'; imageId = ''; photoIds = []; mainId = ''; dupeAsked = false; dupeOf = null; flyerRead = {};
    form.reset(); applyMe(); fill(prefill());
    $('[data-flyer-box]').hidden = true;
    step('form');
    renderPics();
    renderPreview();
    field('title').focus();
  });
  // Musicians arriving from their Las Cruces Live page: ?act=Desert%20Rose%20Trio
  function prefill() {
    const p = new URLSearchParams(location.search);
    const act = p.get('act');
    const venue = p.get('venue'); // from a venue page's "Add an event here"
    const known = venue && venueAddresses[venue] ? { address: venueAddresses[venue] } : {};
    return { ...(act ? { title: act, category: 'live-music' } : {}), ...(venue ? { venue, ...known } : {}) };
  }

  // ---- Already on the calendar? (Nov 24, 2026) ----
  // Checks the new event against the calendar's own search index (/search.json, rebuilt with the
  // site). Matching rules are in src/lib/dupes.js. If anything goes wrong (no index, slow network)
  // the form simply carries on: this check must never stop someone from sending an event.
  let searchIndex: Promise<any> | undefined;
  let dupeAsked = false; // the before-sending check runs once per event
  let dupeOf: { id: string; title: string } | null = null; // "No, mine's different": told to Charlie
  let flyerRead: any = {}; // what was read off the flyer, to add to a listing on "Update it"
  let dupeFound: any[] = [];
  let dupeFrom = 'flyer';
  const todayKey = () => new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Denver' }).format(new Date());
  function loadIndex() {
    searchIndex ??= fetch('/search.json').then((r) => (r.ok ? r.json() : null)).catch(() => null);
    return searchIndex;
  }
  async function checkDupes(ev: { title?: string; venue?: string; dates?: string[] }, sameFlyer?: { title: string; venue: string }) {
    try {
      const index = await Promise.race([loadIndex(), new Promise((r) => setTimeout(() => r(null), 6000))]);
      if (!index) return [];
      const today = todayKey();
      const found = findDuplicates({ title: ev.title || '', venue: ev.venue || '', dates: (ev.dates || []).filter((d) => d >= today) }, index, today);
      // The very same flyer file was uploaded before for a listing that's up now.
      const twin = sameFlyer ? findByTitle(sameFlyer.title, sameFlyer.venue, index, today) : null;
      if (twin && !found.some((f) => f.id === twin.id)) found.unshift(twin);
      return found.slice(0, 3);
    } catch { return []; }
  }
  // A listing's picture and time come from its event page (the same "event-data" block "Suggest
  // an edit" uses). No answer in 4 seconds: the card shows without them.
  async function listingInfo(id: string) {
    try {
      const html = await Promise.race([fetch(`/event/${id}/`).then((r) => (r.ok ? r.text() : '')), new Promise<string>((r) => setTimeout(() => r(''), 4000))]);
      const raw = html && new DOMParser().parseFromString(html, 'text/html').getElementById('event-data')?.textContent;
      return raw ? JSON.parse(raw) : {};
    } catch { return {}; }
  }
  const escHtml = (v: any) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  function niceDate(k: string, start = '') {
    const d = new Date(k + 'T12:00:00Z').toLocaleDateString('en-US', { timeZone: 'UTC', weekday: 'long', month: 'long', day: 'numeric' });
    const t = start ? new Date(`2000-01-01T${start}`).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }).replace(':00', '') : '';
    return t ? `${d} at ${t}` : d;
  }
  async function showDupes(found: any[], from: 'flyer' | 'submit') {
    dupeFound = found; dupeFrom = from;
    const infos = await Promise.all(found.map((f) => listingInfo(f.id)));
    const many = found.length > 1;
    $('[data-dupe-title]').textContent = many ? 'Is your event one of these?' : "Good news: this one's already on the calendar!";
    $('[data-dupe-text]').textContent = many
      ? 'These are already on the calendar and look a lot like yours.'
      : from === 'flyer' ? "I found it while reading your flyer. Is this your event?" : 'Before you send it: is this your event?';
    $('[data-dupe-list]').innerHTML = found.map((f, i) => {
      const x = infos[i] || {};
      const pic = x.image ? `<img class="submit-dupe__pic" src="${escHtml(x.image)}" alt="" loading="lazy">` : `<span class="submit-dupe__pic" aria-hidden="true"></span>`;
      const more = f.more ? `<p class="submit-dupe__more">Also on the calendar ${f.more === 1 ? '1 more time' : `${f.more} more times`} coming up.</p>` : '';
      const actions = many ? `<div class="submit-dupe__actions"><button type="button" class="btn--primary btn--s" data-dupe-done-one="${i}">That's it, I'm all set</button><button type="button" class="btn--base btn--s" data-dupe-update-one="${i}">That's mine, update it</button></div>` : '';
      return `<li class="submit-dupe__card">${pic}<div>
        <p class="submit-dupe__name"><a href="/event/${escHtml(f.id)}/" target="_blank" rel="noopener">${escHtml(f.title)}</a></p>
        <p class="submit-dupe__when">${escHtml(niceDate(f.date, x.start))}${f.venue ? ` · ${escHtml(f.venue)}` : ''}</p>${more}${actions}</div></li>`;
    }).join('');
    const choices = $('[data-step="dupe"] .submit-dupe__choices');
    if (many) choices.setAttribute('data-many', ''); else choices.removeAttribute('data-many');
    $('[data-dupe-hint]').hidden = !imageId;
    step('dupe');
  }
  // "That's it, I'm all set": nothing is sent. The link to share instead.
  function dupeDone(i: number) {
    const f = dupeFound[i];
    $('[data-done-title]').textContent = "You're all set!";
    const p = $('[data-done-text]');
    p.textContent = "It's already on the calendar, so there's nothing to send. Here's the link to share: ";
    const a = document.createElement('a');
    a.href = `/event/${f.id}/`; a.textContent = `${location.origin}/event/${f.id}/`;
    p.append(a);
    $('[data-done-edit]').hidden = true;
    $('[data-done-pay]').hidden = true;
    step('done');
  }
  // "That's mine, update it": the listing opens as a suggested edit. The flyer comes along as its
  // new picture, and anything the flyer has that the listing is missing is filled in.
  async function dupeUpdate(i: number) {
    const f = dupeFound[i];
    suggest = f.id;
    history.replaceState(null, '', `/submit/?suggest=${encodeURIComponent(f.id)}`);
    await startSuggest();
    if ($('[data-step="form"]').hidden) { suggest = ''; history.replaceState(null, '', '/submit/'); return; }
    for (const k of ['price', 'url', 'description']) if (!field(k).value && flyerRead[k]) field(k).value = flyerRead[k];
    $('[data-flyer-box]').hidden = true;
    if (imageId) {
      mainId = imageId;
      $('[data-edit-note]').textContent += ' Your flyer is added as the listing\'s new picture.';
    }
    renderPics();
    renderPreview();
  }
  $('[data-dupe-done]').addEventListener('click', () => dupeDone(0));
  $('[data-dupe-update]').addEventListener('click', () => dupeUpdate(0));
  $('[data-dupe-list]').addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const d = t.closest<HTMLElement>('[data-dupe-done-one]');
    if (d) return dupeDone(Number(d.dataset.dupeDoneOne));
    const u = t.closest<HTMLElement>('[data-dupe-update-one]');
    if (u) dupeUpdate(Number(u.dataset.dupeUpdateOne));
  });
  // "No, mine's a different event": on to the form (or straight on to sending), and the review
  // page shows Charlie which listing it looked like.
  $('[data-dupe-new]').addEventListener('click', () => {
    dupeOf = { id: dupeFound[0].id, title: dupeFound[0].title };
    dupeAsked = true;
    step('form');
    if (dupeFrom === 'submit') form.requestSubmit();
  });

  // ---- Send ----
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const shows = [...showsEl.querySelectorAll('.submit-form__show')].map((r) => ({
      date: (r.querySelector('[data-k="date"]') as HTMLInputElement).value,
      start: (r.querySelector('[data-k="start"]') as HTMLInputElement).value,
      end: (r.querySelector('[data-k="end"]') as HTMLInputElement).value,
      title: (r.querySelector('[data-k="title"]') as HTMLInputElement).value,
    })).filter((s) => s.date);
    const empty = markMissing();
    if (!form.checkValidity() || !shows.length) {
      if (empty.length) status.textContent = `Almost there: add ${empty.filter((x) => x !== 'the start time').join(', ') || 'the missing details'}.`;
      if ($('[data-contact]').hidden && (!field('name').value || !field('email').value)) $('[data-contact]').hidden = false;
      form.reportValidity();
      return;
    }
    const btn = form.querySelector('.submit-form__send') as HTMLButtonElement;
    // Typed in by hand: one look for the same event on the calendar before it's sent.
    if (!dupeAsked && !editKey && !suggest) {
      dupeAsked = true;
      const rule = repeatRule();
      const dates = rule ? expand({ ...rule, skip: rpSkip }, shows[0].date, addDaysKey(shows[0].date, 90), 30) : shows.map((s) => s.date);
      btn.disabled = true; status.textContent = 'Checking the calendar…';
      const found = await checkDupes({ title: field('title').value, venue: field('venue').value, dates });
      btn.disabled = false; status.textContent = '';
      if (found.length) { await showDupes(found, 'submit'); return; }
    }
    btn.disabled = true; status.textContent = 'Sending…';
    const body = {
      title: field('title').value, venue: field('venue').value, address: field('address').value, category: field('category').value,
      price: field('price').value, url: field('url').value, description: field('description').value, shows, imageId, photoIds, main: currentMain(),
      name: field('name').value, email: field('email').value, phone: field('phone').value, website: field('website').value,
      act: new URLSearchParams(location.search).get('act') || '', source,
      boost: (form.querySelector('input[name="boost"]:checked') as HTMLInputElement)?.value || '',
      repeat: repeatRule(),
      annual: $<HTMLInputElement>('[data-annual]').checked,
      ...(suggest ? { suggests: suggest, imageUrl: imageId ? '' : suggestImage } : {}),
      ...(dupeOf && !suggest ? { possibleDuplicate: dupeOf.id, possibleDuplicateTitle: dupeOf.title } : {}),
    };
    try {
      body.human = await humanToken();
      if (editKey) (body as any).key = editKey;
      const res = await fetch(`${INTAKE}/${editKey ? 'update' : 'submit'}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Something went wrong. Please try again.');
      try {
        if ((form.elements.namedItem('remember') as HTMLInputElement).checked || loadMe()) localStorage.setItem(KEY, JSON.stringify({ name: body.name, email: body.email, phone: body.phone }));
      } catch {}
      // The private edit link: shown now, and remembered on this device.
      const key = editKey || data.key || '';
      if (key) {
        rememberEvent(key, body.title);
        const a = $('[data-edit-link]') as HTMLAnchorElement;
        a.href = editUrl(key); a.textContent = editUrl(key);
        $('[data-done-edit]').hidden = false;
      }
      if (editKey) {
        // Trusted submitters' changes go live right away (data.published).
        if (data.published) doneLive("Your changes are live!", data.page);
        else $('[data-done-text]').textContent = data.live
          ? "Your changes are saved, but they're not on the calendar yet. I check every change, usually within a day, and you'll get an email when they're live. Until then the calendar shows the earlier version."
          : "Your changes are saved. Your event isn't on the calendar yet: I check every listing, usually within a day, and you'll get an email when it's live.";
        $('[data-done-pay]').hidden = true;
        status.textContent = ''; step('done'); return;
      }
      // Charlie, Nov 23: say plainly that it isn't on the calendar until it's checked.
      if (data.live) doneLive(shows.length > 1 ? `All ${shows.length} dates are live on the calendar!` : "It's live on the calendar!", data.page);
      else $('[data-done-text]').textContent = shows.length > 1
        ? `All ${shows.length} dates are in, but they're not on the calendar yet. I check every listing myself, usually within a day, and you'll get an email the moment they're live.`
        : "It's in, but it's not on the calendar yet. I check every listing myself, usually within a day, and you'll get an email the moment it's live.";
      // Spotlight: send them to pay, with the submission's reference so the payment can be matched in Stripe.
      const paid = body.boost === 'spotlight';
      $('[data-done-pay]').hidden = !paid;
      const payUrl = app.dataset.pay || '';
      const link = $('[data-pay-link]') as HTMLAnchorElement;
      if (paid && payUrl) {
        const u = new URL(payUrl);
        u.searchParams.set('client_reference_id', data.id);
        if (body.email) u.searchParams.set('prefilled_email', body.email);
        link.href = u.toString(); link.hidden = false;
      } else if (paid) {
        link.hidden = true;
        $('[data-pay-text]').textContent = "I'll email you a payment link. As soon as it comes through and I've checked your listing, it goes to the top.";
      }
      status.textContent = '';
      step('done');
    } catch (err: any) {
      status.textContent = err.message;
    } finally { btn.disabled = false; }
  });

  $('[data-again]').addEventListener('click', () => {
    $('[data-done-title]').textContent = 'Got it, thanks!';
    imageId = ''; photoIds = []; mainId = ''; form.reset(); ($('[data-flyer]') as HTMLInputElement).value = '';
    dupeAsked = false; dupeOf = null; flyerRead = {};
    renderPics();
    applyMe(); step('choose');
  });


  // ---- Pasting into "Tell people why they should come" ----
  // Text copied from Grok, ChatGPT, Google Docs or a web page often reaches a plain text box
  // without its line breaks (Charlie, Nov 23). The copied web version still has the paragraphs, so
  // rebuild them from it: paragraphs and headings become blank lines, list items "• ", and Markdown
  // marks (**bold**, # headings) are dropped. Plain text that already has line breaks is left alone.
  function pastedText(html: string) {
    const doc = new DOMParser().parseFromString(html, 'text/html');
    doc.querySelectorAll('script, style').forEach((n) => n.remove());
    const out: string[] = [];
    const walk = (n: Node) => {
      if (n.nodeType === 3) { out.push((n.textContent || '').replace(/\s+/g, ' ')); return; }
      if (n.nodeType !== 1) return;
      const tag = (n as Element).tagName;
      if (tag === 'BR') { out.push('\n'); return; }
      const block = /^(P|DIV|H[1-6]|LI|UL|OL|BLOCKQUOTE|PRE|TR|SECTION|ARTICLE|HEADER|FOOTER|TABLE)$/.test(tag);
      if (tag === 'LI') out.push('\n• ');
      else if (block) out.push('\n\n');
      n.childNodes.forEach(walk);
      if (block && tag !== 'LI') out.push('\n\n');
    };
    walk(doc.body);
    return out.join('').replace(/[ \t]+\n/g, '\n').replace(/\n[ \t]+/g, '\n').replace(/\n{3,}/g, '\n\n').replace(/\n\n(• )/g, '\n$1').trim();
  }
  const tidyMarkdown = (t: string) => t
    .replace(/\r/g, '')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/\*\*(.+?)\*\*/g, '$1').replace(/__(.+?)__/g, '$1')
    .replace(/^\s*[-*]\s+/gm, '• ');
  field('description').addEventListener('paste', (e: ClipboardEvent) => {
    const html = e.clipboardData?.getData('text/html') || '';
    const plain = e.clipboardData?.getData('text/plain') || '';
    let text = '';
    if (html && !/\n/.test(plain.trim())) text = pastedText(html);
    else if (/\*\*|^#{1,6}\s|^\s*[-*]\s/m.test(plain)) text = tidyMarkdown(plain);
    if (!text) return; // let the browser paste it as it is
    e.preventDefault();
    const box = field('description') as unknown as HTMLTextAreaElement;
    box.setRangeText(text, box.selectionStart, box.selectionEnd, 'end');
    box.dispatchEvent(new Event('input', { bubbles: true }));
  });

  // ---- "Here's how it'll look": a live copy of the listing's row on the calendar ----
  const CAT_NAMES: Record<string, string> = JSON.parse(app.dataset.cats || '{}');
  const DAY = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const clock = (v: string) => {
    if (!v) return null;
    const [H, M] = v.split(':').map(Number);
    return { t: `${H % 12 || 12}${M ? ':' + String(M).padStart(2, '0') : ''}`, ap: H < 12 ? 'AM' : 'PM' };
  };
  function renderPreview() {
    const box = $('[data-preview]');
    if (!box) return;
    const title = field('title').value.trim();
    $('[data-pv-name]').textContent = title || 'Your event name';
    const row = showsEl.querySelector<HTMLElement>('.submit-form__show, [data-show]') || showsEl;
    const date = (row.querySelector('[data-k="date"]') as HTMLInputElement | null)?.value || '';
    const a = clock((row.querySelector('[data-k="start"]') as HTMLInputElement | null)?.value || '');
    const b = clock((row.querySelector('[data-k="end"]') as HTMLInputElement | null)?.value || '');
    let when = '';
    if (date) { const [y, m, d] = date.split('-').map(Number); const dt = new Date(y, m - 1, d); when = `${DAY[dt.getDay()]}, ${MON[m - 1]} ${d}`; }
    const time = a ? (b ? `${a.t}${a.ap === b.ap ? '' : ' ' + a.ap} - ${b.t} ${b.ap}` : `${a.t} ${a.ap}`) : '';
    $('[data-pv-time]').textContent = [when, time].filter(Boolean).join(' · ') || 'Date and time';
    const venue = field('venue').value.trim();
    $('[data-pv-venue]').textContent = venue ? `· ${venue}` : '';
    const desc = (field('description') as unknown as HTMLTextAreaElement).value.replace(/\s+/g, ' ').trim();
    const first = desc.match(/^(.{20,160}?[.!?])(\s|$)/);
    $('[data-pv-about]').textContent = first ? first[1] : desc.slice(0, 140);
    $('[data-pv-where]').textContent = CAT_NAMES[field('category').value] || '';
    $('[data-pv-price]').textContent = field('price').value.trim();
    const pic = $('[data-pv-pic]');
    const id = currentMain();
    const src = id ? `${INTAKE}/img/${id}` : suggestImage;
    pic.style.backgroundImage = src ? `url("${src}")` : '';
    pic.toggleAttribute('data-empty', !src);
    $('[data-pv-initial]').textContent = src ? '' : (title[0] || '★').toUpperCase();
  }
  form.addEventListener('input', renderPreview);
  form.addEventListener('change', renderPreview);

  // Trusted submitters: their event went straight onto the calendar.
  function doneLive(text: string, page: string) {
    const p = $('[data-done-text]');
    p.textContent = `${text} It shows up within a few minutes. `;
    if (page) { const a = document.createElement('a'); a.href = page; a.textContent = 'See your event'; p.append(a); }
    $('[data-done-title]').textContent = 'Thanks!';
  }

  // Back from Stripe after paying for a Spotlight (the Payment Link sends buyers to ?spotlight=paid).
  if (new URLSearchParams(location.search).get('spotlight') === 'paid') {
    const n = $('[data-edit-note]');
    n.hidden = false;
    n.textContent = "Thank you! Your Spotlight payment went through. I'll put your event at the top of the calendar as soon as I've checked it over, usually within a day, and you'll get an email when it's live. Stripe is emailing your receipt.";
    document.querySelector<HTMLElement>('[data-welcome]')!.hidden = true;
  }

  // Welcome note: once someone taps "Got it", it stays hidden on this device.
  const WELCOME = 'lc-events-welcome-seen';
  try { if (localStorage.getItem(WELCOME)) document.querySelector<HTMLElement>('[data-welcome]')!.hidden = true; } catch {}
  document.querySelector('[data-welcome-close]')?.addEventListener('click', () => {
    document.querySelector<HTMLElement>('[data-welcome]')!.hidden = true;
    try { localStorage.setItem(WELCOME, '1'); } catch {}
  });

  applyMe();
  showMine();
  if (editKey) startEdit();
  else if (suggest) startSuggest();
  form.addEventListener('input', (e) => (e.target as HTMLElement).removeAttribute?.('data-missing'));
</script>

<style>
  .submit-welcome { display: flex; flex-direction: column; gap: var(--space-xs); align-items: flex-start; margin-block-start: var(--space-s); padding: var(--space-m); border: 1.5px solid color-mix(in oklch, var(--secondary) 45%, var(--white)); border-radius: var(--radius); background: color-mix(in oklch, var(--secondary) 7%, var(--white)); font-size: var(--text-m); }
  .submit-welcome[hidden] { display: none; }
  .submit-welcome h2 { font-size: var(--h4); margin: 0; }
  .submit-welcome p { margin: 0; }
  .submit-welcome a { font-weight: 700; color: var(--secondary); }
  .submit-welcome__sign { font-style: italic; }
  .submit-welcome button { margin-block-start: var(--space-xs); }
  /* Pictures box: optional flyer + up to 4 photos, one marked as the main picture. */
  .submit-pics__list { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: var(--space-s); margin: var(--space-xs) 0; padding: 0; list-style: none; }
  .submit-pics__list:empty { display: none; }
  .submit-pics__list :global(.submit-pics__item) { display: flex; flex-direction: column; gap: 0.375rem; padding: 0.5rem; border: 1.5px solid var(--neutral-light); border-radius: var(--radius-s); background: var(--white); }
  .submit-pics__list :global(.submit-pics__item[data-main]) { border-color: var(--secondary); box-shadow: 0 0 0 1px var(--secondary) inset; }
  .submit-pics__list :global(.submit-pics__item img) { inline-size: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-xs); background: var(--neutral-ultra-light); }
  .submit-pics__list :global(.submit-pics__kind) { font-size: var(--text-s); font-weight: 700; }
  .submit-pics__list :global(.submit-pics__main) { display: flex; align-items: center; gap: 0.375rem; font-size: var(--text-s); cursor: pointer; }
  .submit-pics__list :global(.submit-pics__item[data-main] .submit-pics__main) { color: var(--secondary); font-weight: 700; }
  .submit-pics__list :global(.submit-pics__main input) { inline-size: auto; accent-color: var(--secondary); }
  .submit-pics__list :global(.submit-pics__remove) { align-self: flex-start; padding: 0.25rem 0; background: none; border: 0; color: var(--primary); font: inherit; font-size: var(--text-s); text-decoration: underline; cursor: pointer; min-block-size: 2rem; }
  .submit-pics__add { display: grid; gap: var(--space-xs); grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
  .submit-pics__add [hidden] { display: none; }

  /* "Here's how it'll look": same shape and sizes as a list row on the calendar (EventCard, row). */
  .submit-preview__card { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: var(--space-s); padding: var(--space-s); border: 1px solid var(--neutral-light); border-radius: var(--radius); background: var(--bg-ultra-light); }
  .submit-preview__pic { inline-size: 6rem; block-size: 6rem; border-radius: var(--radius-s); background: var(--neutral-ultra-light) center / cover no-repeat; display: grid; place-items: center; }
  .submit-preview__pic[data-empty] { background-color: var(--secondary); }
  .submit-preview__pic span { color: var(--white); font-family: var(--heading-font-family); font-size: 2.5rem; font-weight: 800; }
  .submit-preview__body { display: flex; flex-direction: column; gap: 0.125rem; min-inline-size: 0; }
  .submit-preview__body p, .submit-preview__price { margin: 0; }
  .submit-preview__name { font-family: var(--heading-font-family); font-size: 1.3rem; font-weight: 700; line-height: 1.2; }
  .submit-preview__when { color: var(--text-dark-muted); font-size: var(--text-m); }
  .submit-preview__time { color: var(--secondary); font-weight: 700; }
  .submit-preview__about { font-size: var(--text-m); line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .submit-preview__where { color: var(--text-dark-muted); font-size: var(--text-s); }
  .submit-preview__price { grid-column: 2; color: var(--secondary); font-size: var(--text-m); font-weight: 700; }
  .submit-preview__price:empty { display: none; }
  @media (min-width: 48rem) {
    .submit-preview__card { grid-template-columns: 8rem minmax(0, 1fr) auto; }
    .submit-preview__pic { inline-size: 8rem; block-size: 8rem; }
    .submit-preview__price { grid-column: 3; grid-row: 1; text-align: right; }
  }

  .submit-head { display: flex; flex-direction: column; gap: var(--space-s); padding-block-end: var(--space-m); }
  .submit-head h1 { margin-block-start: var(--space-s); }
  .submit-body { padding-block-end: var(--space-xxl); }
  .submit-body__who { margin: 0 0 var(--space-s); color: var(--text-dark-muted); }
  .submit-body__link { background: none; border: 0; padding: 0; font: inherit; color: var(--primary); text-decoration: underline; cursor: pointer; }

  .submit-choose { display: grid; gap: var(--space-s); grid-template-columns: repeat(auto-fit, minmax(16.25rem, 1fr)); }
  .submit-choose__option { display: flex; flex-direction: column; gap: var(--space-xs); align-items: flex-start; text-align: left; padding: var(--space-m); border: 1.5px solid var(--neutral-light); border-radius: var(--radius); background: var(--bg-ultra-light); cursor: pointer; font: inherit; color: var(--text-dark); min-block-size: 13.75rem; transition: border-color .15s, transform .15s; }
  .submit-choose__option:hover, .submit-choose__option:focus-within, .submit-choose__option:focus-visible { border-color: var(--text-dark); transform: translateY(-2px); }
  .submit-choose__option[data-variant="primary"] { border-color: var(--primary); background: var(--primary-ultra-light); }
  .submit-choose__option strong { font-family: var(--heading-font-family); font-size: 1.45rem; font-weight: 800; }
  .submit-choose__option span { color: var(--text-dark-muted); }
  .submit-choose__option .submit-choose__tip { font-size: var(--text-s); margin-block-start: auto; }
  .submit-choose__icon { inline-size: 3rem; block-size: 3rem; border-radius: var(--radius-s); background: var(--text-dark); display: grid; place-items: center; }
  .submit-choose__option[data-variant="primary"] .submit-choose__icon { background: var(--primary); }
  .submit-choose__icon svg { inline-size: 1.625rem; block-size: 1.625rem; fill: none; stroke: var(--white); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .submit-reading { display: flex; gap: var(--space-m); align-items: center; padding: var(--space-m); border: 1px solid var(--neutral-light); border-radius: var(--radius); background: var(--bg-ultra-light); }
  .submit-reading img { inline-size: 8.75rem; border-radius: var(--radius-xs); }
  .submit-reading p { color: var(--text-dark-muted); margin: 0.25rem 0 0; }
  .submit-reading__spinner { display: inline-block; inline-size: 1.125rem; block-size: 1.125rem; border: 3px solid var(--neutral-light); border-top-color: var(--primary); border-radius: 50%; animation: spin .8s linear infinite; margin-inline-end: var(--space-xs); vertical-align: -3px; }
  @keyframes spin { to { transform: rotate(360deg); } }
