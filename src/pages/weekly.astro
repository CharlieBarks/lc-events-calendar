---
// Weekly regulars (Charlie, Nov 25, 2026): every standing date, grouped by day of the week, because
// that's how people look for them ("what's on Tuesday nights?"). The homepage shows a few.
import Layout from '../layouts/Layout.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE, CATEGORIES, breadcrumbJsonLd } from '../lib/site.js';
import { getEvents, shortVenue } from '../lib/events.js';
import { todayWall, dateKey, addDays, weekday, dayLabel, timeLabel } from '../lib/time.js';

const { series } = await getEvents();
// The next 7 days, starting today (Charlie, Nov 28, 2026): each regular under the dates it actually
// happens this week, so nothing weeks out gets mixed in. The main calendar shows the same regulars
// folded under each day; this page is the quick "what's on Tuesday night?" view.
const start = todayWall();
const days = Array.from({ length: 7 }, (_, i) => {
  const w = addDays(start, i);
  return { key: dateKey(w), id: weekday(w).toLowerCase(), name: weekday(w), label: dayLabel(w), today: i === 0, items: [] };
});
const byKey = new Map(days.map((d) => [d.key, d]));
for (const s of series) for (const d of s.dates) byKey.get(d.date)?.items.push({ s, next: d });
// Within a day: by start time, then name.
for (const d of days) d.items.sort((a, b) => a.next.start.H * 60 + a.next.start.M - (b.next.start.H * 60 + b.next.start.M) || a.s.title.localeCompare(b.s.title));
const shown = days.filter((d) => d.items.length > 0);
const jsonLd = [breadcrumbJsonLd([{ name: 'Events', path: '/' }, { name: 'Weekly regulars', path: '/weekly/' }])];
---
<Layout title="Weekly Events in Las Cruces: Trivia, Karaoke, Markets and More, Day by Day" description="The next 7 days of standing dates in Las Cruces and Mesilla, day by day: trivia nights, karaoke, open mics, markets, dance nights, clubs and classes." jsonLd={jsonLd}>
  <section class="page-hero wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Events</a><span aria-hidden="true">›</span><span aria-current="page">Weekly regulars</span></nav>
    <p class="eyebrow">The standing dates</p>
    <h1>Weekly regulars</h1>
    <p class="lede">Trivia, karaoke, open mics, markets, clubs and classes coming up in the next 7 days. Cheap, easy and a good way to meet your neighbors.</p>
    <nav class="weekdays" aria-label="Pick a day">
      <a class="weekdays__day" href="#all" data-day="all">Next 7 days</a>
      {shown.map((d) => <a class="weekdays__day" href={`#${d.id}`} data-day={d.id} aria-current={d.today ? 'date' : undefined}>{d.today ? 'Today' : d.name.slice(0, 3)}</a>)}
    </nav>
  </section>
  <section class="wrap page-body">
    {shown.map((d) => (
      <div class="weekday" id={d.id}>
        <h2>{d.today ? `Today, ${d.label.replace(/^\w+, /, '')}` : d.label}<span class="weekday__count">{d.items.length} {d.items.length === 1 ? 'regular' : 'regulars'}</span></h2>
        <ul class="grid-tight regulars" role="list">
          {d.items.map(({ s, next }) => (
            <li><a class="regulars__link" href={`/event/${next.slug}/`}>
              <span class="dot" style={`background:${CATEGORIES[s.category]?.color || 'var(--neutral)'}`} aria-hidden="true"></span>
              <span>
                <h3>{s.title}</h3>
                <span class="regulars__when">{timeLabel(next.start)} · {s.when}</span>
                <span class="regulars__where">{shortVenue(next)}</span>
              </span>
            </a></li>
          ))}
        </ul>
      </div>
    ))}
    {shown.length === 0 && <div class="notice">No regulars this week. Run a weekly night? <a href="/submit/">Add it</a> and tick "This repeats".</div>}
    <p class="page-note">Run a weekly trivia, open mic or club? <a href="/submit/">Add it once</a> and tick "This repeats": it stays on the calendar every week.</p>
  </section>
  <Newsletter />
</Layout>
<script>
  // Day buttons show just that day (Charlie, Nov 28, 2026); "All days" shows the whole week. Uses the
  // #hash, so links like /weekly/#saturday still work. Without JavaScript they just jump down the page.
  const show = () => {
    const day = location.hash.slice(1).toLowerCase();
    const days = document.querySelectorAll('.weekday');
    const match = [...days].some((el) => el.id === day);
    days.forEach((el) => { el.hidden = match && el.id !== day; });
    document.querySelectorAll('.weekdays__day').forEach((a) => a.classList.toggle('is-picked', match ? a.dataset.day === day : a.dataset.day === 'all'));
  };
  show();
  addEventListener('hashchange', show);
</script>
<style>
  .page-hero { display: flex; flex-direction: column; gap: var(--space-s); padding-block: var(--space-l); }
  .page-hero h1 { margin-block-start: var(--space-s); }
  .weekdays { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-block-start: var(--space-s); }
  .weekdays__day { display: inline-flex; align-items: center; gap: 0.35rem; min-block-size: 2.75rem; padding-inline: var(--space-m); border: 1.5px solid var(--neutral-light); border-radius: 999px; background: var(--bg-ultra-light); color: var(--text-dark); font-weight: 600; text-decoration: none; }
  .weekdays__day.is-picked { border-color: var(--secondary); background: var(--secondary); color: var(--white); }
  .weekday[hidden] { display: none; }
  .weekday__count { margin-inline-start: auto; font-size: var(--text-m); font-weight: 500; color: var(--text-dark-muted); }
  .page-body { padding-block-end: var(--space-xl); display: flex; flex-direction: column; gap: var(--space-xl); }
  .weekday { scroll-margin-block-start: 4.5rem; }
  .weekday h2 { display: flex; align-items: center; gap: var(--space-s); margin-block-end: var(--space-m); padding-block-end: var(--space-xs); border-block-end: 2px solid var(--text-dark); }
  .weekday__today { font-family: var(--text-font-family, inherit); font-size: var(--text-s); font-weight: 700; padding: 0.15rem 0.6rem; border-radius: 999px; background: var(--secondary); color: var(--white); }
  .page-note { color: var(--text-dark-muted); max-inline-size: 70ch; }
  /* Four cards across at most (Charlie, Nov 28, 2026), fewer as the window narrows (each card at least 15rem). */
  .regulars { grid-template-columns: repeat(auto-fill, minmax(max(15rem, calc((100% - 3 * var(--grid-gap)) / 4)), 1fr)); }
  .regulars li { display: flex; }
  .regulars__link { flex: 1; display: flex; gap: var(--space-s); align-items: flex-start; padding: var(--space-s); background: var(--bg-light); border: 1px solid var(--neutral-light); border-radius: var(--radius-s); text-decoration: none; color: var(--text-dark); }
  .regulars__link:hover { border-color: var(--text-dark); color: var(--text-dark); }
  .regulars__link .dot { margin-block-start: var(--space-xs); flex: none; }
  .regulars__link > span:last-child { display: flex; flex-direction: column; gap: 0.125rem; }
  .regulars__link h3 { font-size: var(--text-l); }
  .regulars__when { font-weight: 600; color: var(--secondary); }
  .regulars__where { color: var(--text-dark-muted); font-size: var(--text-s); }
</style>
