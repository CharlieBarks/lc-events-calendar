---
// Every Spotlight event in one place (Charlie, Nov 28, 2026). The homepage Spotlight shows three at
// random; this page has them all, linked from "See all Spotlight events" under that section.
// Same picks as the homepage: only events Charlie marks (Sponsored, Spotlight (free), Featured), each
// once at its next date. Order: Sponsored (paid), then Spotlight (free), then Featured; soonest first
// within each. The script drops anything that ended since the last build.
import Layout from '../../layouts/Layout.astro';
import EventCard from '../../components/EventCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { SITE, SPOTLIGHT, breadcrumbJsonLd } from '../../lib/site.js';
import { getEvents } from '../../lib/events.js';

const { dated: events, ongoing } = await getEvents();
const group = (e) => (e.sponsored && !e.freeSpotlight ? 0 : e.sponsored ? 1 : 2);
const list = [...events, ...ongoing]
  .filter((e) => e.spotlight)
  .filter((e, i, a) => a.findIndex((x) => x.title === e.title) === i)
  .sort((a, b) => group(a) - group(b) || (a.ongoing ? '0' : a.date).localeCompare(b.ongoing ? '0' : b.date));
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Spotlight events in Las Cruces',
    itemListElement: list.map((e, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/event/${e.slug}/`, name: e.title })) },
  breadcrumbJsonLd([{ name: 'Events', path: '/' }, { name: 'Spotlight events', path: '/spotlight/events/' }]),
];
---
<Layout title="Spotlight Events in Las Cruces, NM" description="The Las Cruces events worth clearing your calendar for: hand-picked shows, festivals and community events, plus the local folks who help keep this calendar free." jsonLd={jsonLd}>
  <section class="page-hero wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Events</a><span aria-hidden="true">›</span><span aria-current="page">Spotlight events</span></nav>
    <p class="eyebrow">Don't sleep on these</p>
    <h1>Spotlight events</h1>
    <p class="lede">Hand-picked Las Cruces events worth clearing your calendar for, plus the local folks who help keep this calendar free.</p>
    <p class="page-hero__count" data-count>{list.length} coming up</p>
  </section>
  <section class="wrap page-body">
    <ul class="grid" role="list" data-list hidden={!list.length}>
      {list.map((e, i) => <EventCard event={e} big eager={i < 3} />)}
    </ul>
    <div class="notice" data-empty hidden={list.length > 0}>Nothing in the Spotlight right now. <a href="/">See everything on the calendar</a>.</div>
    <div class="spotlight-promo">
      <div>
        <h2>Want your event here?</h2>
        <p>Spotlight puts it at the top of its day on the calendar, on this page and the homepage, and gets it a mention in the Live Love Las Cruces newsletter ({SITE.subscribers} locals) before the big day. ${SPOTLIGHT.price}.</p>
      </div>
      <a class="btn--primary" href="/spotlight/">Spotlight my event</a>
    </div>
  </section>
  <Newsletter />
</Layout>

<script>
  // Drop anything that has already happened since the last build (same rule as the homepage).
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Denver', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
  const list = document.querySelector<HTMLElement>('[data-list]');
  if (list) {
    list.querySelectorAll<HTMLElement>(':scope > li[data-date]').forEach((li) => {
      if ((li.dataset.date || '') < today && !li.hasAttribute('data-ongoing')) li.remove();
    });
    const left = list.querySelectorAll(':scope > li').length;
    const count = document.querySelector('[data-count]');
    if (count) count.textContent = `${left} coming up`;
    if (!left) { list.hidden = true; document.querySelector<HTMLElement>('[data-empty]')?.removeAttribute('hidden'); }
  }
</script>

<style>
  .page-hero { display: flex; flex-direction: column; gap: var(--space-s); padding-block: var(--space-l); }
  .page-hero h1 { margin-block-start: var(--space-s); }
  .page-hero__count { color: var(--text-dark-muted); font-weight: 600; }
  .page-body { padding-block-end: var(--space-xl); display: flex; flex-direction: column; gap: var(--space-l); }
  .page-body [hidden] { display: none; }
  .spotlight-promo { display: flex; flex-wrap: wrap; gap: var(--space-m) var(--space-l); align-items: center; justify-content: space-between; padding: var(--space-m); border: 1.5px dashed var(--neutral-light); border-radius: var(--radius); background: var(--bg-light); }
  .spotlight-promo > div { flex: 1 1 26.25rem; display: flex; flex-direction: column; gap: 0.375rem; }
  .spotlight-promo h2 { font-size: 1.35rem; }
  .spotlight-promo p { color: var(--text-dark-muted); max-inline-size: 60ch; }
</style>
