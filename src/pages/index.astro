---
import Layout from '../layouts/Layout.astro';
import Agenda from '../components/Agenda.astro';
import EventCard from '../components/EventCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE, CATEGORIES, SPOTLIGHT } from '../lib/site.js';
import { getEvents, shortVenue } from '../lib/events.js';
import { dateKey, todayWall, addDays, shortDate, weekendRange } from '../lib/time.js';

const { events: all, dated: events, ongoing, series } = await getEvents();
const today = todayWall();
const weekEnd = dateKey(addDays(today, 6));
const thisWeek = events.filter((e) => e.date <= weekEnd).length;
const { from, to } = weekendRange(today);
const weekend = events.filter((e) => e.date >= from && e.date <= to).length;

// Spotlight: only events Charlie marks (paid Spotlight packages and sponsor events). Each event once
// (its next date). The browser shows three at random on each visit, paid ones first (script below).
const picks = [...events, ...ongoing]
  .filter((e) => e.spotlight)
  .filter((e, i, a) => a.findIndex((x) => x.title === e.title) === i)
  .slice(0, 24);
const usedCats = Object.keys(CATEGORIES).filter((k) => all.some((e) => e.category === k));
// Weekly regulars: the truly weekly ones first, then the rest, by next date. 12 is plenty.
const regulars = [...series]
  .sort((a, b) => (b.when.startsWith('Every ') - a.when.startsWith('Every ')) || a.next.date.localeCompare(b.next.date))
  .slice(0, 12);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.tagline,
    publisher: { '@type': 'Organization', name: SITE.publisher, url: SITE.publisherUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Upcoming events in Las Cruces, NM',
    itemListElement: all.slice(0, 30).map((e, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/event/${e.slug}/`, name: e.title })),
  },
];
---
<Layout
  title={SITE.name}
  description="What's happening in Las Cruces, NM this week: live music, markets, art walks, family days and city events, hand-checked by a local and updated every morning."
  jsonLd={jsonLd}
>
  <section class="hero wrap">
    <div class="copy">
      <p class="eyebrow">Las Cruces + Mesilla, New Mexico</p>
      <h1>Skip the scroll. Here's what's actually happening in Las Cruces.</h1>
      <p class="lede">Live music, markets, art walks, Aggie games and the little stuff only locals hear about. One calendar, checked by a human who lives here.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/this-weekend/">What's on this weekend</a>
        <a class="btn btn-outline" href="/submit/">Add your event</a>
      </div>
    </div>
    <div class="hero-stats" aria-label="At a glance">
      <div><strong>{thisWeek}</strong><span>events in the next 7 days</span></div>
      <div><strong>{weekend}</strong><span>this weekend</span></div>
      <div><strong>Free</strong><span>to list, always</span></div>
    </div>
  </section>

  <section class="section section-white" data-spotlight-sec>
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Spotlight</h2>
          <p>Don't sleep on these. Hand-picked events and the local folks who help keep this calendar free.</p>
        </div>
      </div>
      {picks.length > 0 && (
        <ul class="grid" role="list" data-picks>
          {picks.map((e, i) => <EventCard event={e} big eager={i === 0} />)}
        </ul>
      )}
      <div class="promo" data-promo hidden={picks.length > 0}>
        <div>
          <h3>Your event could be right here.</h3>
          <p>Spotlight puts it at the top of its day on the calendar, rotates it through this section, and gets it a mention in the Live Love Las Cruces newsletter ({SITE.subscribers} locals) before the big day. ${SPOTLIGHT.price}.</p>
        </div>
        <a class="btn btn-primary" href="/submit/?spotlight=1">Spotlight my event</a>
      </div>
    </div>
  </section>

  <section class="section" id="calendar">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Everything coming up</h2>
          <p>Tap a day or a category to narrow it down. Regulars and city meetings are tucked into the short rows so the one-night-only stuff stands out.</p>
        </div>
      </div>
      <Agenda events={events} ongoing={ongoing} initialDays={7} />
    </div>
  </section>

  {ongoing.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2>On now, any day you like</h2>
            <p>Exhibits and long runs you can catch whenever it suits you. No rush, but don't sleep on them.</p>
          </div>
        </div>
        <ul class="grid" role="list">{ongoing.map((e) => <EventCard event={e} />)}</ul>
      </div>
    </section>
  )}

  {regulars.length > 0 && (
    <section class="section section-white">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2>Weekly regulars</h2>
            <p>The standing dates. Cheap, easy and a good way to meet your neighbors.</p>
          </div>
        </div>
        <ul class="grid-tight regulars" role="list">
          {regulars.map((s) => (
            <li><a class="reg" href={`/event/${s.next.slug}/`}>
              <span class="dot" style={`background:${CATEGORIES[s.category].color}`} aria-hidden="true"></span>
              <span>
                <h3>{s.title}</h3>
                <span class="reg-when">{s.when} · {s.time}</span>
                <span class="reg-where">{shortVenue(s.next)}</span>
                <span class="reg-next">Next: {shortDate(s.next.start)}</span>
              </span>
            </a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section" id="browse">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Browse by vibe</h2>
          <p>Every category has its own page, so you can bookmark the one you care about.</p>
        </div>
      </div>
      <ul class="grid-tight cats" role="list">
        {usedCats.map((k) => (
          <li><a class="cat" href={`/category/${k}/`} style={`--c:${CATEGORIES[k].color}`}>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={CATEGORIES[k].icon} />
            <span class="cat-name">{CATEGORIES[k].plural}</span>
            <span class="cat-n">{all.filter((e) => e.category === k).length} upcoming</span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <Newsletter />
</Layout>

<style>
  /* Three show; the script picks which. Without JavaScript, the first three. */
  [data-picks] > :global(li:nth-child(n+4)) { display: none; }
  [data-picks].shuffled > :global(li) { display: flex; }
  .promo { display: flex; flex-wrap: wrap; gap: 20px 32px; align-items: center; justify-content: space-between; padding: 28px; border: 1.5px dashed var(--line); border-radius: var(--ev-radius); background: var(--bg); }
  .promo > div { flex: 1 1 420px; display: flex; flex-direction: column; gap: 6px; }
  .promo h3 { font-size: 1.35rem; }
  .promo p { color: var(--muted); max-width: 60ch; }
  .hero { display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-end; padding-top: 56px; padding-bottom: 48px; }
  .copy { flex: 1 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .hero-stats { flex: 0 1 300px; display: grid; gap: 12px; }
  .hero-stats div { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 14px 18px; display: flex; align-items: baseline; gap: 12px; }
  .hero-stats strong { font-family: var(--display); font-size: 2rem; font-weight: 800; color: var(--ev-accent); }
  .hero-stats span { color: var(--muted); }

  .regulars li { display: flex; }
  .reg { flex: 1; display: flex; gap: 14px; align-items: flex-start; padding: 18px; background: var(--bg); border: 1px solid var(--line); border-radius: 16px; text-decoration: none; color: var(--ink); }
  .reg:hover { border-color: var(--ink); color: var(--ink); }
  .reg .dot { margin-top: 8px; }
  .reg > span:last-child { display: flex; flex-direction: column; gap: 2px; }
  .reg h3 { font-size: 1.15rem; }
  .reg-when { font-weight: 600; color: var(--agave); }
  .reg-where, .reg-next { color: var(--muted); font-size: .92rem; }

  .cats li { display: flex; }
  .cat { flex: 1; display: flex; flex-direction: column; gap: 4px; padding: 20px; border-radius: var(--ev-radius); background: var(--c); color: #fff; text-decoration: none; min-height: 140px; position: relative; overflow: hidden; }
  .cat:hover { color: #fff; filter: brightness(1.08); }
  .cat svg { width: 34px; height: 34px; margin-bottom: auto; }
  .cat-name { font-family: var(--display); font-weight: 800; font-size: 1.35rem; margin-top: 18px; }
  .cat-n { font-size: .9rem; opacity: .85; }
</style>

<script>
  // Spotlight: drop anything that has already happened, then show three at random,
  // paid (Sponsored) events first so they're never crowded out. Changes on every visit.
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Denver', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
  const list = document.querySelector('[data-picks]');
  const shuffle = (a) => { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
  if (list) {
    const items = [...list.querySelectorAll(':scope > li[data-date]')].filter((li) => {
      if (li.dataset.date < today && !li.hasAttribute('data-ongoing')) { li.remove(); return false; }
      return true;
    });
    const paid = shuffle(items.filter((li) => li.querySelector('.sponsored')));
    const free = shuffle(items.filter((li) => !li.querySelector('.sponsored')));
    const show = [...paid, ...free].slice(0, 3);
    items.forEach((li) => { if (!show.includes(li)) li.remove(); });
    show.forEach((li) => list.append(li));
    list.classList.add('shuffled');
    if (!show.length) { list.remove(); document.querySelector('[data-promo]')?.removeAttribute('hidden'); }
  }
</script>
