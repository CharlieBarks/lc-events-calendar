---
import Layout from '../../layouts/Layout.astro';
import Agenda from '../../components/Agenda.astro';
import { CATEGORY_DAYS } from '../../lib/site.js';
import EventCard from '../../components/EventCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { SITE, CATEGORIES, breadcrumbJsonLd } from '../../lib/site.js';
import { getEvents } from '../../lib/events.js';

export async function getStaticPaths() {
  const { events } = await getEvents();
  return Object.keys(CATEGORIES)
    .filter((k) => events.some((e) => e.category === k))
    .map((k) => ({ params: { slug: k } }));
}

const { slug } = Astro.params;
const cat = CATEGORIES[slug];
const { events, dated, ongoing } = await getEvents();
const list = dated.filter((e) => e.category === slug);
const onView = ongoing.filter((e) => e.category === slug);
const others = Object.keys(CATEGORIES).filter((k) => k !== slug && events.some((e) => e.category === k));
const path = `/category/${slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: cat.seo,
    itemListElement: [...onView, ...list].slice(0, 30).map((e, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/event/${e.slug}/`, name: e.title })),
  },
  breadcrumbJsonLd([{ name: 'Events', path: '/' }, { name: cat.plural, path }]),
];
---
<Layout title={cat.seo} description={`${cat.blurb} Every upcoming ${cat.plural.toLowerCase()} event in Las Cruces, NM, updated daily.`} jsonLd={jsonLd} ogImage={`/og/category/${slug}.png`}>
  <section class="category-head" style={`--c:${cat.color}`}>
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Events</a><span aria-hidden="true">›</span><span aria-current="page">{cat.plural}</span></nav>
      <div class="category-head__title">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={cat.icon} />
        <div>
          <h1>{cat.seo}</h1>
          <p class="lede">{cat.blurb}</p>
          <p class="category-head__count">{list.length} upcoming{onView.length > 0 && ` · ${onView.length} on view now`}</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      {onView.length > 0 && (
        <div class="category-onview">
          <h2>On view now</h2>
          <ul class="grid" role="list">{onView.map((e) => <EventCard event={e} />)}</ul>
        </div>
      )}
      {list.length > 0 && <Agenda events={list} headingLevel={2} initialDays={CATEGORY_DAYS} rest={`/more/${slug}/`} />}
      <div class="category-more">
        <span>More to explore:</span>
        <div class="chips">{others.map((k) => <a class="chip" href={`/category/${k}/`}><span class="dot" style={`background:${CATEGORIES[k].color};margin-right:8px`} aria-hidden="true"></span>{CATEGORIES[k].plural}</a>)}</div>
      </div>
    </div>
  </section>
  <Newsletter />
</Layout>
<style>
  .category-head { background: var(--c); color: var(--white); padding-block-end: var(--space-xl); }
  .category-head .breadcrumb, .category-head .breadcrumb a { color: rgba(255,255,255,.85); }
  .category-head__title { display: flex; gap: var(--space-m); align-items: flex-start; padding-block-start: var(--space-m); }
  .category-head__title svg { inline-size: 4rem; block-size: 4rem; flex: none; opacity: .9; margin-block-start: 0.375rem; }
  @media (max-width: 560px) { .category-head__title svg { display: none; } }
  .category-head__title div { display: flex; flex-direction: column; gap: var(--space-s); }
  .category-head .lede { color: rgba(255,255,255,.9); }
  .category-head__count { font-weight: 700; }
  .category-onview { margin-block-end: var(--space-l); display: flex; flex-direction: column; gap: var(--space-s); }
  .category-onview h2 { font-size: 1.6rem; }
  .category-more { display: flex; flex-direction: column; gap: var(--space-s); margin-block-start: var(--space-m); color: var(--text-dark-muted); font-weight: 600; }
</style>
