---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" description="That event may have already happened.">
  <section class="wrap" style="padding:80px 20px;display:flex;flex-direction:column;gap:18px;align-items:flex-start">
    <p class="eyebrow">404</p>
    <h1>That one already happened (or never existed).</h1>
    <p class="lede">Old event pages come down once the party's over. Here's what's next.</p>
    <div class="btn-row"><a class="btn--primary" href="/">See what's coming up</a><a class="btn--base btn--outline" href="/this-weekend/">This weekend</a></div>
  </section>
</Layout>
