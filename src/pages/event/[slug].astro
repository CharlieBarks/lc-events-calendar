---
import Layout from '../../layouts/Layout.astro';
import EventArt from '../../components/EventArt.astro';
import EventCard from '../../components/EventCard.astro';
import Lightbox from '../../components/Lightbox.astro';
import Newsletter from '../../components/Newsletter.astro';
import { SITE, CATEGORIES, SOURCES, PREVIEW, INTAKE_URL, TURNSTILE_SITEKEY, breadcrumbJsonLd, tagged } from '../../lib/site.js';
import { getEvents, shortVenue, mapsLink, googleCalendarLink } from '../../lib/events.js';
import { longDate, shortDate, timeRange, offsetIso, dateKey, todayWall } from '../../lib/time.js';

export async function getStaticPaths() {
  const { allEvents: events, aliases } = await getEvents();
  return [
    ...events.map((event) => ({ params: { slug: event.slug }, props: { event } })),
    // Dateless addresses of long runs in their last days: forward to the next date.
    ...aliases.map((a) => ({ params: { slug: a.slug }, props: { forwardTo: `/event/${a.to}/` } })),
  ];
}

if (Astro.props.forwardTo) return Astro.redirect(Astro.props.forwardTo);

const { event } = Astro.props;
const { allEvents: events } = await getEvents();
const cat = CATEGORIES[event.category];
const known = SOURCES[event.source] || SOURCES.lllc;
// Events found through Visit Las Cruces are credited to the organizer, linked to their own page.
const source = known.url ? known : { name: event.venue || 'the organizer', url: event.url };
const path = `/event/${event.slug}/`;
// An exhibit (Nov 25, 2026) says its open days and hours, not one date: the page stands for the whole run.
const exhibit = !!(event.ongoing && event.series?.exhibit);
const when = exhibit && event.series.hours ? event.series.hours : `${longDate(event.start)} · ${timeRange(event.start, event.end)}`;
// Open days we couldn't read ("Open during events only"): no "Next open" date.
const nextOpen = exhibit && !(event.rule?.hoursNote && !event.rule?.hours) ? ` · Next open ${shortDate(event.start)}` : '';

// Plain-text descriptions from feeds: split into paragraphs, never inject raw HTML.
const paragraphs = event.description.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

const otherDates = event.series ? event.series.dates.filter((e) => e.slug !== event.slug).slice(0, 6) : [];
// "You might also like": soonest events that share the venue or category, one-offs with a picture
// first. Each event once (its next date), never this event's own series.
const soonKey = (n) => { const d = new Date(Date.UTC(event.start.y, event.start.m - 1, event.start.d + n)); return d.toISOString().slice(0, 10); };
const horizon = soonKey(21);
const score = (e) => (e.venueKey && e.venueKey === event.venueKey ? 3 : 0) + (e.category === event.category ? 2 : 0)
  + (e.compact ? 0 : 1) + (e.image ? 1 : 0) + (e.sponsored ? 1 : 0);
const related = events
  .filter((e) => e.slug !== event.slug && e.title !== event.title && (!event.series || e.series !== event.series) && e.date <= horizon)
  .filter((e, i, a) => a.findIndex((x) => x.title === e.title) === i)
  .map((e) => ({ e, s: score(e) }))
  .filter((x) => x.s >= 2)
  .sort((a, b) => b.s - a.s || a.e.date.localeCompare(b.e.date))
  .slice(0, 4)
  .map((x) => x.e);
const venueCount = events.filter((e) => e.venueKey && e.venueKey === event.venueKey).length;

const isFree = /free/i.test(event.price) || /\$0\b/.test(event.description);
const description = event.description
  ? `${shortDate(event.start)} at ${shortVenue(event)}. ${event.description}`
  : `${event.title}: ${shortDate(event.start)}, ${timeRange(event.start, event.end)} at ${shortVenue(event)} in Las Cruces, NM.`;

// What the form needs to open this listing for "Suggest an edit" (read by /submit/?suggest=<slug>).
const hhmm = (w) => (w && !w.allDay ? `${String(w.H).padStart(2, '0')}:${String(w.M).padStart(2, '0')}` : '');
const suggestData = {
  title: event.title, venue: [event.venue, event.room].filter(Boolean).join(' > '), address: event.address, category: event.category, price: event.price,
  url: event.url, description: event.description, image: event.image,
  date: event.date, start: hhmm(event.start), end: event.end && dateKey(event.end) === event.date ? hhmm(event.end) : '',
};

// Google's event details (Search Console "Improve item appearance", Nov 25, 2026):
// - endDate: all-day events use plain dates; an event with no end time ends that same day
//   (a plain date, so we never make up a time).
// - offers: free events get price 0, events with a dollar price get it (a range becomes
//   low/high), anything else gets no offers rather than a guess. validFrom is the build day,
//   meaning "available now"; it's never later than the event.
// - performer: only real ones: acts matched on Las Cruces Live, artists on the Art Trail.
const isoDay = (w) => (w.allDay ? dateKey(w) : offsetIso(w));
// An exhibit's page stands for the whole run: its first and last days (plain dates).
const startIso = exhibit && event.rule?.start ? event.rule.start : isoDay(event.start);
const endIso = exhibit && event.rule?.until ? event.rule.until : event.end ? isoDay(event.end) : dateKey(event.start);
const dollars = [...String(event.price || '').matchAll(/\$\s*(\d+(?:\.\d{1,2})?)/g)].map((m) => Number(m[1]));
const today = dateKey(todayWall());
const validFrom = today < event.date ? today : event.date;
const offerBase = { '@type': 'Offer', priceCurrency: 'USD', availability: 'https://schema.org/InStock', validFrom, url: event.url || `${SITE.url}${path}` };
const paidToo = dollars.filter((n) => n > 0);
const offers = isFree && paidToo.length
  ? { ...offerBase, '@type': 'AggregateOffer', lowPrice: 0, highPrice: Math.max(...paidToo) } // "Free – $10"
  : isFree ? { ...offerBase, price: 0 }
  : dollars.length === 1 ? { ...offerBase, price: dollars[0] }
  : dollars.length > 1 ? { ...offerBase, '@type': 'AggregateOffer', lowPrice: Math.min(...dollars), highPrice: Math.max(...dollars) }
  : null;
const performers = [
  ...(event.acts || []).map((a) => ({ '@type': 'MusicGroup', name: a.name, url: a.url })),
  ...(event.artists || []).map((a) => ({ '@type': 'Person', name: a.name, ...(a.url ? { url: a.url } : {}) })),
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: event.title,
    startDate: startIso,
    endDate: endIso,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: event.venue || 'Las Cruces, NM',
      address: { '@type': 'PostalAddress', streetAddress: event.address || event.venue, addressLocality: 'Las Cruces', addressRegion: 'NM', addressCountry: 'US' },
    },
    description: event.description || description,
    image: [event.image || `${SITE.url}/og/event/${event.slug}.png`],
    url: `${SITE.url}${path}`,
    organizer: { '@type': 'Organization', name: source.name, url: event.url || source.url },
    ...(isFree ? { isAccessibleForFree: true } : {}),
    ...(offers ? { offers } : {}),
    ...(performers.length ? { performer: performers.length === 1 ? performers[0] : performers } : {}),
  },
  breadcrumbJsonLd([
    { name: 'Events', path: '/' },
    { name: cat.plural, path: `/category/${event.category}/` },
    { name: event.title, path },
  ]),
];
// The main picture on this page: the flyer when the organizer also sent a photo, otherwise the
// event's picture. Always beside the details (Charlie, Nov 18: wide flyers too; tap to enlarge).
// Alt text (Charlie, Nov 24): say what the picture is, which event, where and when, so screen
// readers and image search get real context. "Flyer for Salsa Night at The Bike Shop, Dec 5".
const altWhere = event.venue ? ` at ${event.venue}` : '';
const altWhen = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })
  .format(new Date(Date.UTC(event.start.y, event.start.m - 1, event.start.d)));
const altAbout = `${event.title}${altWhere}, ${altWhen}`;
const mainAlt = event.flyer ? `Flyer for ${altAbout}` : `Photo for ${altAbout}`;
const photoAlt = `Photo for ${altAbout}`;
// Admin bar (Charlie only, switched on per device with ?admin=on): shortcuts to the review page with
// this event filled in. The review page stays behind the Cloudflare Access login and asks him to
// confirm, so the bar can't change anything by itself.
const repeats = !!(event.series || event.rule || event.seriesKey);
const fromForm = event.source === 'lllc';
const adminLink = (act) => `${INTAKE_URL}/review/?act=${act}&slug=${encodeURIComponent(event.slug)}&title=${encodeURIComponent(event.title)}`;
const status = event.sponsored ? 'Sponsored (paid)' : event.featured ? 'Featured' : '';
const mainImage = event.flyer || event.image;
const mainThumb = event.flyer ? event.flyerThumbs?.l : event.thumbs?.l;
---
<Layout title={`${event.title}, ${shortDate(event.start)}`} description={description} jsonLd={jsonLd} ogType="article" ogImage={event.image || `/og/event/${event.slug}.png`}>
  <aside class="admin-bar" data-admin-bar hidden aria-label="Admin">
    <div class="wrap admin-bar__inner">
      <p class="admin-bar__title">Admin{status && <span class="admin-bar__status">{status}{event.spotlightUntil && ` until ${event.spotlightUntil}`}</span>}</p>
      {repeats && <label class="admin-bar__all"><input type="checkbox" data-admin-all /> Every date</label>}
      <div class="admin-bar__actions">
        {event.featured || event.sponsored
          ? <a class="btn--base btn--s" href={adminLink('unfeature')} data-admin-act target="_blank" rel="noopener">Stop featuring</a>
          : <a class="btn--base btn--s" href={adminLink('feature')} data-admin-act target="_blank" rel="noopener">★ Feature</a>}
        {!event.sponsored && <a class="btn--base btn--outline btn--s" href={adminLink('sponsor')} data-admin-act target="_blank" rel="noopener">Sponsored (paid)</a>}
        {fromForm
          ? <a class="btn--base btn--outline btn--s" href={adminLink('edit')} data-admin-act target="_blank" rel="noopener">Edit or remove</a>
          : <>
              <a class="btn--base btn--outline btn--s" href={adminLink('adopt')} data-admin-act target="_blank" rel="noopener">Edit</a>
              <a class="btn--base btn--outline btn--s" href={adminLink('hide')} data-admin-act target="_blank" rel="noopener">Hide listing</a>
            </>}
        {(event.image || event.flyer) && <a class="btn--base btn--outline btn--s" href={adminLink('nopic')} data-admin-act target="_blank" rel="noopener">Hide picture</a>}
        <a class="btn--base btn--outline btn--s" href={`${INTAKE_URL}/review/`} target="_blank" rel="noopener">Review page</a>
      </div>
    </div>
  </aside>

  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Events</a><span aria-hidden="true">›</span>
      <a href={`/category/${event.category}/`}>{cat.plural}</a><span aria-hidden="true">›</span>
      <span aria-current="page">{event.title}</span>
    </nav>
  </div>

  <article class="wrap event-detail">
    <div class="event-detail__media">
      {mainImage
        ? <a href={mainImage} data-lightbox={mainImage} data-alt={mainAlt} class="event-detail__flyer"><img src={mainThumb || mainImage} alt={mainAlt} /><span class="event-detail__zoom">Tap to enlarge</span></a>
        : <div class="event-detail__art"><EventArt event={event} height={340} eager /></div>}
      {event.flyer && event.image && <a href={event.image} data-lightbox={event.image} data-alt={photoAlt} class="event-detail__flyer event-detail__photo"><img src={event.thumbs?.l || event.image} alt={photoAlt} loading="lazy" /><span class="event-detail__zoom">Tap to enlarge</span></a>}
      {event.photos?.length > 0 && (
        <ul class="event-detail__gallery" role="list">
          {event.photos.map((u, i) => <li><a href={u} data-lightbox={u} data-alt={`${photoAlt} (${i + 2})`}><img src={event.photoThumbs?.[i]?.m || u} alt={`${photoAlt} (${i + 2})`} loading="lazy" /></a></li>)}
        </ul>
      )}
    </div>

    <div class="event-detail__info">
      <p class="eyebrow">{cat.name}{event.sponsored && <> <span class="event-detail__sponsored">Sponsored</span></>}{event.featured && !event.sponsored && <> <span class="event-detail__featured"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>Featured</span></>}{PREVIEW && event.sample && <> <span class="sample-tag">Sample</span></>}</p>
      <h1>{event.title}</h1>

      <dl class="event-facts">
        <div><dt>When</dt><dd><time datetime={offsetIso(event.start)}>{when}</time>{event.series && <span class="event-facts__sub">{exhibit ? `${event.series.when}${nextOpen}` : `${event.series.when} · ${event.series.time}`}</span>}</dd></div>
        <div><dt>Where</dt><dd>{event.venueKey && event.venue && venueCount > 0 ? <a href={`/venue/${event.venueKey}/`}>{shortVenue(event)}</a> : shortVenue(event)}{event.address && event.address !== event.venue && <span class="event-facts__sub">{event.address}</span>}</dd></div>
        {event.price && <div><dt>Cost</dt><dd>{event.price}</dd></div>}
        {event.acts && (
          <div><dt>Who</dt><dd>{event.acts.map((a) => (
            <span class="event-facts__act"><a href={a.url}>{a.name}</a>{a.genres.length > 0 && <span class="event-facts__sub">{a.genres.join(', ')}</span>}</span>
          ))}</dd></div>
        )}
      </dl>

      {(event.liveVenueUrl || event.artVenueUrl || event.artists) && (
        <ul class="event-sisters">
          {event.acts?.map((a) => <li><a href={a.url}>Meet {a.name} on Las Cruces Live</a></li>)}
          {event.liveVenueUrl && <li><a href={event.liveVenueUrl}>{shortVenue(event)} on Las Cruces Live</a></li>}
          {event.artVenueUrl && <li><a href={event.artVenueUrl}>{shortVenue(event)} on the Las Cruces Art Trail</a></li>}
          {event.artists?.map((a) => <li><a href={a.url}>Meet {a.name} on the Las Cruces Art Trail</a></li>)}
        </ul>
      )}

      <div class="event-actions">
        {event.ticketUrl
          ? <a class="btn--primary" href={tagged(event.ticketUrl)} rel="noopener">Get tickets</a>
          : event.url && <a class="btn--primary" href={tagged(event.url)} rel="noopener">{/ticket/i.test(event.url) ? 'Get tickets' : 'Event details'}</a>}
        <details class="event-actions__calendar">
          <summary class="btn--base btn--outline">Add to calendar</summary>
          <div class="event-actions__menu">
            <a href={googleCalendarLink(event, { offsetIso })} rel="noopener">Google Calendar</a>
            <a href={`/event/${event.slug}.ics`} download>Apple / Outlook (.ics)</a>
          </div>
        </details>
        {event.venue && <a class="btn--base btn--outline" href={mapsLink(event)} rel="noopener">Directions</a>}
        <button class="btn--base btn--outline" type="button" data-share data-title={event.title}>Share</button>
      </div>

      {paragraphs.length > 0 && (
        <div class="prose event-detail__description">{paragraphs.map((p) => <p>{p.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>)}</div>
      )}

      <p class="event-detail__source">Listed by <a href={tagged(source.url)}>{source.name}</a>{event.url && event.source !== 'lllc' && source.url !== event.url && <> · <a href={tagged(event.url)} rel="noopener">{event.source === 'cityspark' ? 'more from the organizer' : 'see the original listing'}</a></>}. Plans change, so double-check before you head out.</p>

      {/* "Something wrong with this listing?" (Nov 24, 2026, Charlie: visitors get a comment box, not
          the whole edit form). Sent to the lc-events-intake Worker (/report); it waits under Reports on
          the review page. Organizers can still open the full form ("This is my event"), reviewed as before. */}
      <details class="report" data-report data-intake={INTAKE_URL} data-sitekey={TURNSTILE_SITEKEY} data-slug={event.slug} data-title={event.title}>
        <summary class="report__toggle">Something wrong with this listing?</summary>
        <form class="report__form" novalidate>
          <p class="report__intro">Tell us and we'll fix it. Thanks for helping keep the calendar right.</p>
          <fieldset class="report__reasons">
            <legend class="sr-only">What's wrong?</legend>
            <label><input type="radio" name="reason" value="happened" /> Already happened</label>
            <label><input type="radio" name="reason" value="canceled" /> Canceled</label>
            <label><input type="radio" name="reason" value="time" /> Wrong date or time</label>
            <label><input type="radio" name="reason" value="place" /> Wrong place</label>
            <label><input type="radio" name="reason" value="other" /> Something else</label>
          </fieldset>
          <label class="report__field">What should it say? <span>(optional)</span>
            <textarea name="comment" rows="3" maxlength="1000" placeholder="It moved to Saturday at 9 AM"></textarea>
          </label>
          <div class="report__row">
            <label class="report__field">Your first name<input name="name" autocomplete="given-name" maxlength="60" required /></label>
            <label class="report__field">Your email<input name="email" type="email" autocomplete="email" maxlength="160" required /></label>
          </div>
          <input class="report__hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div data-human></div>
          <div class="report__send">
            <button class="btn--primary" type="submit">Send</button>
            <a class="report__mine" href={`/submit/?suggest=${event.slug}`} rel="nofollow">This is my event, I want to update it</a>
          </div>
          <p class="report__status" data-status role="status"></p>
        </form>
      </details>
      <script type="application/json" id="event-data" set:html={JSON.stringify(suggestData).replace(/</g, '\\u003c')} />
      <script type="application/json" id="event-data" set:html={JSON.stringify(suggestData).replace(/</g, '\\u003c')} />

      {!event.sponsored && (
        <p class="event-detail__promote">Is this your event? <a href={`/spotlight/?event=${event.slug}&title=${encodeURIComponent(event.title)}&date=${encodeURIComponent(shortDate(event.start))}`}>Spotlight it</a> to pin it to the top of the calendar and get it in the newsletter.</p>
      )}

      {otherDates.length > 0 && (
        <section class="event-also" aria-labelledby="also-h">
          <h2 id="also-h">Also on</h2>
          <ul role="list">
            {otherDates.map((e) => <li><a class="chip" href={`/event/${e.slug}/`}>{shortDate(e.start)}</a></li>)}
          </ul>
        </section>
      )}
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section-white">
      <div class="wrap">
        <div class="section-head">
          <h2>You might also like</h2>
          <div class="event-also__more">
            {venueCount > 1 && event.venueKey && <a href={`/venue/${event.venueKey}/`}>More at {event.venue} →</a>}
            <a href={`/category/${event.category}/`}>More {cat.plural.toLowerCase()} →</a>
          </div>
        </div>
        <ul class="grid" role="list">{related.map((e) => <EventCard event={e} />)}</ul>
      </div>
    </section>
  )}

  <Newsletter />
  <Lightbox />
</Layout>

<script>
  // Admin bar: only on devices where Charlie turned it on (?admin=on, see Layout.astro).
  try {
    const bar = document.querySelector('[data-admin-bar]');
    if (bar && localStorage.getItem('lc-admin') === '1') {
      bar.hidden = false;
      const all = bar.querySelector('[data-admin-all]');
      bar.querySelectorAll('[data-admin-act]').forEach((a) => a.addEventListener('click', () => {
        const u = new URL(a.href);
        if (all?.checked) u.searchParams.set('all', '1'); else u.searchParams.delete('all');
        a.href = u.toString();
      }));
    }
  } catch {}
  // "Something wrong with this listing?": the person check loads only when the box is opened.
  const report = document.querySelector<HTMLDetailsElement>('[data-report]');
  if (report) {
    const form = report.querySelector('form') as HTMLFormElement;
    const status = report.querySelector('[data-status]') as HTMLElement;
    const { intake, sitekey, slug, title } = report.dataset;
    let ready: Promise<void> | undefined;
    let widget: string | undefined;
    let done: (t: string) => void = () => {};
    const load = () => {
      if (!sitekey) return Promise.resolve();
      ready ??= new Promise<void>((resolve, reject) => {
        (window as any).__reportCheckReady = () => resolve();
        const s = document.createElement('script');
        s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__reportCheckReady';
        s.async = true;
        s.onerror = () => reject(new Error('blocked'));
        document.head.append(s);
      });
      return ready;
    };
    const token = async (): Promise<string> => {
      if (!sitekey) return '';
      try {
        await load();
        const ts = (window as any).turnstile;
        return await new Promise<string>((resolve) => {
          done = resolve;
          setTimeout(() => resolve(''), 30000);
          if (widget === undefined) {
            widget = ts.render(report.querySelector('[data-human]'), {
              sitekey, appearance: 'interaction-only',
              callback: (t: string) => done(t), 'error-callback': () => done(''), 'timeout-callback': () => done(''),
            });
          } else ts.reset(widget);
        });
      } catch { return ''; }
    };
    report.addEventListener('toggle', () => { if (report.open) load().catch(() => {}); });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const reason = String(f.get('reason') || '');
      const comment = String(f.get('comment') || '').trim();
      const name = String(f.get('name') || '').trim();
      const email = String(f.get('email') || '').trim();
      const missing = [
        !reason && "what's wrong",
        reason === 'other' && !comment && 'a few words about it',
        !name && 'your first name',
        !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) && 'your email',
      ].filter(Boolean);
      if (missing.length) { status.textContent = `Please add ${missing.join(', ')}.`; status.dataset.tone = 'error'; return; }
      const button = form.querySelector('button') as HTMLButtonElement;
      button.disabled = true;
      status.dataset.tone = '';
      status.textContent = 'Sending…';
      try {
        const res = await fetch(`${intake}/report`, {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ slug, title, reason, comment, name, email, website: f.get('website'), human: await token() }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'Something went wrong. Try again in a minute.');
        form.innerHTML = `<p class="report__thanks">Thanks, ${name.replace(/[<>&"]/g, '')}! We'll take a look.</p>`;
      } catch (err) {
        status.textContent = (err as Error).message;
        status.dataset.tone = 'error';
        button.disabled = false;
      }
    });
  }
  document.querySelectorAll('[data-share]').forEach((b) => {
    b.addEventListener('click', async () => {
      const data = { title: b.dataset.title, url: location.href };
      if (navigator.share) { try { await navigator.share(data); } catch {} return; }
      await navigator.clipboard?.writeText(location.href);
      b.textContent = 'Link copied';
      setTimeout(() => (b.textContent = 'Share'), 2000);
    });
  });
</script>

<style>
  /* Admin bar (Charlie only). Quiet strip above the breadcrumb; wraps onto two lines on phones. */
  .admin-bar { background: var(--bg-ultra-light); border-block-end: 1px solid var(--neutral-light); padding-block: var(--space-xs); }
  .admin-bar[hidden] { display: none; }
  .admin-bar__inner { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-s); }
  .admin-bar__title { margin: 0; font-size: var(--text-s); font-weight: 700; display: flex; align-items: center; gap: var(--space-xs); }
