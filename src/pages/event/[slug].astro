---
import Layout from '../../layouts/Layout.astro';
import EventArt from '../../components/EventArt.astro';
import EventCard from '../../components/EventCard.astro';
import Lightbox from '../../components/Lightbox.astro';
import Newsletter from '../../components/Newsletter.astro';
import { SITE, CATEGORIES, SOURCES, PREVIEW, breadcrumbJsonLd } from '../../lib/site.js';
import { getEvents, shortVenue, mapsLink, googleCalendarLink } from '../../lib/events.js';
import { longDate, shortDate, timeRange, offsetIso } from '../../lib/time.js';

export async function getStaticPaths() {
  const { events, aliases } = await getEvents();
  return [
    ...events.map((event) => ({ params: { slug: event.slug }, props: { event } })),
    // Dateless addresses of long runs in their last days: forward to the next date.
    ...aliases.map((a) => ({ params: { slug: a.slug }, props: { forwardTo: `/event/${a.to}/` } })),
  ];
}

if (Astro.props.forwardTo) return Astro.redirect(Astro.props.forwardTo);

const { event } = Astro.props;
const { events } = await getEvents();
const cat = CATEGORIES[event.category];
const source = SOURCES[event.source];
const path = `/event/${event.slug}/`;
const when = `${longDate(event.start)} · ${timeRange(event.start, event.end)}`;

// Plain-text descriptions from feeds: split into paragraphs, never inject raw HTML.
const paragraphs = event.description.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

const otherDates = event.series ? event.series.dates.filter((e) => e.slug !== event.slug).slice(0, 6) : [];
// "You might also like": soonest events that share the venue or category, one-offs with a picture
// first. Each event once (its next date), never this event's own series.
const soonKey = (n) => { const d = new Date(Date.UTC(event.start.y, event.start.m - 1, event.start.d + n)); return d.toISOString().slice(0, 10); };
const horizon = soonKey(21);
const score = (e) => (e.venueKey && e.venueKey === event.venueKey ? 3 : 0) + (e.category === event.category ? 2 : 0)
  + (e.compact ? 0 : 1) + (e.image ? 1 : 0) + (e.sponsored ? 1 : 0);
const related = events
  .filter((e) => e.slug !== event.slug && e.title !== event.title && (!event.series || e.series !== event.series) && e.date <= horizon)
  .filter((e, i, a) => a.findIndex((x) => x.title === e.title) === i)
  .map((e) => ({ e, s: score(e) }))
  .filter((x) => x.s >= 2)
  .sort((a, b) => b.s - a.s || a.e.date.localeCompare(b.e.date))
  .slice(0, 4)
  .map((x) => x.e);
const venueCount = events.filter((e) => e.venueKey && e.venueKey === event.venueKey).length;

const isFree = /free/i.test(event.price) || /\$0\b/.test(event.description);
const description = event.description
  ? `${shortDate(event.start)} at ${shortVenue(event)}. ${event.description}`
  : `${event.title}: ${shortDate(event.start)}, ${timeRange(event.start, event.end)} at ${shortVenue(event)} in Las Cruces, NM.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: event.title,
    startDate: offsetIso(event.start),
    ...(event.end ? { endDate: offsetIso(event.end) } : {}),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: event.venue || 'Las Cruces, NM',
      address: { '@type': 'PostalAddress', streetAddress: event.address || event.venue, addressLocality: 'Las Cruces', addressRegion: 'NM', addressCountry: 'US' },
    },
    description: event.description || description,
    image: [event.image || `${SITE.url}/og/event/${event.slug}.png`],
    url: `${SITE.url}${path}`,
    organizer: { '@type': 'Organization', name: source.name, url: event.url || source.url },
    ...(isFree ? { isAccessibleForFree: true, offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: event.url || `${SITE.url}${path}` } } : {}),
  },
  breadcrumbJsonLd([
    { name: 'Events', path: '/' },
    { name: cat.plural, path: `/category/${event.category}/` },
    { name: event.title, path },
  ]),
];
---
<Layout title={`${event.title}, ${shortDate(event.start)}`} description={description} jsonLd={jsonLd} ogType="article" ogImage={event.image || `/og/event/${event.slug}.png`}>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Events</a><span aria-hidden="true">›</span>
      <a href={`/category/${event.category}/`}>{cat.plural}</a><span aria-hidden="true">›</span>
      <span aria-current="page">{event.title}</span>
    </nav>
  </div>

  <article class="wrap event-detail">
    <div class="event-detail__media">
      {event.image
        ? <a href={event.image} data-lightbox={event.image} data-alt={`${event.title} flyer`} class="event-detail__flyer"><img src={event.thumbs?.l || event.image} alt={`${event.title} flyer`} /><span class="event-detail__zoom">Tap to enlarge</span></a>
        : <div class="event-detail__art"><EventArt event={event} height={340} eager /></div>}
    </div>

    <div class="event-detail__info">
      <p class="eyebrow">{cat.name}{event.sponsored && <> <span class="event-detail__sponsored">Sponsored</span></>}{PREVIEW && event.sample && <> <span class="sample-tag">Sample</span></>}</p>
      <h1>{event.title}</h1>

      <dl class="event-facts">
        <div><dt>When</dt><dd><time datetime={offsetIso(event.start)}>{when}</time>{event.series && <span class="event-facts__sub">{event.series.when} · {event.series.time}</span>}</dd></div>
        <div><dt>Where</dt><dd>{shortVenue(event)}{event.address && event.address !== event.venue && <span class="event-facts__sub">{event.address}</span>}</dd></div>
        {event.price && <div><dt>Cost</dt><dd>{event.price}</dd></div>}
      </dl>

      <div class="event-actions">
        {event.ticketUrl
          ? <a class="btn--primary" href={event.ticketUrl} rel="noopener">Get tickets</a>
          : event.url && <a class="btn--primary" href={event.url} rel="noopener">{/ticket/i.test(event.url) ? 'Get tickets' : 'Event details'}</a>}
        <details class="event-actions__calendar">
          <summary class="btn--base btn--outline">Add to calendar</summary>
          <div class="event-actions__menu">
            <a href={googleCalendarLink(event, { offsetIso })} rel="noopener">Google Calendar</a>
            <a href={`/event/${event.slug}.ics`} download>Apple / Outlook (.ics)</a>
          </div>
        </details>
        {event.venue && <a class="btn--base btn--outline" href={mapsLink(event)} rel="noopener">Directions</a>}
        <button class="btn--base btn--outline" type="button" data-share data-title={event.title}>Share</button>
      </div>

      {paragraphs.length > 0 && (
        <div class="prose event-detail__description">{paragraphs.map((p) => <p>{p.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>)}</div>
      )}

      <p class="event-detail__source">Listed by <a href={source.url}>{source.name}</a>{event.url && event.source !== 'lllc' && <> · <a href={event.url} rel="noopener">{event.source === 'cityspark' ? 'more from the organizer' : 'see the original listing'}</a></>}. Plans change, so double-check before you head out.</p>

      {!event.sponsored && (
        <p class="event-detail__promote">Is this your event? <a href="/submit/?spotlight=1">Spotlight it</a> to pin it to the top of the calendar and get it in the newsletter.</p>
      )}

      {otherDates.length > 0 && (
        <section class="event-also" aria-labelledby="also-h">
          <h2 id="also-h">Also on</h2>
          <ul role="list">
            {otherDates.map((e) => <li><a class="chip" href={`/event/${e.slug}/`}>{shortDate(e.start)}</a></li>)}
          </ul>
        </section>
      )}
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section-white">
      <div class="wrap">
        <div class="section-head">
          <h2>You might also like</h2>
          <div class="event-also__more">
            {venueCount > 1 && event.venueKey && <a href={`/?venue=${event.venueKey}#calendar`}>More at {event.venue} →</a>}
            <a href={`/category/${event.category}/`}>More {cat.plural.toLowerCase()} →</a>
          </div>
        </div>
        <ul class="grid" role="list">{related.map((e) => <EventCard event={e} />)}</ul>
      </div>
    </section>
  )}

  <Newsletter />
  <Lightbox />
</Layout>

<script>
  document.querySelectorAll('[data-share]').forEach((b) => {
    b.addEventListener('click', async () => {
      const data = { title: b.dataset.title, url: location.href };
      if (navigator.share) { try { await navigator.share(data); } catch {} return; }
      await navigator.clipboard?.writeText(location.href);
      b.textContent = 'Link copied';
      setTimeout(() => (b.textContent = 'Share'), 2000);
    });
  });
</script>

<style>
  .event-detail { display: grid; gap: var(--space-l); grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); padding-block-start: var(--space-m); padding-block-end: var(--space-xl); align-items: start; }
  @media (max-width: 860px) { .event-detail { grid-template-columns: 1fr; gap: 24px; } }
  .event-detail__media { position: sticky; top: 1.25rem; }
  @media (max-width: 860px) { .event-detail__media { position: static; } }
  .event-detail__art { border-radius: var(--radius); overflow: hidden; }
  .event-detail__flyer { display: block; position: relative; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--neutral-light); background: var(--bg-ultra-light); }
  .event-detail__flyer img { inline-size: 100%; max-block-size: 40rem; object-fit: contain; }
  .event-detail__zoom { position: absolute; right: 0.75rem; bottom: 0.75rem; background: rgba(28,27,26,.8); color: var(--white); font-size: var(--text-xs); padding: 0.375rem var(--space-s); border-radius: 999px; }
  .event-detail__info { display: flex; flex-direction: column; gap: var(--space-m); }
  .event-detail__info h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  .event-facts { margin: 0; display: grid; gap: var(--space-s); padding: var(--space-m); background: var(--bg-ultra-light); border: 1px solid var(--neutral-light); border-radius: var(--radius-s); }
  .event-facts div { display: grid; grid-template-columns: 4.375rem 1fr; gap: var(--space-s); }
  .event-facts dt { font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--text-dark-muted); padding-block-start: 0.1875rem; }
  .event-facts dd { margin: 0; font-weight: 600; display: flex; flex-direction: column; }
  .event-facts__sub { font-weight: 400; color: var(--text-dark-muted); font-size: var(--text-m); }
  .event-actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  /* White fill at rest. Set through ACSS's own button variable so the hover fill still applies
     (a plain `background` here kept the button white on hover, under near-white hover text). */
  .event-actions .btn--outline { --btn-background: var(--bg-ultra-light); }
  .event-actions__calendar { position: relative; }
  .event-actions__calendar summary { list-style: none; }
  .event-actions__calendar summary::-webkit-details-marker { display: none; }
  .event-actions__menu { position: absolute; z-index: 10; top: calc(100% + 0.375rem); left: 0; min-inline-size: 13.75rem; background: var(--bg-ultra-light); border: 1px solid var(--neutral-light); border-radius: var(--radius-s); box-shadow: 0 12px 30px rgba(0,0,0,.12); padding: 0.375rem; display: flex; flex-direction: column; }
  .event-actions__menu a { padding: var(--space-s) var(--space-s); border-radius: var(--radius-xs); color: var(--text-dark); text-decoration: none; font-weight: 500; }
  .event-actions__menu a:hover { background: var(--bg-light); }
  .event-detail__description { color: var(--neutral-dark); }
  .event-detail__source { font-size: var(--text-s); color: var(--text-dark-muted); border-block-start: 1px solid var(--neutral-ultra-light); padding-block-start: var(--space-s); }
  .event-detail__source a { color: var(--text-dark-muted); }
  .event-detail__promote { font-size: var(--text-s); color: var(--text-dark-muted); }
  .event-detail__promote a { color: var(--primary); font-weight: 600; }
  .event-detail__sponsored { --_sponsored-bg: #FFF4D6; --_sponsored-text: #6B4E00; font-size: var(--text-xs); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 0.1875rem var(--space-xs); border-radius: 999px; background: var(--_sponsored-bg); color: var(--_sponsored-text); vertical-align: 2px; }
  .event-also__more { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-m); }
  .event-also h2 { font-size: var(--text-xl); font-family: var(--text-font-family); font-weight: 700; letter-spacing: 0; margin-block-end: var(--space-xs); }
  .event-also ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-xs); }
</style>
