---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '../styles/reset.css';
import '../styles/acss/automatic.css';
import '../styles/acss-bridge.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import { SITE, PREVIEW, ANALYTICS_TOKEN } from '../lib/site.js';

// ogImage: path to this page's share image, e.g. /og/event/first-friday-ramble.png
// ogImage may also be a full URL (an event's own flyer); then the 1200x630 size tags are left off.
const { title, description, jsonLd = [], ogType = 'website', ogImage: ogImagePath = '/og/default.png' } = Astro.props;
const generated = !/^https?:/.test(ogImagePath);
// Google shows roughly 155 characters, so trim longer descriptions on a word boundary.
function trimDescription(text = '', max = 155) {
  const clean = text.replace(/\s+/g, ' ').trim();
  if (clean.length <= max) return clean;
  const cut = clean.slice(0, max - 1);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[\s,;:.–—-]+$/, '') + '…';
}
const metaDescription = trimDescription(description);
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title === SITE.name ? `Things to Do in Las Cruces, NM | ${SITE.name}` : `${title} | ${SITE.name}`;
const ogImage = new URL(ogImagePath, SITE.url).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {PREVIEW && <meta name="robots" content="noindex, nofollow" />}
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="text/calendar" title="Las Cruces Events (calendar feed)" href="/calendar.ics" />
  <meta name="theme-color" content="#FAF9F5" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={`${SITE.name} by ${SITE.publisher}`} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {generated && <meta property="og:image:width" content="1200" />}
  {generated && <meta property="og:image:height" content="630" />}
  <meta property="og:image:alt" content={fullTitle} />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="geo.region" content="US-NM" />
  <meta name="geo.placename" content="Las Cruces" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  {/* Old CitySpark links (events.livelovelascruces.com/#/details/<name>/<id>/<date>), used in past
      newsletters. The part after # never reaches the server, so _redirects can't see it: this finds
      the event by name in /search.json and forwards to its page (the same date if it's still coming
      up, otherwise the next date). Names are compared without hyphens, so an apostrophe spelled
      differently ("songwriters" / "songwriter-s") still matches. No match, an error, or no answer in
      5 seconds: the calendar with a note (index.astro, ?old=1), searched for the name when some
      upcoming event shares its words. */}
  <script is:inline>
    (function () {
      var m = location.hash.match(/^#!?\/details\/([^/?#]+)(?:\/[^/?#]*)?(?:\/(\d{4}-\d{2}-\d{2}))?/);
      if (!m) return;
      var name = decodeURIComponent(m[1]).toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      var day = m[2] || '';
      var flat = function (s) { return s.replace(/-/g, ''); };
      var key = flat(name);
      var done = false;
      var go = function (url) { if (!done) { done = true; location.replace(url); } };
      var calendar = function () { go('/?old=1#calendar'); };
      setTimeout(calendar, 5000);
      fetch('/search.json').then(function (r) { return r.json(); }).then(function (data) {
        var base = function (slug) { return flat(slug.replace(/-\d{4}-\d{2}-\d{2}(-\d+)?$/, '')); };
        // New slugs are cut at 60 characters, so a long name matches on its start.
        var hits = data.events.filter(function (e) { var b = base(e.id); return b === key || (b.length > 20 && key.indexOf(b) === 0); });
        if (hits.length) {
          hits.sort(function (a, b) { return a.dt < b.dt ? -1 : a.dt > b.dt ? 1 : 0; });
          var pick = hits.filter(function (e) { return e.dt >= day; })[0] || hits[0];
          return go('/event/' + pick.id + '/');
        }
        // Over or renamed: search for its name only if something upcoming shares its words.
        var words = name.split('-').filter(function (w) { return w.length > 3; });
        var close = words.length && data.events.some(function (e) {
          var t = (e.t || '').toLowerCase();
          return words.every(function (w) { return t.indexOf(w) > -1; });
        });
        if (close) return go('/?q=' + encodeURIComponent(words.join(' ')) + '&old=1#calendar');
        calendar();
      }).catch(calendar);
    })();
  </script>
  {ANALYTICS_TOKEN && !PREVIEW && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: ANALYTICS_TOKEN })}></script>}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {PREVIEW && <PreviewBanner />}
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
