# Keep the Cloudflare preview addresses out of Google so only
# events.livelovelascruces.com gets indexed.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pieces of pages fetched by the calendar (later days). Not pages of their own.
/more/*
  X-Robots-Tag: noindex

# Small copies of event pictures. The name changes whenever the picture's address does.
/thumbs/*
  Cache-Control: public, max-age=604800

# The venue list, read by the Venues screen on the review page (another address, so it needs this).
/venues.json
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex
