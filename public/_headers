# Keep the Cloudflare preview addresses out of Google so only
# events.livelovelascruces.com gets indexed.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pieces of pages fetched by the calendar (later days). Not pages of their own.
/more/*
  X-Robots-Tag: noindex
